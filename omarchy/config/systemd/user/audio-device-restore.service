[Unit]
Description=Restore exact non-Bluetooth audio defaults after Bluetooth disconnects
After=pipewire-pulse.service wireplumber.service
Wants=pipewire-pulse.service wireplumber.service
StartLimitIntervalSec=30
StartLimitBurst=10

[Service]
Type=simple
ExecStart=%h/.local/bin/audio-device-restore daemon
Restart=on-failure
RestartSec=2
NoNewPrivileges=yes

[Install]
WantedBy=default.target
