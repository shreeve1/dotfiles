#!/usr/bin/env bash
# Show James a file or page: launch Obsidian or the chrome-cdp browser if it is
# not running and open the target. Obsidian is focused; the browser never is
# (James switches to workspace 5 himself). Safe to call from herdr panes and
# SSH shells that lack the Hyprland/Wayland environment.
#
#   agent-open <url>        http(s)/file URL: chrome-cdp tab (port 9222)
#   agent-open <file>       html/pdf/image/video: chrome-cdp; anything else: Obsidian
#   agent-open changes [dir] lazygit in a herdr split beside this session
#   agent-open obsidian     just launch/focus Obsidian
#   agent-open browser      just make sure chrome-cdp is running
#
# Called from a herdr pane James is not looking at (startday research tabs,
# background runs), it opens nothing and prints the target instead.
set -eu

usage() {
  sed -n '7,11s/^#   //p' "$0" >&2
  exit 2
}
(($#)) || usage

# 1. Focus guard: only the herdr pane James has in front may move his focus.
# `changes` stays inside herdr, so it never moves desktop focus.
if [[ $1 != changes && -n ${HERDR_PANE_ID:-} ]] &&
  [[ $(herdr pane get "$HERDR_PANE_ID" 2>/dev/null | jq -r '.result.pane.focused') == false ]]; then
  echo "agent-open: not opened, this session is not the herdr pane in view. Target: $*"
  exit 0
fi

export XDG_RUNTIME_DIR=${XDG_RUNTIME_DIR:-/run/user/$(id -u)}
export DBUS_SESSION_BUS_ADDRESS=${DBUS_SESSION_BUS_ADDRESS:-unix:path=$XDG_RUNTIME_DIR/bus}
# herdr panes carry XDG_SESSION_TYPE=tty; Electron (Obsidian) then tries X11 and quits silently.
export XDG_SESSION_TYPE=wayland
if [[ -z ${HYPRLAND_INSTANCE_SIGNATURE:-} || -z ${WAYLAND_DISPLAY:-} ]]; then
  inst=$(hyprctl instances -j | jq -r '.[0] | "\(.instance) \(.wl_socket)"')
  export HYPRLAND_INSTANCE_SIGNATURE=${inst% *} WAYLAND_DISPLAY=${inst#* }
fi

# Wait for a window of this class, then focus it until Hyprland reports it
# active (a just-mapped window, e.g. chrome-cdp's "5 silent" rule, drops early focus).
focus() {
  local addr=""
  for _ in $(seq 60); do
    addr=$(hyprctl clients -j | jq -r --arg c "$1" 'first(.[] | select(.class == $c)).address // empty')
    if [[ -n $addr ]]; then
      hyprctl dispatch "hl.dsp.focus({ window = \"address:$addr\" })" >/dev/null 2>&1 ||
        hyprctl dispatch focuswindow "address:$addr" >/dev/null 2>&1 || true
      [[ $(hyprctl activewindow -j | jq -r .address) == "$addr" ]] && return
    fi
    sleep 0.25
  done
  echo "agent-open: could not focus a $1 window within 15s" >&2
  exit 1
}

obsidian_open() {
  setsid -f obsidian "$@" >/dev/null 2>&1 </dev/null
  focus md.obsidian.Obsidian
}

chrome_up() {
  curl -s --max-time 2 http://127.0.0.1:9222/json/version >/dev/null && return
  chrome-cdp >/dev/null &
  for _ in $(seq 40); do
    curl -s --max-time 1 http://127.0.0.1:9222/json/version >/dev/null && return
    sleep 0.25
  done
  echo "agent-open: chrome-cdp did not answer on 9222" >&2
  exit 1
}

uri() { jq -rn --arg p "$1" '$p | split("/") | map(@uri) | join("/")'; }

# 2+3. A local preview (file:// or localhost) already open in a tab is reloaded
# and made Chrome's current tab; other URLs always get a new tab, so James's own
# tabs are never reloaded. No desktop focus change: chrome-cdp's Hyprland rule
# (workspace "5 silent", focus_on_activate = false) keeps it from taking focus.
browser_open() {
  local url=$1 tab=""
  chrome_up
  if [[ $url =~ ^(file://|http://(127\.0\.0\.1|localhost)[:/]) ]]; then
    tab=$(curl -s --max-time 5 http://127.0.0.1:9222/json |
      jq -r --arg u "$url" 'first(.[] | select(.type == "page" and .url == $u)) | "\(.id) \(.webSocketDebuggerUrl)"')
  fi
  if [[ -n $tab ]]; then
    node -e '
      const s = new WebSocket(process.argv[1]);
      s.onopen = () => s.send(JSON.stringify({ id: 1, method: "Page.reload", params: { ignoreCache: true } }));
      s.onmessage = () => process.exit(0);
      setTimeout(() => process.exit(1), 5000);' "${tab#* }"
    curl -s --max-time 5 "http://127.0.0.1:9222/json/activate/${tab%% *}" >/dev/null
  else
    curl -s --max-time 5 -X PUT "http://127.0.0.1:9222/json/new?$url" >/dev/null
  fi
  echo "agent-open: in chrome-cdp on workspace 5: $url"
}

# 4. Serve HTML over http so module scripts and fetch() work (file:// blocks
# them). One server per directory, port derived from the path, loopback only.
# ponytail: servers live until logout; add idle shutdown if they pile up.
html_url() {
  local dir=${1%/*} name=${1##*/} port code
  port=$((47000 + $(cksum <<<"$dir" | cut -d' ' -f1) % 1000))
  local url="http://127.0.0.1:$port/$(uri "$name")"
  code=$(curl -s -o /dev/null -w '%{http_code}' --max-time 2 "$url" || true)
  if [[ $code == 000 ]]; then
    setsid -f python3 -m http.server "$port" --bind 127.0.0.1 --directory "$dir" >/dev/null 2>&1 </dev/null
    for _ in $(seq 20); do
      code=$(curl -s -o /dev/null -w '%{http_code}' --max-time 1 "$url" || true)
      [[ $code == 200 ]] && break
      sleep 0.15
    done
  fi
  # Port held by something else, or server failed: fall back to the file.
  [[ $code == 200 ]] && echo "$url" || echo "file://$(uri "$1")"
}

# 5. lazygit in a split to the right of the calling herdr pane (reused if open).
changes_open() {
  [[ -n ${HERDR_PANE_ID:-} ]] || {
    echo "agent-open: changes needs a herdr pane" >&2
    exit 1
  }
  local repo pane
  repo=$(git -C "${1:-$PWD}" rev-parse --show-toplevel)
  for pane in $(herdr pane list --workspace "$HERDR_WORKSPACE_ID" |
    jq -r --arg t "$HERDR_TAB_ID" '.result.panes[] | select(.tab_id == $t) | .pane_id'); do
    if herdr pane process-info --pane "$pane" | jq -e '.result.process_info.foreground_processes[] | select(.name == "lazygit")' >/dev/null; then
      echo "agent-open: lazygit already open in pane $pane"
      return
    fi
  done
  pane=$(herdr pane split "$HERDR_PANE_ID" --direction right --ratio 0.45 --cwd "$repo" | jq -r '.result.pane.pane_id // .result.pane_id')
  herdr pane run "$pane" lazygit >/dev/null
  echo "agent-open: lazygit opened in pane $pane ($repo)"
}

case $1 in
obsidian) obsidian_open ;;
browser)
  chrome_up
  echo "agent-open: chrome-cdp running on workspace 5"
  ;;
changes) changes_open "${2:-}" ;;
http://* | https://* | file://*) browser_open "$1" ;;
*)
  path=$(realpath -e -- "$1")
  case ${path,,} in
  *.html | *.htm) browser_open "$(html_url "$path")" ;;
  *.pdf | *.svg | *.png | *.jpg | *.jpeg | *.gif | *.webp | *.mp4 | *.webm)
    browser_open "file://$(uri "$path")"
    ;;
  *) obsidian_open "obsidian://open?path=$(jq -rn --arg p "$path" '$p|@uri')" ;;
  esac
  ;;
esac
