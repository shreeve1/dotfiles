{
  "defaultProvider": "cliproxy",
  "defaultModel": "claude-opus-5",
  "defaultThinkingLevel": "high",
  "quietStartup": true,
  "skills": [
    "~/.claude/skills"
  ],
  "theme": "neon80s",
  "hideThinkingBlock": false,
  "transport": "sse",
  "packages": [
    "extensions/pi-lens",
    "extensions/pi-subagents",
    "extensions/rpiv-todo",
    "extensions/@juicesharp/rpiv-i18n",
    "extensions/rpiv-web-tools",
    "extensions/@juicesharp/rpiv-args",
    "extensions/pi-retry"
  ],
  "subagents": {
    "agentOverrides": {
      "scout": {
        "model": "minimax/MiniMax-M3",
        "thinking": "low",
        "tools": [
          "read",
          "grep",
          "find",
          "ls"
        ]
      },
      "researcher": {
        "model": "openai-codex/gpt-5.6-terra",
        "thinking": "high",
        "tools": [
          "read",
          "web_search",
          "web_fetch"
        ]
      },
      "worker": {
        "model": "minimax/MiniMax-M3",
        "thinking": "high",
        "tools": [
          "read",
          "grep",
          "find",
          "ls",
          "bash",
          "edit",
          "write"
        ]
      },
      "reviewer": {
        "model": "openai-codex/gpt-5.6-sol",
        "thinking": "high",
        "tools": [
          "read",
          "grep",
          "find",
          "ls",
          "bash"
        ]
      },
      "planner": {
        "model": "cliproxy/claude-opus-5",
        "thinking": "high"
      }
    }
  },
  "retry": {
    "maxRetries": 6,
    "provider": {
      "timeoutMs": 600000
    }
  },
  "collapseChangelog": true,
  "doubleEscapeAction": "tree",
  "extensions": [
    "extensions/fusion",
    "extensions/harness-gates",
    "extensions/graphify-guard",
    "extensions/gap-review",
    "extensions/ui-customization",
    "extensions/model-info",
    "extensions/git-info",
    "extensions/background-terminals",
    "extensions/file-search",
    "-extensions/workflows/index.ts",
    "extensions/subagent-bridge",
    "-extensions/rpiv-ask-user-question/index.ts",
    "-extensions/web-fetch/index.ts",
    "-extensions/summaries/index.ts",
    "-extensions/rpiv-advisor/index.ts"
  ],
  "enabledModels": [
    "deepseek/deepseek-v4-pro",
    "cliproxy/claude-opus-4-8",
    "cliproxy/claude-opus-5",
    "opencode-go/deepseek-v4-pro",
    "openai-codex/gpt-5.6-sol",
    "cliproxy/claude-fable-5",
    "minimax/MiniMax-M3",
    "openai-codex/gpt-5.6-terra"
  ]
}
