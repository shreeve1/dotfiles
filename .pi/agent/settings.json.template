{
  "defaultProvider": "cliproxy",
  "defaultModel": "deepseek-v4.1-flash",
  "defaultThinkingLevel": "high",
  "quietStartup": true,
  "theme": "ember",
  "hideThinkingBlock": true,
  "transport": "sse",
  "packages": [
    "npm:@trevonistrevon/pi-loop",
    "npm:pi-background-tasks",
    "npm:pi-cc-extensions",
    "npm:pi-btw"
  ],
  "defaultTools": [
    "+codemode"
  ],
  "subagents": {
    "agentOverrides": {
      "scout": {
        "model": "minimax/MiniMax-M3",
        "thinking": "low",
        "tools": [
          "read",
          "grep",
          "find",
          "ls"
        ]
      },
      "researcher": {
        "model": "cliproxy/gpt-6-luna",
        "thinking": "high",
        "tools": [
          "read",
          "web_search",
          "web_fetch"
        ]
      },
      "worker": {
        "model": "minimax/MiniMax-M3",
        "thinking": "high",
        "tools": [
          "read",
          "grep",
          "find",
          "ls",
          "bash",
          "edit",
          "write"
        ]
      },
      "reviewer": {
        "model": "cliproxy/gpt-6-luna",
        "thinking": "high",
        "tools": [
          "read",
          "grep",
          "find",
          "ls",
          "bash"
        ]
      },
      "planner": {
        "model": "cliproxy/claude-sonnet-5-5",
        "thinking": "high"
      },
      "oracle": {
        "model": "openai-codex/gpt-6.1-sol"
      },
      "delegate": {
        "model": "minimax/MiniMax-M3"
      },
      "evidence-auditor": {
        "model": "minimax/MiniMax-M3"
      },
      "context-builder": {
        "model": "minimax/MiniMax-M3"
      },
      "startday-light": {
        "model": "cliproxy/deepseek-v4.1-flash",
        "thinking": "high"
      }
    }
  },
  "retry": {
    "maxRetries": 6,
    "provider": {
      "timeoutMs": 600000
    }
  },
  "collapseChangelog": true,
  "doubleEscapeAction": "tree",
  "extensions": [],
  "enabledModels": [
    "minimax/MiniMax-M3",
    "cliproxy/claude-opus-5-5",
    "cliproxy/claude-sonnet-5-5",
    "cliproxy/gpt-6.1-sol",
    "cliproxy/gpt-6-luna",
    "zai/glm-5.3",
    "zai/glm-5.3-flash",
    "cliproxy/deepseek-v4.1-flash"
  ],
  "terminal": {
    "showTerminalProgress": true
  },
  "markdown": {
    "mermaid": "final"
  },
  "enableInstallTelemetry": false,
  "tuiMode": "fullscreen"
}
