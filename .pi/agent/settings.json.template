{
  "quietStartup": true,
  "skills": [],
  "theme": "github-dark-default",
  "hideThinkingBlock": false,
  "transport": "sse",
  "packages": [
    "npm:lsp-pi",
    "extensions/pi-lens",
    "extensions/pi-subagents",
    "extensions/rpiv-advisor",
    "extensions/rpiv-todo",
    "extensions/@juicesharp/rpiv-i18n",
    "extensions/rpiv-web-tools",
    "extensions/@juicesharp/rpiv-args",
"extensions/pi-retry",
    {
      "source": "extensions/rpiv-pi",
      "skills": [
        "skills/personalize-harness-pi/SKILL.md"
      ]
    }
  ],
  "subagents": {
    "agentOverrides": {
      "scout": {
        "model": "minimax/MiniMax-M3",
        "thinking": "low",
        "tools": ["read", "grep", "find", "ls"]
      },
      "researcher": {
        "model": "deepseek/deepseek-v4-flash",
        "thinking": "medium",
        "tools": ["read", "web_search", "web_fetch"]
      },
      "worker": {
        "model": "minimax/MiniMax-M3",
        "thinking": "low",
        "tools": ["read", "grep", "find", "ls", "bash", "edit", "write"]
      },
      "reviewer": {
        "model": "deepseek/deepseek-v4-flash",
        "thinking": "low",
        "tools": ["read", "grep", "find", "ls"]
      }
    }
  },
  "collapseChangelog": true,
  "doubleEscapeAction": "tree",
  "extensions": [
    "extensions/fusion",
    "extensions/harness-gates",
    "extensions/graphify-guard",
    "extensions/gap-review",
    "extensions/ui-customization",
    "extensions/model-info",
    "extensions/git-info",
    "extensions/background-terminals",
    "extensions/file-search",
    "extensions/workflows",
    "extensions/subagent-bridge",
    "-extensions/rpiv-ask-user-question/index.ts",
    "-extensions/web-fetch/index.ts",
    "-extensions/summaries/index.ts",
    "-extensions/rpiv-advisor/index.ts"
  ]
}
