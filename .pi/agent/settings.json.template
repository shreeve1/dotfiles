{
  "defaultProvider": "cliproxy",
  "defaultModel": "minimax-m3",
  "defaultThinkingLevel": "high",
  "quietStartup": true,
  "theme": "ember",
  "hideThinkingBlock": true,
  "transport": "sse",
  "packages": [
    "npm:pi-cc-extensions",
    "npm:pi-btw",
    {
      "source": "npm:pi-fabric@0.117.1",
      "extensions": [
        "!node_modules/pi-coralbricks-provider/**"
      ]
    }
  ],
  "defaultTools": [
    "+codemode"
  ],
  "retry": {
    "maxRetries": 6,
    "provider": {
      "timeoutMs": 600000
    }
  },
  "compaction": {
    "modelOverrides": {
      "cliproxy/claude-opus-5-5": { "reserveTokens": 800000 },
      "cliproxy/claude-sonnet-5-5": { "reserveTokens": 800000 },
      "cliproxy/deepseek-v4.1-flash": { "reserveTokens": 800000 },
      "cliproxy/glm-5.3": { "reserveTokens": 800000 },
      "cliproxy/glm-5.3-flash": { "reserveTokens": 800000 },
      "cliproxy/minimax-m3": { "reserveTokens": 800000 }
    }
  },
  "collapseChangelog": true,
  "doubleEscapeAction": "tree",
  "extensions": [],
  "enabledModels": [
    "cliproxy/minimax-m3",
    "cliproxy/claude-opus-5-5",
    "cliproxy/claude-sonnet-5-5",
    "cliproxy/gpt-6.1-sol",
    "cliproxy/gpt-6.1-terra",
    "cliproxy/gpt-6-luna",
    "cliproxy/glm-5.3",
    "cliproxy/glm-5.3-flash",
    "cliproxy/deepseek-v4.1-flash"
  ],
  "terminal": {
    "showTerminalProgress": true
  },
  "markdown": {
    "mermaid": "final"
  },
  "enableInstallTelemetry": false,
  "tuiMode": "fullscreen"
}
