{
  "defaultProvider": "cliproxy",
  "defaultModel": "claude-opus-5",
  "defaultThinkingLevel": "high",
  "quietStartup": true,
  "skills": [
    "~/.claude/skills"
  ],
  "theme": "neon80s",
  "hideThinkingBlock": false,
  "transport": "sse",
  "packages": [],
  "subagents": {
    "agentOverrides": {
      "scout": {
        "model": "openrouter/deepseek/deepseek-v4.1-flash",
        "thinking": "low",
        "tools": [
          "read",
          "grep",
          "find",
          "ls"
        ]
      },
      "researcher": {
        "model": "openai-codex/gpt-5.6-terra",
        "thinking": "high",
        "tools": [
          "read",
          "web_search",
          "web_fetch"
        ]
      },
      "worker": {
        "model": "openrouter/deepseek/deepseek-v4.1-flash",
        "thinking": "high",
        "tools": [
          "read",
          "grep",
          "find",
          "ls",
          "bash",
          "edit",
          "write"
        ]
      },
      "reviewer": {
        "model": "openai-codex/gpt-5.6-sol",
        "thinking": "high",
        "tools": [
          "read",
          "grep",
          "find",
          "ls",
          "bash"
        ]
      },
      "planner": {
        "model": "cliproxy/claude-opus-4-8",
        "thinking": "high"
      }
    }
  },
  "retry": {
    "maxRetries": 6,
    "provider": {
      "timeoutMs": 600000
    }
  },
  "collapseChangelog": true,
  "doubleEscapeAction": "tree",
  "extensions": [
    "-extensions/@juicesharp/rpiv-args/index.ts",
    "-extensions/@juicesharp/rpiv-i18n/index.ts",
    "-extensions/background-terminals/index.ts",
    "-extensions/cross-agent.ts",
    "-extensions/fusion/index.ts",
    "-extensions/gap-review/index.js",
    "-extensions/graphify-guard/index.js",
    "-extensions/harness-gates/index.js",
    "-extensions/herdr-agent-state.ts",
    "-extensions/model-info/index.ts",
    "-extensions/moshi-hooks.ts",
    "-extensions/pi-lens/dist/index.js",
    "-extensions/pi-retry/src/retry.ts",
    "-extensions/pi-subagents/index.ts",
    "-extensions/ponytail/index.js",
    "-extensions/rpiv-advisor/index.ts",
    "-extensions/rpiv-ask-user-question/index.ts",
    "-extensions/rpiv-todo/index.ts",
    "-extensions/rpiv-web-tools/index.ts",
    "-extensions/rtk.ts",
    "-extensions/session-log/index.ts",
    "-extensions/subagent-bridge/index.ts",
    "-extensions/summaries/index.ts",
    "-extensions/ui-customization/index.ts",
    "-extensions/web-fetch/index.ts",
    "-extensions/workflows/index.ts",
    "-extensions/rpiv-pi/extensions"
  ],
  "enabledModels": [
    "deepseek/deepseek-v4-pro",
    "cliproxy/claude-opus-4-8",
    "cliproxy/claude-opus-5",
    "opencode-go/deepseek-v4-pro",
    "openai-codex/gpt-5.6-sol",
    "cliproxy/claude-fable-5",
    "openrouter/deepseek/deepseek-v4.1-flash",
    "openai-codex/gpt-5.6-terra"
  ]
}
