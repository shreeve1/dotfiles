{
  "env": {
    "ANTHROPIC_BASE_URL": "https://api.anthropic.com",
    "API_TIMEOUT_MS": "3000000",
    "ANTHROPIC_DEFAULT_HAIKU_MODEL": "claude-haiku-4-5",
    "ANTHROPIC_DEFAULT_SONNET_MODEL": "claude-sonnet-4-6",
    "ANTHROPIC_DEFAULT_OPUS_MODEL": "claude-opus-4-6",
    "CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC": "1",
    "CLAUDE_CODE_DISABLE_GIT_INSTRUCTIONS": "1",
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1"
  },
  "permissions": {
    "allow": [
      "Bash(/usr/bin/python3:*)",
      "Bash(ssh:*)",
      "Bash(ssh-keyscan:*)",
      "Bash(~/.ssh/known_hosts)",
      "Bash(cat:*)",
      "Bash(compgen:*)",
      "Bash(scp:*)",
      "Bash(curl:*)",
      "Bash(uv:*)",
      "Bash(find:*)",
      "Bash(mv:*)",
      "Bash(grep:*)",
      "Bash(npm:*)",
      "Bash(ls:*)",
      "Bash(cp:*)",
      "Bash(chmod:*)",
      "Bash(touch:*)",
      "Bash(mkdir:*)",
      "Bash(python3:~/.claude/hooks/*)",
      "Skill(issue-tracker)",
      "Task(*)",
      "mcp__chrome_devtools__navigate_page",
      "mcp__chrome_devtools__take_snapshot",
      "mcp__chrome_devtools__click",
      "mcp__chrome_devtools__fill",
      "mcp__chrome_devtools__take_screenshot",
      "mcp__chrome_devtools__close_page",
      "mcp__chrome_devtools__wait_for",
      "mcp__chrome_devtools__press_key",
      "mcp__chrome_devtools__hover",
      "mcp__chrome_devtools__list_pages",
      "mcp__chrome_devtools__navigate_page_history",
      "mcp__chrome_devtools__fill_form",
      "mcp__chrome_devtools__evaluate_script",
      "mcp__chrome_devtools__handle_dialog",
      "mcp__chrome_devtools__upload_file",
      "mcp__chrome_devtools__list_console_messages",
      "mcp__chrome_devtools__get_console_message",
      "mcp__chrome_devtools__list_network_requests",
      "mcp__chrome_devtools__get_network_request",
      "mcp__chrome_devtools__resize_page",
      "mcp__chrome_devtools__drag",
      "mcp__chrome_devtools__new_page",
      "mcp__chrome_devtools__select_page",
      "mcp__chrome_devtools__emulate",
      "mcp__chrome_devtools__performance_start_trace",
      "mcp__chrome_devtools__performance_stop_trace",
      "mcp__chrome_devtools__performance_analyze_insight",
      "Write",
      "Edit"
    ],
    "defaultMode": "bypassPermissions",
    "bypassPermissionMode": true
  },
  "statusLine": {
    "type": "command",
    "command": "python3 ~/.claude/status_lines/status_line_v6.py",
    "padding": 0
  },
  "enabledPlugins": {
    "context7@claude-plugins-official": true,
    "pyright-lsp@claude-plugins-official": true,
    "frontend-design@claude-plugins-official": true,
    "accesslint@accesslint": true,
    "superpowers@superpowers-marketplace": true,
    "rust-analyzer-lsp@claude-plugins-official": true,
    "typescript-lsp@claude-plugins-official": true,
    "caveman@caveman": true
  },
  "extraKnownMarketplaces": {
    "caveman": {
      "source": {
        "source": "github",
        "repo": "JuliusBrussee/caveman"
      }
    }
  },
  "skipDangerousModePermissionPrompt": true,
  "mcpServers": {
    "chrome-devtools": {
      "command": "npx",
      "args": [
        "-y",
        "chrome-devtools-mcp@latest",
        "--no-usage-statistics",
        "--viewport=1280x720"
      ]
    },
    "accessibility-scanner": {
      "command": "npx",
      "args": [
        "-y",
        "mcp-accessibility-scanner"
      ]
    }
  },
  "bypassPermissions": true,
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node /Users/james/.claude/hooks/caveman-activate.js",
            "timeout": 5,
            "statusMessage": "Loading caveman mode..."
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node /Users/james/.claude/hooks/caveman-mode-tracker.js",
            "timeout": 5,
            "statusMessage": "Tracking caveman mode..."
          }
        ]
      }
    ]
  }
}
