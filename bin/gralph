#!/usr/bin/env bash
# gralph — coordinate trusted GitHub child issues through isolated Pi workers.

set -euo pipefail

usage() {
  cat <<'EOF'
usage: gralph <parent> [--dry-run] [--verify <command>] [--jobs N]

Plan the direct ready-for-agent children of an open GitHub parent issue, or
execute them in dependency-frontier waves. Mutating runs require --verify.
--jobs N caps concurrent worker pipelines (default 2).
EOF
}

PARENT_ARG="${1-}"
if [ -z "$PARENT_ARG" ]; then
  echo "error: parent issue number is required" >&2
  usage >&2
  exit 2
fi
shift

case "$PARENT_ARG" in
  *[!0-9]*) echo "error: parent issue must be numeric" >&2; exit 2 ;;
esac

DRY_RUN=0
VERIFY_SET=0
VERIFY=""
JOBS=2
while [ "$#" -gt 0 ]; do
  case "$1" in
    --dry-run) DRY_RUN=1 ;;
    --verify)
      [ "$#" -ge 2 ] || { echo "error: --verify requires a command" >&2; exit 2; }
      VERIFY="$2"
      VERIFY_SET=1
      shift
      ;;
    --jobs)
      [ "$#" -ge 2 ] || { echo "error: --jobs requires a positive integer" >&2; exit 2; }
      case "$2" in
        ''|*[!0-9]*) echo "error: --jobs must be a positive integer" >&2; exit 2 ;;
      esac
      JOBS="$2"
      [ "$JOBS" -ge 1 ] || { echo "error: --jobs must be a positive integer" >&2; exit 2; }
      shift
      ;;
    -h|--help) usage; exit 0 ;;
    *) echo "error: unknown argument: $1" >&2; usage >&2; exit 2 ;;
  esac
  shift
done

command -v gh >/dev/null 2>&1 || { echo "error: gh CLI not found" >&2; exit 1; }
command -v jq >/dev/null 2>&1 || { echo "error: jq not found" >&2; exit 1; }
git rev-parse --is-inside-work-tree >/dev/null 2>&1 || { echo "error: not in a git repository" >&2; exit 1; }

PARENT="$(jq -nr --arg value "$PARENT_ARG" '$value | tonumber')"
REPO_ROOT="$(git rev-parse --show-toplevel)"
SCRIPT_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"

write_manifest() {
  local manifest="$1"
  shift
  local tmp="$manifest.tmp.$$"
  jq "$@" "$manifest" >"$tmp" && mv "$tmp" "$manifest"
}

verification_from_body() {
  awk '
    { sub(/\r$/, "") }
    /^##[[:space:]]+Verification[[:space:]]*$/ { section=1; next }
    section && /^##[[:space:]]+/ { section=0 }
    section && /^`[^`]+`[[:space:]]*$/ {
      line=$0
      sub(/^`/, "", line)
      sub(/`[[:space:]]*$/, "", line)
      command=line
      count++
    }
    END { if (count == 1) print command; else exit 1 }
  '
}

# run_child_pipeline claims one child, runs the bounded Ralph worker, runs the
# supervisor verification, commits, and runs an independent reviewer. It
# makes no shared-manifest writes; everything is recorded on a per-child
# sidecar so concurrent waves can never race on the manifest. The orchestrator
# folds the sidecar serially between waves.
run_child_pipeline() {
  local child="$1"
  local manifest="$2"
  local run_dir="$3"
  local base_sha="$4"
  local run_id="$5"
  local sidecar="$6"

  local issue_json issue_body issue_title issue_verify host
  host="$(hostname)"

  if ! git -C "$REPO_ROOT" cat-file -e "$base_sha^{commit}" 2>/dev/null; then
    jq -n --argjson child "$child" --arg reason "stale_base_sha" \
      '{child:$child, outcome:"failed", reason:$reason}' >"$sidecar"
    return 0
  fi

  if ! issue_json="$(gh issue view "$child" --json number,title,state,body,labels 2>&1)"; then
    jq -n --argjson child "$child" --arg reason "cannot_read_issue" \
      '{child:$child, outcome:"failed", reason:$reason}' >"$sidecar"
    return 0
  fi
  if ! printf '%s\n' "$issue_json" | jq -e --argjson child "$child" '
    .number == $child and .state == "OPEN" and (.body | type == "string")
    and any(.labels[]?; .name == "ready-for-agent")
  ' >/dev/null 2>&1; then
    jq -n --argjson child "$child" --arg reason "not_admitted" \
      '{child:$child, outcome:"failed", reason:$reason}' >"$sidecar"
    return 0
  fi
  if printf '%s\n' "$issue_json" | jq -e 'any(.labels[]?; .name == "gralph:claimed")' >/dev/null; then
    jq -n --argjson child "$child" --arg reason "already_claimed" \
      '{child:$child, outcome:"failed", reason:$reason}' >"$sidecar"
    return 0
  fi
  issue_body="$(printf '%s\n' "$issue_json" | jq -r '.body')"
  issue_title="$(printf '%s\n' "$issue_json" | jq -r '.title')"
  if ! issue_verify="$(printf '%s\n' "$issue_body" | verification_from_body)"; then
    jq -n --argjson child "$child" --arg reason "no_verification" \
      '{child:$child, outcome:"failed", reason:$reason}' >"$sidecar"
    return 0
  fi

  if ! gh label create 'gralph:claimed' --color 6f42c1 --description 'Claimed by a Gralph coordinator' --force >/dev/null 2>&1; then
    jq -n --argjson child "$child" --arg reason "cannot_ensure_label" \
      '{child:$child, outcome:"failed", reason:$reason}' >"$sidecar"
    return 0
  fi
  if ! gh issue edit "$child" --add-label 'gralph:claimed' >/dev/null 2>&1; then
    jq -n --argjson child "$child" --arg reason "cannot_claim" \
      '{child:$child, outcome:"failed", reason:$reason}' >"$sidecar"
    return 0
  fi

  local branch="gralph/$PARENT/issue-$child"
  local worktree="$run_dir/worktrees/issue-$child-$run_id"
  if git -C "$REPO_ROOT" show-ref --verify --quiet "refs/heads/$branch"; then
    jq -n --argjson child "$child" --arg reason "branch_exists" --arg branch "$branch" \
      '{child:$child, outcome:"failed", reason:$reason, branch:$branch}' >"$sidecar"
    return 0
  fi
  mkdir -p "$(dirname "$worktree")"
  if ! git -C "$REPO_ROOT" worktree add -b "$branch" "$worktree" "$base_sha" >/dev/null 2>&1; then
    jq -n --argjson child "$child" --arg reason "worktree_create_failed" --arg branch "$branch" \
      '{child:$child, outcome:"failed", reason:$reason, branch:$branch}' >"$sidecar"
    return 0
  fi
  local start_sha
  start_sha="$(git -C "$worktree" rev-parse HEAD)"

  local ralph_skill="${GRALPH_RALPH_SKILL:-$HOME/.claude/skills/ralph/SKILL.md}"
  local guard="$SCRIPT_ROOT/lib/gralph-worker-guard.js"
  if [ ! -f "$ralph_skill" ]; then
    jq -n --argjson child "$child" --arg reason "ralph_skill_missing" \
      '{child:$child, outcome:"failed", reason:$reason, branch:$branch, worktree:$worktree, startingSha:$start_sha}' >"$sidecar"
    return 0
  fi
  if [ ! -f "$guard" ]; then
    jq -n --argjson child "$child" --arg reason "guard_missing" \
      '{child:$child, outcome:"failed", reason:$reason, branch:$branch, worktree:$worktree, startingSha:$start_sha}' >"$sidecar"
    return 0
  fi
  ralph_skill="$(realpath "$ralph_skill")"
  guard="$(realpath "$guard")"

  local max_iterations="${GRALPH_MAX_ITERATIONS:-3}"
  case "$max_iterations" in ''|*[!0-9]*|0)
    jq -n --argjson child "$child" --arg reason "max_iterations_invalid" \
      '{child:$child, outcome:"failed", reason:$reason, branch:$branch, worktree:$worktree, startingSha:$start_sha}' >"$sidecar"
    return 0
  ;; esac
  local temp_home="$run_dir/home-$child-$run_id"
  local pi_agent_dir="${PI_CODING_AGENT_DIR:-$HOME/.pi/agent}"
  local prompt_file="$run_dir/worker-$child-prompt.md"
  local output_file previous_status='none' iteration done=0 rc
  mkdir -p "$temp_home"

  for ((iteration=1; iteration<=max_iterations; iteration++)); do
    output_file="$run_dir/worker-$child-iteration-$iteration.log"
    {
      printf '%s\n' 'You are an isolated Gralph worker executing one GitHub child issue under the Ralph protocol.'
      printf '%s\n' 'Do not run Git, mutate GitHub, edit local .kanban state, or commit; the coordinator owns those actions.'
      printf '%s\n' 'Use only guarded file tools and gralph_check. Implement only this issue in the stated worktree.'
      printf 'Worktree: %s\nIssue: #%s %s\nIteration: %s of %s\nPrior iteration status:\n%s\n\nIssue body and acceptance criteria:\n%s\n\n' \
        "$worktree" "$child" "$issue_title" "$iteration" "$max_iterations" "$previous_status" "$issue_body"
      printf 'When complete, end with exactly: RALPH_RESULT: DONE #%s\n' "$child"
      printf 'If genuinely impossible, end with exactly: RALPH_RESULT: BLOCKED #%s\n' "$child"
    } >"$prompt_file"

    set +e
    (cd "$worktree" && \
      HOME="$temp_home" PI_CODING_AGENT_DIR="$pi_agent_dir" \
      GRALPH_WORKTREE="$worktree" GRALPH_VERIFY_COMMAND="$issue_verify" \
      pi -p --no-session --no-extensions -e "$guard" \
        --no-skills --skill "$ralph_skill" --no-context-files --no-prompt-templates --no-themes \
        --tools read,write,edit,grep,find,ls,gralph_check \
        "$(cat "$prompt_file")") >"$output_file" 2>&1
    rc=$?
    set -e
    local final_status status_count
    final_status="$(awk 'NF { line=$0 } END { print line }' "$output_file")"
    status_count="$(grep -c '^RALPH_RESULT:' "$output_file" || true)"
    if [ "$rc" -eq 0 ] && [ "$status_count" -eq 1 ] && [ "$final_status" = "RALPH_RESULT: DONE #$child" ]; then
      done=1
      break
    fi
    previous_status="$(tail -40 "$output_file" 2>/dev/null || printf 'pi exited %s' "$rc")"
  done
  if [ "$done" -ne 1 ]; then
    jq -n --argjson child "$child" --arg reason "worker_incomplete" \
      --arg branch "$branch" --arg worktree "$worktree" --arg startingSha "$start_sha" \
      '{child:$child, outcome:"failed", reason:$reason, branch:$branch, worktree:$worktree, startingSha:$startingSha}' >"$sidecar"
    return 0
  fi

  local verification_log="$run_dir/worker-$child-verification.log"
  local -a scrubbed_env=(env)
  local env_name
  while IFS= read -r env_name; do
    if [ "$env_name" = PI_CODING_AGENT_DIR ] || \
      [[ "${env_name^^}" =~ TOKEN|SECRET|PASSWORD|PASSWD|CREDENTIAL|API_?KEY|AUTH|SSH_AUTH_SOCK|GIT_ASKPASS ]]; then
      scrubbed_env+=(-u "$env_name")
    fi
  done < <(compgen -e)
  set +e
  (cd "$worktree" && "${scrubbed_env[@]}" \
    HOME="$temp_home" GIT_CONFIG_NOSYSTEM=1 GIT_CONFIG_GLOBAL=/dev/null \
    GIT_CONFIG_COUNT=1 GIT_CONFIG_KEY_0=credential.helper GIT_CONFIG_VALUE_0= \
    GIT_TERMINAL_PROMPT=0 GCM_INTERACTIVE=Never GIT_SSH_COMMAND=false \
    /bin/sh -c "$issue_verify") >"$verification_log" 2>&1
  rc=$?
  set -e
  if [ "$rc" -ne 0 ]; then
    echo "error: issue verification failed with exit $rc" >&2
    jq -n --argjson child "$child" --arg reason "verification_failed" --argjson exitCode "$rc" \
      --arg branch "$branch" --arg worktree "$worktree" --arg startingSha "$start_sha" \
      --arg verificationLog "$verification_log" \
      '{child:$child, outcome:"failed", reason:$reason, branch:$branch, worktree:$worktree, startingSha:$startingSha, verificationExitCode:$exitCode, verificationLog:$verificationLog}' >"$sidecar"
    return 0
  fi

  if [ -z "$(git -C "$worktree" status --porcelain)" ]; then
    jq -n --argjson child "$child" --arg reason "no_diff" \
      --arg branch "$branch" --arg worktree "$worktree" --arg startingSha "$start_sha" \
      '{child:$child, outcome:"failed", reason:$reason, branch:$branch, worktree:$worktree, startingSha:$startingSha}' >"$sidecar"
    return 0
  fi
  git -C "$worktree" add -A
  if ! git -C "$worktree" commit -m "feat(#$child): implement GitHub child" >/dev/null 2>&1; then
    echo "error: coordinator could not commit worker diff" >&2
    jq -n --argjson child "$child" --arg reason "commit_failed" \
      --arg branch "$branch" --arg worktree "$worktree" --arg startingSha "$start_sha" \
      '{child:$child, outcome:"failed", reason:$reason, branch:$branch, worktree:$worktree, startingSha:$startingSha}' >"$sidecar"
    return 0
  fi
  if [ -n "$(git -C "$worktree" status --porcelain)" ]; then
    echo "error: worker worktree is not clean after commit" >&2
    jq -n --argjson child "$child" --arg reason "dirty_after_commit" \
      --arg branch "$branch" --arg worktree "$worktree" --arg startingSha "$start_sha" \
      '{child:$child, outcome:"failed", reason:$reason, branch:$branch, worktree:$worktree, startingSha:$startingSha}' >"$sidecar"
    return 0
  fi
  local commit_sha commit_count
  commit_sha="$(git -C "$worktree" rev-parse HEAD)"
  commit_count="$(git -C "$worktree" rev-list --count "$start_sha..$commit_sha")"
  if [ "$commit_count" -lt 1 ]; then
    jq -n --argjson child "$child" --arg reason "no_commit" \
      --arg branch "$branch" --arg worktree "$worktree" --arg startingSha "$start_sha" --arg commitSha "$commit_sha" \
      '{child:$child, outcome:"failed", reason:$reason, branch:$branch, worktree:$worktree, startingSha:$startingSha, commitSha:$commitSha}' >"$sidecar"
    return 0
  fi

  local review_prompt="$run_dir/reviewer-$child-prompt.md"
  local review_artifact="$run_dir/reviewer-$child.json"
  local review_home="$run_dir/reviewer-home-$child-$run_id"
  local review_timeout="${GRALPH_REVIEW_TIMEOUT:-600}"
  case "$review_timeout" in ''|*[!0-9]*|0)
    jq -n --argjson child "$child" --arg reason "review_timeout_invalid" \
      --arg branch "$branch" --arg worktree "$worktree" --arg startingSha "$start_sha" --arg commitSha "$commit_sha" \
      '{child:$child, outcome:"failed", reason:$reason, branch:$branch, worktree:$worktree, startingSha:$startingSha, commitSha:$commitSha}' >"$sidecar"
    return 0
  ;; esac
  mkdir -p "$review_home"
  {
    printf '%s\n' 'You are an independent, read-only reviewer. Do not modify files or make network-changing commands.'
    printf '%s\n' 'Review the committed worker result only from the evidence below and any read-only repository inspection needed.'
    printf '%s\n' 'Return exactly one JSON object and no markdown or commentary, using this schema:'
    printf '%s\n' '{"status":"approved|changes_requested","criticalCount":0,"blockerCount":0,"findings":[{"severity":"info|warning|critical|blocker","message":"..."}]}'
    printf '%s\n' 'Counts must exactly match findings severities. Approve only when the requested behavior and every acceptance criterion are satisfied.'
    printf '\nIssue #%s: %s\nBase SHA: %s\nCommitted SHA: %s\n\nRequested behavior and acceptance criteria:\n%s\n' \
      "$child" "$issue_title" "$start_sha" "$commit_sha" "$issue_body"
    printf '\nFull committed diff (%s..%s):\n' "$start_sha" "$commit_sha"
    git -C "$worktree" diff --no-ext-diff "$start_sha" "$commit_sha"
    printf '\nWorker verification command:\n%s\n\nWorker verification output (exit 0):\n' "$issue_verify"
    cat "$verification_log"
  } >"$review_prompt"

  local review_pid watchdog_pid review_timed_out timed_out="$run_dir/.reviewer-$child-timed-out"
  rm -f "$timed_out"
  set +e
  (cd "$worktree" && exec env HOME="$review_home" PI_CODING_AGENT_DIR="$pi_agent_dir" \
    pi -p --no-session --no-extensions --no-skills --no-context-files \
      --no-prompt-templates --no-themes --tools read,grep,find,ls \
      "$(cat "$review_prompt")") >"$review_artifact" 2>&1 &
  review_pid=$!
  (
    sleep "$review_timeout"
    if kill -0 "$review_pid" 2>/dev/null; then
      : >"$timed_out"
      kill -TERM "$review_pid" 2>/dev/null
      sleep 1
      kill -KILL "$review_pid" 2>/dev/null
    fi
  ) &
  watchdog_pid=$!
  wait "$review_pid"
  rc=$?
  kill "$watchdog_pid" 2>/dev/null
  wait "$watchdog_pid" 2>/dev/null
  set -e

  review_timed_out="$([ -f "$timed_out" ] && printf true || printf false)"
  rm -f "$timed_out"

  if [ "$review_timed_out" = true ]; then
    jq -n --argjson child "$child" --arg reason "review_timeout" \
      --arg branch "$branch" --arg worktree "$worktree" --arg startingSha "$start_sha" --arg commitSha "$commit_sha" \
      --arg artifact "$review_artifact" --arg prompt "$review_prompt" \
      '{child:$child, outcome:"failed", reason:$reason, branch:$branch, worktree:$worktree, startingSha:$startingSha, commitSha:$commitSha, reviewArtifact:$artifact, reviewPrompt:$prompt, reviewTimedOut:true}' >"$sidecar"
    return 0
  fi
  if [ "$rc" -ne 0 ]; then
    jq -n --argjson child "$child" --arg reason "review_failed" --argjson processExitCode "$rc" \
      --arg branch "$branch" --arg worktree "$worktree" --arg startingSha "$start_sha" --arg commitSha "$commit_sha" \
      --arg artifact "$review_artifact" --arg prompt "$review_prompt" \
      '{child:$child, outcome:"failed", reason:$reason, branch:$branch, worktree:$worktree, startingSha:$startingSha, commitSha:$commitSha, reviewArtifact:$artifact, reviewPrompt:$prompt, reviewProcessExitCode:$processExitCode}' >"$sidecar"
    return 0
  fi

  if ! jq -e '
    type == "object"
    and (.status == "approved" or .status == "changes_requested")
    and (.criticalCount | type == "number") and .criticalCount >= 0 and .criticalCount == (.criticalCount | floor)
    and (.blockerCount | type == "number") and .blockerCount >= 0 and .blockerCount == (.blockerCount | floor)
    and (.findings | type == "array")
    and all(.findings[];
      type == "object"
      and (.severity == "info" or .severity == "warning" or .severity == "critical" or .severity == "blocker")
      and (.message | type == "string") and (.message | length > 0)
    )
    and .criticalCount == ([.findings[] | select(.severity == "critical")] | length)
    and .blockerCount == ([.findings[] | select(.severity == "blocker")] | length)
  ' "$review_artifact" >/dev/null 2>&1; then
    jq -n --argjson child "$child" --arg reason "review_malformed" \
      --arg branch "$branch" --arg worktree "$worktree" --arg startingSha "$start_sha" --arg commitSha "$commit_sha" \
      --arg artifact "$review_artifact" --arg prompt "$review_prompt" \
      '{child:$child, outcome:"failed", reason:$reason, branch:$branch, worktree:$worktree, startingSha:$startingSha, commitSha:$commitSha, reviewArtifact:$artifact, reviewPrompt:$prompt}' >"$sidecar"
    return 0
  fi

  local review_status critical_count blocker_count findings
  review_status="$(jq -r '.status' "$review_artifact")"
  critical_count="$(jq -r '.criticalCount' "$review_artifact")"
  blocker_count="$(jq -r '.blockerCount' "$review_artifact")"
  findings="$(jq -c '.findings' "$review_artifact")"

  rm -rf "$temp_home" "$review_home"

  if [ "$review_status" != approved ] || [ "$critical_count" -ne 0 ] || [ "$blocker_count" -ne 0 ]; then
    jq -n --argjson child "$child" --arg reason "review_rejected" \
      --arg branch "$branch" --arg worktree "$worktree" --arg startingSha "$start_sha" --arg commitSha "$commit_sha" \
      --arg artifact "$review_artifact" --arg prompt "$review_prompt" \
      --arg verificationLog "$verification_log" \
      --arg body "$issue_body" --arg title "$issue_title" --arg verify "$issue_verify" \
      --arg host "$host" --argjson pid "$$" --arg runId "$run_id" \
      --arg status "$review_status" --argjson critical "$critical_count" --argjson blocker "$blocker_count" --argjson findings "$findings" \
      '{
        child:$child, outcome:"rejected", reason:$reason,
        branch:$branch, worktree:$worktree, startingSha:$startingSha, commitSha:$commitSha,
        issueBody:$body, issueTitle:$title, issueVerify:$verify,
        host:$host, pid:$pid, runId:$runId,
        executionStatus:"complete", verificationExitCode:0, verificationLog:$verificationLog, ralphComplete:true, clean:true,
        reviewStatus:$status, reviewCriticalCount:$critical, reviewBlockerCount:$blocker, reviewFindings:$findings,
        reviewProcessExitCode:0, reviewTimedOut:false, reviewArtifact:$artifact, reviewPrompt:$prompt,
        reviewGate:"rejected"
      }' >"$sidecar"
    return 0
  fi

  jq -n --argjson child "$child" \
    --arg branch "$branch" --arg worktree "$worktree" --arg startingSha "$start_sha" --arg commitSha "$commit_sha" \
    --arg artifact "$review_artifact" --arg prompt "$review_prompt" \
    --arg verificationLog "$verification_log" \
    --arg body "$issue_body" --arg title "$issue_title" --arg verify "$issue_verify" \
    --arg host "$host" --argjson pid "$$" --arg runId "$run_id" \
    --arg status "$review_status" --argjson critical "$critical_count" --argjson blocker "$blocker_count" --argjson findings "$findings" \
    '{
      child:$child, outcome:"accepted", reason:null,
      branch:$branch, worktree:$worktree, startingSha:$startingSha, commitSha:$commitSha,
      issueBody:$body, issueTitle:$title, issueVerify:$verify,
      host:$host, pid:$pid, runId:$runId,
      executionStatus:"complete", verificationExitCode:0, verificationLog:$verificationLog, ralphComplete:true, clean:true,
      reviewStatus:$status, reviewCriticalCount:$critical, reviewBlockerCount:$blocker, reviewFindings:$findings,
      reviewProcessExitCode:0, reviewTimedOut:false, reviewArtifact:$artifact, reviewPrompt:$prompt,
      reviewGate:"accepted"
    }' >"$sidecar"
  return 0
}

# fold_child_result reads the per-child sidecar, updates the manifest, and
# feeds an accepted result into merge_one_child (which is the only writer of
# the serialized batch-branch integration). A single sidecar fail mode is
# recorded on the manifest so the next wave cannot re-select the child.
fold_child_result() {
  local child="$1"
  local manifest="$2"
  local sidecar="$3"
  local verify_cmd="$4"
  local run_dir="$5"
  local base_sha="$6"
  local run_id="$7"
  local repo_root="$8"

  if [ ! -f "$sidecar" ]; then
    write_manifest "$manifest" --argjson child "$child" --arg runId "$run_id" '
      .execution = ((.execution // {}) + {runId:$runId, status:"failed", reason:"no_sidecar", child:$child})
      | (.children[] | select(.number == $child) | .execution) |=
          ((. // {}) + {status:"failed", reason:"no_sidecar", runId:$runId})
    ' || { echo "error: fold_child_result failed to record no-sidecar failure for child #$child" >&2; return 1; }
    return 1
  fi

  local outcome
  outcome="$(jq -r '.outcome' "$sidecar")"

  case "$outcome" in
    accepted)
      local commit_sha branch
      commit_sha="$(jq -r '.commitSha' "$sidecar")"
      branch="$(jq -r '.branch' "$sidecar")"
      write_manifest "$manifest" \
        --argjson child "$child" \
        --arg body "$(jq -r '.issueBody' "$sidecar")" \
        --arg verify "$(jq -r '.issueVerify' "$sidecar")" \
        --arg integration "$verify_cmd" \
        --arg runId "$run_id" \
        --arg host "$(jq -r '.host' "$sidecar")" \
        --argjson pid "$(jq -r '.pid' "$sidecar")" \
        --arg branch "$branch" \
        --arg worktree "$(jq -r '.worktree' "$sidecar")" \
        --arg start "$(jq -r '.startingSha' "$sidecar")" \
        --arg commit "$commit_sha" \
        --arg verificationLog "$(jq -r '.verificationLog' "$sidecar")" \
        --argjson review "$(jq -c '.reviewStatus as $s | .reviewCriticalCount as $c | .reviewBlockerCount as $b | .reviewFindings as $f | .reviewProcessExitCode as $pc | .reviewTimedOut as $t | .reviewArtifact as $a | .reviewPrompt as $p | {status:$s,criticalCount:$c,blockerCount:$b,findings:$f,processExitCode:$pc,timedOut:$t,artifact:$a,prompt:$p,gate:"accepted"}' "$sidecar")" \
        '
          .dryRun = false
          | .integrationCommand = $integration
          | .execution = {runId:$runId, status:"reviewed", child:$child}
          | (.children[] | select(.number == $child)) += {
              body:$body, verificationCommand:$verify,
              claim:{label:"gralph:claimed",runId:$runId,host:$host,pid:$pid,status:"claimed"},
              execution:{status:"complete", branch:$branch, worktree:$worktree, startingSha:$start, commitSha:$commit, verificationExitCode:0, verificationLog:$verificationLog, ralphComplete:true, clean:true},
              review:($review)
            }
        ' || { echo "error: fold_child_result failed to record accepted review for child #$child" >&2; return 1; }
      # Prune any previous batch worktree from this run so the next queued
      # merge in the wave can attach cleanly to the accumulated batch branch.
      git -C "$repo_root" worktree remove --force "$run_dir/worktrees/batch-$run_id" 2>/dev/null || true
      if merge_one_child "$child" "$manifest" "$run_dir" "$base_sha" "$verify_cmd" "$run_id" "$branch" "$commit_sha"; then
        git -C "$repo_root" worktree remove --force "$run_dir/worktrees/batch-$run_id" 2>/dev/null || true
      fi
      ;;
    rejected)
      local commit_sha branch
      commit_sha="$(jq -r '.commitSha' "$sidecar")"
      branch="$(jq -r '.branch' "$sidecar")"
      local review_obj
      review_obj="$(jq -c '{
        status:.reviewStatus, criticalCount:.reviewCriticalCount, blockerCount:.reviewBlockerCount,
        findings:.reviewFindings, processExitCode:.reviewProcessExitCode, timedOut:.reviewTimedOut,
        artifact:.reviewArtifact, prompt:.reviewPrompt, gate:"rejected"
      }' "$sidecar")"
      write_manifest "$manifest" \
        --argjson child "$child" \
        --arg integration "$verify_cmd" \
        --arg runId "$run_id" \
        --arg host "$(jq -r '.host' "$sidecar")" \
        --argjson pid "$(jq -r '.pid' "$sidecar")" \
        --arg branch "$branch" \
        --arg worktree "$(jq -r '.worktree' "$sidecar")" \
        --arg start "$(jq -r '.startingSha' "$sidecar")" \
        --arg commit "$commit_sha" \
        --arg reason "$(jq -r '.reason' "$sidecar")" \
        --arg verificationLog "$(jq -r '.verificationLog' "$sidecar")" \
        --argjson review "$review_obj" \
        '
          .dryRun = false
          | .integrationCommand = $integration
          | .execution = {runId:$runId, status:"failed", reason:$reason, child:$child}
          | (.children[] | select(.number == $child)) += {
              claim:{label:"gralph:claimed",runId:$runId,host:$host,pid:$pid,status:"claimed"},
              execution:{status:"complete", branch:$branch, worktree:$worktree, startingSha:$start, commitSha:$commit, verificationExitCode:0, verificationLog:$verificationLog, ralphComplete:true, clean:true},
              review:($review)
            }
        ' || { echo "error: fold_child_result failed to record rejected review for child #$child" >&2; return 1; }
      ;;
    failed)
      local reason branch worktree starting_sha commit_sha review_artifact review_prompt review_proc review_timed
      reason="$(jq -r '.reason' "$sidecar")"
      branch="$(jq -r '.branch // ""' "$sidecar")"
      worktree="$(jq -r '.worktree // ""' "$sidecar")"
      starting_sha="$(jq -r '.startingSha // ""' "$sidecar")"
      commit_sha="$(jq -r '.commitSha // ""' "$sidecar")"
      review_artifact="$(jq -r '.reviewArtifact // ""' "$sidecar")"
      if [ -n "$review_artifact" ]; then
        review_prompt="$(jq -r '.reviewPrompt // ""' "$sidecar")"
        review_proc="$(jq -r '.reviewProcessExitCode // 0' "$sidecar")"
        review_timed="$(jq -r '.reviewTimedOut // false' "$sidecar")"
        write_manifest "$manifest" \
          --argjson child "$child" \
          --arg reason "$reason" \
          --arg branch "$branch" \
          --arg worktree "$worktree" \
          --arg startingSha "$starting_sha" \
          --arg commit "$commit_sha" \
          --arg runId "$run_id" \
          --arg artifact "$review_artifact" \
          --arg prompt "$review_prompt" \
          --argjson processExitCode "$review_proc" \
          --argjson timedOut "$review_timed" \
          '
            .execution = ((.execution // {}) + {runId:$runId, status:"failed", reason:$reason, child:$child})
            | (.children[] | select(.number == $child)) |= (. + {
                execution:((.execution // {}) + {status:"failed", reason:$reason} +
                  (if $branch != "" then {branch:$branch} else {} end) +
                  (if $worktree != "" then {worktree:$worktree} else {} end) +
                  (if $startingSha != "" then {startingSha:$startingSha} else {} end) +
                  (if $commit != "" then {commitSha:$commit} else {} end) +
                  {runId:$runId}),
                review:{artifact:$artifact, prompt:$prompt, processExitCode:$processExitCode, timedOut:$timedOut, gate:"rejected"}
              })
          ' || { echo "error: fold_child_result failed to record failed-with-review for child #$child" >&2; return 1; }
      else
        write_manifest "$manifest" \
          --argjson child "$child" \
          --arg reason "$reason" \
          --arg branch "$branch" \
          --arg worktree "$worktree" \
          --arg startingSha "$starting_sha" \
          --arg commit "$commit_sha" \
          --arg runId "$run_id" \
          '
            .execution = ((.execution // {}) + {runId:$runId, status:"failed", reason:$reason, child:$child})
            | (.children[] | select(.number == $child) | .execution) |=
                ((. // {}) + {status:"failed", reason:$reason} +
                  (if $branch != "" then {branch:$branch} else {} end) +
                  (if $worktree != "" then {worktree:$worktree} else {} end) +
                  (if $startingSha != "" then {startingSha:$startingSha} else {} end) +
                  (if $commit != "" then {commitSha:$commit} else {} end) +
                  {runId:$runId})
          ' || { echo "error: fold_child_result failed to record failed execution for child #$child" >&2; return 1; }
      fi
      ;;
    *)
      write_manifest "$manifest" --argjson child "$child" --arg runId "$run_id" \
        --arg outcome "$outcome" '
        .execution = ((.execution // {}) + {runId:$runId, status:"failed", reason:"unknown_sidecar_outcome", child:$child})
        | (.children[] | select(.number == $child) | .execution) |=
            ((. // {}) + {status:"failed", reason:"unknown_sidecar_outcome", runId:$runId})
      ' || { echo "error: fold_child_result failed to record unknown-sidecar-outcome for child #$child" >&2; return 1; }
      ;;
  esac
  return 0
}

# refresh_frontier re-runs the GitHub GraphQL query seeded by the manifest's
# immutable baseSha and merges the fresh classification/dependencies into the
# shared manifest while retaining per-child claim/execution/review/merge
# runtime state. The orchestrator runs this between waves so newly-unblocked
# children can enter the next wave.
refresh_frontier() {
  local manifest="$1"
  local parent="$2"

  local repo_slug owner name
  repo_slug="$(gh repo view --json nameWithOwner --jq .nameWithOwner 2>/dev/null)" || {
    echo "error: refresh_frontier cannot resolve the current GitHub repository" >&2
    return 1
  }
  IFS=/ read -r owner name <<<"$repo_slug"
  [ -n "${owner:-}" ] && [ -n "${name:-}" ] || {
    echo "error: refresh_frontier got an invalid repository name" >&2
    return 1
  }

  read -r -d '' QUERY <<'GRAPHQL' || true
query GralphFrontierRefresh($owner: String!, $name: String!, $number: Int!) {
  repository(owner: $owner, name: $name) {
    issue(number: $number) {
      number
      state
      subIssues(first: 100) {
        pageInfo { hasNextPage }
        nodes {
          number
          title
          state
          labels(first: 100) { nodes { name } }
          blockedBy(first: 100) {
            pageInfo { hasNextPage }
            nodes { number state }
          }
        }
      }
    }
  }
}
GRAPHQL

  local response
  if ! response="$(gh api graphql -f query="$QUERY" -F owner="$owner" -F name="$name" -F number="$parent" 2>&1)"; then
    echo "error: refresh_frontier could not reach GitHub for parent #$parent: $response" >&2
    return 1
  fi
  if ! printf '%s\n' "$response" | jq -e . >/dev/null 2>&1; then
    echo "error: refresh_frontier got malformed JSON for parent #$parent" >&2
    return 1
  fi
  if [ "$(printf '%s\n' "$response" | jq -r '(.errors // []) | length')" -ne 0 ]; then
    echo "error: refresh_frontier could not read parent #$parent" >&2
    return 1
  fi
  if ! printf '%s\n' "$response" | jq -e '.data.repository.issue | type == "object"' >/dev/null; then
    echo "error: refresh_frontier could not find parent #$parent" >&2
    return 1
  fi
  if [ "$(printf '%s\n' "$response" | jq -r '.data.repository.issue.subIssues.pageInfo.hasNextPage')" = true ]; then
    echo "error: refresh_frontier noticed more than 100 children for parent #$parent" >&2
    return 1
  fi

  local fresh_children fresh_deps
  fresh_children="$(printf '%s\n' "$response" | jq -c '
    [.data.repository.issue.subIssues.nodes[]
      | ([.labels.nodes[].name] | sort | unique) as $labels
      | ([.blockedBy.nodes[] | {number, state}] | sort_by(.number)) as $blockers
      | {
          number,
          title,
          state,
          labels: $labels,
          blockedBy: [$blockers[].number],
          classification: (
            if .state != "OPEN" then "excluded"
            elif ($labels | index("ready-for-agent")) == null then "excluded"
            elif any($blockers[]; .state != "CLOSED") then "blocked"
            else "eligible"
            end
          ),
          reason: (
            if .state != "OPEN" then "child_not_open"
            elif ($labels | index("ready-for-agent")) == null then "missing_ready_for_agent_label"
            elif any($blockers[]; .state != "CLOSED") then "open_blockers"
            else null
            end
          )
        }
    ] | sort_by(.number)
  ')"
  fresh_deps="$(printf '%s\n' "$fresh_children" | jq -c '
    [.[] as $child | $child.blockedBy[] | {issue: $child.number, blockedBy: .}] | sort_by([.issue, .blockedBy])
  ')"

  write_manifest "$manifest" --argjson fresh "$fresh_children" --argjson freshDeps "$fresh_deps" '
    .children as $existing
    | .children = (
        ([$existing[]
          | . as $cur
          | ($fresh | map(select(.number == $cur.number)) | .[0]) as $freshChild
          | if $freshChild == null then $cur
            else $cur + $freshChild
            end
        ])
        + ([$fresh[] | . as $f | select(all($existing[]; .number != $f.number))])
        | sort_by(.number)
      )
    | .dependencies = $freshDeps
  '
  return 0
}

# orchestrate_waves drives the wave loop: pick the next eligible frontier,
# launch up to --jobs child pipelines concurrently, fold their sidecars
# serially (with merge_one_child invoked one at a time), refresh the
# frontier, and continue until no eligible child remains. The lock is owned
# by the orchestrator for the entire run; concurrency is bounded per
# invocation so external fixtures (worktrees, ports, databases) are not
# raced. The manifest receives an `.orchestration` summary at the end.
orchestrate_waves() {
  local manifest="$1"
  local verify_cmd="$2"
  local jobs="$3"

  local run_dir base_sha run_id host lock_dir lock_owned=0
  run_dir="$(dirname "$manifest")"
  base_sha="$(jq -r '.baseSha' "$manifest")"
  if ! git -C "$REPO_ROOT" cat-file -e "$base_sha^{commit}" 2>/dev/null; then
    echo "error: saved base SHA is unavailable: $base_sha" >&2
    return 1
  fi
  host="$(hostname)"
  run_id="$(date -u +%Y%m%dT%H%M%SZ)-$$"
  lock_dir="$run_dir/.coordinator-lock"
  if ! mkdir "$lock_dir" 2>/dev/null; then
    local owner_pid owner_host first_child
    owner_pid="$(jq -r '.pid // empty' "$lock_dir/owner.json" 2>/dev/null || true)"
    owner_host="$(jq -r '.host // empty' "$lock_dir/owner.json" 2>/dev/null || true)"
    first_child="$(jq -r '[.children[] | select(.classification == "eligible") | select((.execution.status // "pending") == "pending" or (.execution.status // "pending") == null)] | sort_by(.number) | .[0].number // empty' "$manifest")"
    if [ "$owner_host" = "$host" ] && [ -n "$owner_pid" ] && kill -0 "$owner_pid" 2>/dev/null; then
      if [ -n "$first_child" ]; then
        echo "error: another live Gralph run owns child #$first_child" >&2
      else
        echo "error: another live Gralph run owns parent #$PARENT" >&2
      fi
    else
      echo "error: an unresolved Gralph claim exists at $lock_dir" >&2
    fi
    return 1
  fi
  lock_owned=1
  jq -n --arg runId "$run_id" --arg host "$host" --argjson pid "$$" \
    '{runId:$runId,host:$host,pid:$pid}' >"$lock_dir/owner.json"
  trap '[ "$lock_owned" -eq 0 ] || rm -rf "$lock_dir"' EXIT

  write_manifest "$manifest" \
    --arg integration "$verify_cmd" --arg runId "$run_id" --arg host "$host" --argjson pid "$$" --argjson jobs "$jobs" '
      .dryRun = false
      | .integrationCommand = $integration
      | .orchestration = {runId:$runId, host:$host, pid:$pid, jobs:$jobs, waves:0, landed:[], failed:[], rejected:[]}
    ' || true

  local wave=0 fold_failed=0
  while :; do
    local candidates
    candidates="$(jq -r '
      [.children[]
        | select(.classification == "eligible")
        | select((.execution.status // "pending") == "pending" or (.execution.status // "pending") == null)
        | .number] | sort | .[]
    ' "$manifest")"

    if [ -z "$candidates" ]; then
      break
    fi

    local wave_children=()
    local c
    while IFS= read -r c; do
      [ "${#wave_children[@]}" -ge "$jobs" ] && break
      [ -n "$c" ] && wave_children+=("$c")
    done <<<"$candidates"

    if [ "${#wave_children[@]}" -eq 0 ]; then
      break
    fi

    wave=$((wave + 1))

    local pids=()
    declare -A sidecar_for=()
    local child
    for child in "${wave_children[@]}"; do
      local sidecar="$run_dir/.child-$child-$run_id-result.json"
      sidecar_for[$child]="$sidecar"
      (
        run_child_pipeline "$child" "$manifest" "$run_dir" "$base_sha" "$run_id" "$sidecar"
      ) &
      pids+=($!)
    done
    wait "${pids[@]}" 2>/dev/null || true

    local wave_fold_failed=0
    for child in "${wave_children[@]}"; do
      if ! fold_child_result "$child" "$manifest" "${sidecar_for[$child]}" "$verify_cmd" "$run_dir" "$base_sha" "$run_id" "$REPO_ROOT"; then
        wave_fold_failed=1
      fi
    done
    if [ "$wave_fold_failed" -eq 1 ]; then
      fold_failed=1
    fi

    refresh_frontier "$manifest" "$PARENT" || true

    write_manifest "$manifest" --argjson wave "$wave" --argjson children "$(printf '%s\n' "${wave_children[@]}" | jq -cs 'map(tonumber)')" '
      .orchestration.waves = ($wave | tonumber)
      | .orchestration.waveLog = (((.orchestration.waveLog // []) ) + [{wave:$wave, children:$children}])
    ' || true

    if [ "$fold_failed" -eq 1 ]; then
      break
    fi
  done

  local landed failed rejected blocked remaining
  landed="$(jq -c '[.children[] | select(.merge.status == "landed") | .number] | sort' "$manifest")"
  failed="$(jq -c '[.children[] | select(.execution.status == "failed") | .number] | sort' "$manifest")"
  rejected="$(jq -c '[.children[] | select(.execution.status == "complete" and (.review.gate // "rejected") == "rejected") | .number] | sort' "$manifest")"
  blocked="$(jq -c '[.children[] | select(.state == "OPEN" and (.labels | index("ready-for-agent")) and .merge.status == null and (.execution.status // "pending") == "pending") | .number] | sort' "$manifest")"
  remaining="$(jq -r '
    [.children[]
      | select(.state == "OPEN")
      | select((.labels | index("ready-for-agent")) != null)
      | select(.merge.status != "landed")
    ] | length
  ' "$manifest")"

  write_manifest "$manifest" --argjson landed "$landed" --argjson failed "$failed" --argjson rejected "$rejected" --argjson blocked "$blocked" --argjson waves "$wave" --argjson remaining "$remaining" '
    .orchestration.landed = $landed
    | .orchestration.failed = $failed
    | .orchestration.rejected = $rejected
    | .orchestration.blocked = $blocked
    | .orchestration.waves = $waves
    | .orchestration.remainingOpenReady = $remaining
    | .orchestration.completed = (now | todate)
  ' || true

  lock_owned=0
  rm -rf "$lock_dir"
  trap - EXIT

  if [ "$fold_failed" -eq 1 ] || [ "$remaining" -gt 0 ]; then
    if [ "$fold_failed" -eq 1 ]; then
      echo "error: one or more fold_child_result calls failed; halting before reselecting the same children" >&2
    fi
    if [ "$remaining" -gt 0 ]; then
      echo "error: $remaining open ready-for-agent child(ren) remain unlanded after $wave wave(s)" >&2
    fi
    return 1
  fi
  return 0
}

merge_one_child() {
  local child="$1" manifest="$2" run_dir="$3" base_sha="$4" verify_cmd="$5" run_id="$6" child_branch="$7" child_commit="$8"

  jq -e --argjson child "$child" '
    .children[] as $c | select($c.number == $child)
    | ($c.execution.status == "complete")
      and ($c.execution.commitSha | type == "string")
      and ($c.review.gate == "accepted")
  ' "$manifest" >/dev/null 2>&1 || {
    write_manifest "$manifest" --argjson child "$child" --arg reason "not_reviewed" '
      .execution = ((.execution // {}) + {status:"failed", reason:$reason})
      | (.children[] | select(.number == $child)).merge = ((.children[] | select(.number == $child)).merge // {} | . + {status:"failed", reason:$reason})
    '
    echo "error: child #$child is not mechanically complete with an accepted review" >&2
    return 1
  }

  local batch_branch="gralph/$PARENT/batch"
  local batch_worktree="$run_dir/worktrees/batch-$run_id"
  if ! git -C "$REPO_ROOT" cat-file -e "$base_sha^{commit}" 2>/dev/null; then
    write_manifest "$manifest" --argjson child "$child" --arg reason "stale_base_sha" --arg batchBranch "$batch_branch" '
      .execution = ((.execution // {}) + {status:"failed", reason:$reason})
      | (.children[] | select(.number == $child)).merge = {batchBranch:$batchBranch, status:"failed", reason:$reason}
    '
    echo "error: saved base SHA is unavailable: $base_sha" >&2
    return 1
  fi
  mkdir -p "$(dirname "$batch_worktree")"
  if git -C "$REPO_ROOT" show-ref --verify --quiet "refs/heads/$batch_branch"; then
    git -C "$REPO_ROOT" worktree add "$batch_worktree" "$batch_branch" >/dev/null \
      || { echo "error: could not attach to batch branch $batch_branch" >&2; return 1; }
  else
    git -C "$REPO_ROOT" worktree add -b "$batch_branch" "$batch_worktree" "$base_sha" >/dev/null \
      || { echo "error: could not create batch branch $batch_branch from $base_sha" >&2; return 1; }
  fi
  write_manifest "$manifest" --argjson child "$child" --arg batchBranch "$batch_branch" --arg batchWorktree "$batch_worktree" '
    .execution.status = "landing"
    | (.children[] | select(.number == $child)).merge = {batchBranch:$batchBranch, batchWorktree:$batchWorktree, status:"creating"}
  ' || { echo "error: could not record landing intent" >&2; return 1; }

  local merge_msg="feat(#$child): land accepted Gralph child"
  if ! git -C "$batch_worktree" merge --no-ff --no-edit -m "$merge_msg" "$child_branch" >/dev/null 2>&1; then
    git -C "$batch_worktree" merge --abort 2>/dev/null || true
    write_manifest "$manifest" --argjson child "$child" --arg reason "merge_conflict" '
      .execution = ((.execution // {}) + {status:"failed", reason:$reason})
      | (.children[] | select(.number == $child)).merge += {status:"failed", reason:$reason}
    '
    echo "error: merge of $child_branch into $batch_branch reported a conflict" >&2
    return 1
  fi
  local merged_sha
  merged_sha="$(git -C "$batch_worktree" rev-parse HEAD)"
  write_manifest "$manifest" --argjson child "$child" --arg mergedSha "$merged_sha" --arg batchBranch "$batch_branch" --arg batchWorktree "$batch_worktree" '
    (.children[] | select(.number == $child)).merge = {batchBranch:$batchBranch, batchWorktree:$batchWorktree, status:"merged", mergedSha:$mergedSha}
  ' || { echo "error: could not record merge result" >&2; return 1; }

  local integration_log="$run_dir/worker-$child-integration.log"
  local -a integration_env=(env)
  local env_name
  while IFS= read -r env_name; do
    if [ "$env_name" = PI_CODING_AGENT_DIR ] || \
      [[ "${env_name^^}" =~ TOKEN|SECRET|PASSWORD|PASSWD|CREDENTIAL|API_?KEY|AUTH|SSH_AUTH_SOCK|GIT_ASKPASS ]]; then
      integration_env+=(-u "$env_name")
    fi
  done < <(compgen -e)
  set +e
  (cd "$batch_worktree" && "${integration_env[@]}" \
    HOME="/tmp/gralph-empty-home" GIT_CONFIG_NOSYSTEM=1 GIT_CONFIG_GLOBAL=/dev/null \
    GIT_CONFIG_COUNT=1 GIT_CONFIG_KEY_0=credential.helper GIT_CONFIG_VALUE_0= \
    GIT_TERMINAL_PROMPT=0 GCM_INTERACTIVE=Never GIT_SSH_COMMAND=false \
    /bin/sh -c "$verify_cmd") >"$integration_log" 2>&1
  local integration_rc=$?
  set -e
  if [ "$integration_rc" -ne 0 ]; then
    write_manifest "$manifest" --argjson child "$child" --argjson exitCode "$integration_rc" --arg integrationLog "$integration_log" --arg reason "integration_failed" '
      .execution = ((.execution // {}) + {status:"failed", reason:$reason})
      | (.children[] | select(.number == $child)).merge += {status:"failed", reason:$reason, integrationExitCode:$exitCode, integrationLog:$integrationLog}
    '
    echo "error: integration command exited $integration_rc" >&2
    return 1
  fi
  write_manifest "$manifest" --argjson child "$child" --argjson exitCode "$integration_rc" --arg integrationLog "$integration_log" --arg landedSha "$merged_sha" --arg childCommit "$child_commit" '
    .execution.status = "landed"
    | (.children[] | select(.number == $child)).merge += {status:"landed", integrationExitCode:$exitCode, integrationLog:$integrationLog, landedSha:$landedSha, childCommitSha:$childCommit}
  ' || { echo "error: could not record landed child" >&2; return 1; }

  printf 'Landed child #%s onto %s as %s\n' "$child" "$batch_branch" "$merged_sha"
  return 0
}

if [ "$DRY_RUN" -ne 1 ]; then
  [ "$VERIFY_SET" -eq 1 ] && [ -n "$VERIFY" ] || {
    echo "error: mutating runs require --verify <command>" >&2
    exit 2
  }
  manifest="$REPO_ROOT/.gralph/runs/$PARENT/manifest.json"
  [ -f "$manifest" ] || { echo "error: saved frontier missing: $manifest" >&2; exit 1; }
  jq -e --argjson parent "$PARENT" '
    .schemaVersion == 1 and .parent == $parent and (.baseSha | type == "string")
    and (.children | type == "array")
  ' "$manifest" >/dev/null || { echo "error: saved frontier is malformed" >&2; exit 1; }
  orchestrate_waves "$manifest" "$VERIFY" "$JOBS" || exit 1
  exit 0
fi

REPO_SLUG="$(gh repo view --json nameWithOwner --jq .nameWithOwner 2>/dev/null)" || {
  echo "error: cannot resolve the current GitHub repository" >&2
  exit 1
}
IFS=/ read -r OWNER REPO EXTRA <<<"$REPO_SLUG"
[ -n "${OWNER:-}" ] && [ -n "${REPO:-}" ] && [ -z "${EXTRA:-}" ] || {
  echo "error: gh returned an invalid repository name" >&2
  exit 1
}

read -r -d '' GRAPHQL_QUERY <<'GRAPHQL' || true
query GralphFrontier($owner: String!, $name: String!, $number: Int!) {
  repository(owner: $owner, name: $name) {
    issue(number: $number) {
      number
      title
      state
      subIssues(first: 100) {
        pageInfo { hasNextPage }
        nodes {
          number
          title
          state
          labels(first: 100) { nodes { name } }
          blockedBy(first: 100) {
            pageInfo { hasNextPage }
            nodes { number state }
          }
        }
      }
    }
  }
}
GRAPHQL

if ! RESPONSE="$(gh api graphql \
  -f query="$GRAPHQL_QUERY" \
  -F owner="$OWNER" \
  -F name="$REPO" \
  -F number="$PARENT" 2>&1)"; then
  echo "error: parent issue #$PARENT is inaccessible: $RESPONSE" >&2
  exit 1
fi

if ! printf '%s\n' "$RESPONSE" | jq -e . >/dev/null 2>&1; then
  echo "error: GitHub returned malformed JSON for parent issue #$PARENT" >&2
  exit 1
fi

if [ "$(printf '%s\n' "$RESPONSE" | jq -r '(.errors // []) | length')" -ne 0 ]; then
  echo "error: GitHub could not read parent issue #$PARENT" >&2
  exit 1
fi

if ! printf '%s\n' "$RESPONSE" | jq -e '.data.repository.issue | type == "object"' >/dev/null; then
  echo "error: parent issue #$PARENT was not found or is inaccessible" >&2
  exit 1
fi

PARENT_STATE="$(printf '%s\n' "$RESPONSE" | jq -r '.data.repository.issue.state')"
if [ "$PARENT_STATE" != OPEN ]; then
  echo "error: parent issue #$PARENT is not open" >&2
  exit 1
fi

if ! printf '%s\n' "$RESPONSE" | jq -e '
  .data.repository.issue as $parent
  | ($parent.number | type == "number")
    and ($parent.title | type == "string")
    and ($parent.subIssues.nodes | type == "array")
    and ($parent.subIssues.pageInfo.hasNextPage | type == "boolean")
    and all($parent.subIssues.nodes[];
      (.number | type == "number")
      and (.title | type == "string")
      and (.state == "OPEN" or .state == "CLOSED")
      and (.labels.nodes | type == "array")
      and all(.labels.nodes[]; .name | type == "string")
      and (.blockedBy.nodes | type == "array")
      and (.blockedBy.pageInfo.hasNextPage | type == "boolean")
      and all(.blockedBy.nodes[];
        (.number | type == "number") and (.state == "OPEN" or .state == "CLOSED")
      )
    )
' >/dev/null; then
  echo "error: GitHub returned malformed issue data for parent issue #$PARENT" >&2
  exit 1
fi

if [ "$(printf '%s\n' "$RESPONSE" | jq -r '.data.repository.issue.subIssues.pageInfo.hasNextPage')" = true ]; then
  echo "error: parent issue #$PARENT has more than 100 direct children" >&2
  exit 1
fi
if printf '%s\n' "$RESPONSE" | jq -e 'any(.data.repository.issue.subIssues.nodes[]; .blockedBy.pageInfo.hasNextPage)' >/dev/null; then
  echo "error: a child of parent issue #$PARENT has more than 100 blockers" >&2
  exit 1
fi

CHILDREN="$(printf '%s\n' "$RESPONSE" | jq -c '
  [.data.repository.issue.subIssues.nodes[]
    | ([.labels.nodes[].name] | sort | unique) as $labels
    | ([.blockedBy.nodes[] | {number, state}] | sort_by(.number)) as $blockers
    | {
        number,
        title,
        state,
        labels: $labels,
        blockedBy: [$blockers[].number],
        classification: (
          if .state != "OPEN" then "excluded"
          elif ($labels | index("ready-for-agent")) == null then "excluded"
          elif any($blockers[]; .state != "CLOSED") then "blocked"
          else "eligible"
          end
        ),
        reason: (
          if .state != "OPEN" then "child_not_open"
          elif ($labels | index("ready-for-agent")) == null then "missing_ready_for_agent_label"
          elif any($blockers[]; .state != "CLOSED") then "open_blockers"
          else null
          end
        )
      }
  ] | sort_by(.number)
')"

BASE_SHA="$(git rev-parse HEAD)"
RUN_DIR=".gralph/runs/$PARENT"
mkdir -p "$RUN_DIR"
TMP_MANIFEST="$RUN_DIR/.manifest.json.tmp.$$"
trap 'rm -f "$TMP_MANIFEST"' EXIT

jq -n \
  --argjson parent "$PARENT" \
  --arg baseSha "$BASE_SHA" \
  --arg verify "$VERIFY" \
  --argjson verifySet "$VERIFY_SET" \
  --argjson children "$CHILDREN" '
  {
    schemaVersion: 1,
    parent: $parent,
    baseSha: $baseSha,
    dryRun: true,
    children: $children,
    dependencies: (
      [$children[] as $child
        | $child.blockedBy[]
        | {issue: $child.number, blockedBy: .}
      ] | sort_by([.issue, .blockedBy])
    )
  }
  + (if $verifySet == 1 then {integrationCommand: $verify} else {} end)
' >"$TMP_MANIFEST"
mv "$TMP_MANIFEST" "$RUN_DIR/manifest.json"
trap - EXIT

printf 'Planned parent #%s: %s eligible, %s blocked, %s excluded\n' \
  "$PARENT" \
  "$(printf '%s' "$CHILDREN" | jq '[.[] | select(.classification == "eligible")] | length')" \
  "$(printf '%s' "$CHILDREN" | jq '[.[] | select(.classification == "blocked")] | length')" \
  "$(printf '%s' "$CHILDREN" | jq '[.[] | select(.classification == "excluded")] | length')"
printf 'Manifest: %s\n' "$RUN_DIR/manifest.json"
