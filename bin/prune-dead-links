#!/usr/bin/env python3
"""Delete symlinks under $HOME that point INTO this repo and no longer resolve.

Usage: prune-dead-links [--check|--selftest]
  (no args)   delete them, exit 0
  --check     report only, exit 1 if any remain
  --selftest  run the path-safety fixtures, exit 1 on any failure

Residue from links install.sh used to declare (see docs/specs/k551-dangling-symlinks.md).
Run from the repo like check.sh; it is not linked into $HOME.

THE SAFETY RULE: a symlink is removed only when its target resolves inside
$DOTFILES_DIR and does not exist. Broken links pointing anywhere else belong to
other programs (~/.claude/debug/latest, SingletonLock files, ~/.config/pulse/*-runtime)
or to another repo (~/.agents/skills/*) and are left strictly alone.

Deciding "inside the repo" means canonicalizing a path that does not exist, through
symlinks that may themselves be dangling. A hand-rolled shell version was attempted
and got that wrong five times — each time deleting a link that resolved OUTSIDE the
repo, and each time passing a green test suite. os.path.realpath(strict=False) does
it correctly by construction: it resolves symlinks physically and folds `..` against
the real parent, on paths that need not exist.
"""

import os
import sys

MAX_DEPTH = 3


def canonical(path):
    return os.path.realpath(path, strict=False)


def inside(target, root):
    """True when target is the repo root itself or a path under it."""
    return target == root or target.startswith(root + os.sep)


def dangling_links(home):
    """Symlinks up to MAX_DEPTH below home that do not resolve, skipping the repo
    and the cache — the same scope as the spec's reproduction command."""
    skip = {
        canonical(os.path.join(home, "dotfiles")),
        canonical(os.path.join(home, ".cache")),
    }
    for dirpath, dirnames, filenames in os.walk(home, followlinks=False):
        rel = os.path.relpath(dirpath, home)
        depth = 0 if rel == os.curdir else rel.count(os.sep) + 1
        dirnames[:] = [
            d for d in dirnames if canonical(os.path.join(dirpath, d)) not in skip
        ]
        for name in list(dirnames) + filenames:
            link = os.path.join(dirpath, name)
            if os.path.islink(link) and not os.path.exists(link):
                yield link
        if depth + 1 >= MAX_DEPTH:
            dirnames[:] = []


def prune(mode, home, root):
    # Reject empty or root-resolving configuration at the trust boundary. A repo
    # of "everything" is never a real configuration, and scanning from / would
    # treat every dangling link on the machine as residue.
    if not home or not root:
        print(
            "refusing to run: HOME and DOTFILES_DIR must both be non-empty",
            file=sys.stderr,
        )
        return 2
    home, root = canonical(home), canonical(root)
    if home == os.sep or root == os.sep:
        print(
            "refusing to run: DOTFILES_DIR and HOME must not resolve to /",
            file=sys.stderr,
        )
        return 2

    found = 0
    for link in sorted(dangling_links(home)):
        target = canonical(link)
        if not inside(target, root):
            continue
        found += 1
        if mode == "check":
            print("dangling: %s -> %s" % (link, target))
        else:
            os.remove(link)
            print("removed: %s -> %s" % (link, target))

    if mode == "check":
        print("%d dangling link(s) pointing into %s" % (found, root))
        return 1 if found else 0
    print("pruned %d dangling link(s) pointing into %s" % (found, root))
    return 0


def selftest():
    """Every case here is a shape a previous hand-rolled implementation got wrong,
    or a direction that must not regress. Both directions are pinned: an escaping
    link must survive, and genuine repo residue must be pruned."""
    import shutil
    import tempfile

    fix = tempfile.mkdtemp(prefix="prune-dead-links-test.")
    rc = 0
    try:

        def d(*parts):
            return os.path.join(fix, *parts)

        for sub in ("dotfiles/real", "dotfiles/b", ".config/deep", ".cache", "outside"):
            os.makedirs(d(*sub.split("/")), exist_ok=True)

        os.symlink(d("outside"), d("dotfiles", "outlink"))
        os.symlink(d("outside", "gone"), d("dotfiles", "deadout"))
        os.symlink(d("dotfiles", "nothing"), d("dotfiles", "deadin"))
        os.symlink("../outside/nowhere", d("dotfiles", "deadrel"))
        os.symlink(d("outside", "gone"), d("dotfiles", "b", "esc"))
        os.symlink(d("dotfiles", "insx-gone"), d("dotfiles", "b", "ins"))
        os.symlink(d("dotfiles", "nope"), d("dotfiles", "deadmid"))
        os.symlink(d("dotfiles", "cyc-b"), d("dotfiles", "cyc-a"))
        os.symlink(d("dotfiles", "cyc-a"), d("dotfiles", "cyc-b"))
        os.symlink(d("outside", "cyc-q"), d("outside", "cyc-p"))
        os.symlink(d("outside", "cyc-p"), d("outside", "cyc-q"))
        os.symlink(d("outside", "cyc-p"), d("dotfiles", "cyc-out"))

        cases = [
            (".config/resolves", d("dotfiles", "real"), "kept"),
            (".config/absolute-residue", d("dotfiles", "gone"), "gone"),
            (".config/relative-residue", "../dotfiles/gone", "gone"),
            (".config/dotdot-escape", d("dotfiles", "..", "outside", "missing"), "kept"),
            (".config/symlink-escape", d("dotfiles", "outlink", "..", "escaped"), "kept"),
            (".config/dead-intermediate-out", d("dotfiles", "deadout", "..", "escaped"), "kept"),
            (".config/dead-intermediate-in", d("dotfiles", "deadin", "..", "gone"), "gone"),
            (".config/dead-intermediate-relative", d("dotfiles", "deadrel", "..", "escaped"), "kept"),
            # A symlink cycle inside the repo. `<repo>/cyc-a/../x` resolves to
            # `<repo>/x` — genuinely inside — so pruning is correct. The old
            # shell version kept it only because it gave up on cycles; that was
            # a limitation, not the rule. Confirmed against `realpath -m`.
            (".config/cyclic-inside", d("dotfiles", "cyc-a", "..", "x"), "gone"),
            # A cycle reached through a link that leaves the repo must survive.
            (".config/cyclic-outside", d("dotfiles", "cyc-out", "..", "x"), "kept"),
            (".config/deep/via-alias", d("dotfiles", "outlink", "sub", "..", "..", "outside", "gone"), "kept"),
            (".config/escape-after-dotdot", d("dotfiles", "b", "nothere", "..", "esc", "leaf"), "kept"),
            (".config/inside-after-dotdot", d("dotfiles", "b", "nothere", "..", "ins", "leaf"), "gone"),
            (".config/dotdot-not-leading", d("dotfiles", "deadmid", "sub", "..", "leaf"), "gone"),
            (".config/dot-escape", d("dotfiles", "nope", ".", "..", "b", "esc", "leaf"), "kept"),
            (".config/dot-inside", d("dotfiles", "nope", ".", "..", "b", "ins", "leaf"), "gone"),
            (".config/dot-plain", d("dotfiles", ".", "gone-dot"), "gone"),
            (".config/root-itself", d("dotfiles", "missing", ".."), "gone"),
            (".config/fs-root", "/nonexistentxyz/..", "kept"),
            (".config/foreign", "/nonexistent/elsewhere", "kept"),
            (".config/space name", d("dotfiles", "gone one"), "gone"),
            (".config/newline\nname", d("dotfiles", "gone\ntwo"), "gone"),
            (".config/star", d("dotfiles", "glob*gone"), "gone"),
            (".cache/excluded", d("dotfiles", "cache-gone"), "kept"),
        ]
        for rel, target, _ in cases:
            os.symlink(target, d(*rel.split("/")))

        prune("prune", fix, d("dotfiles"))

        for rel, _, want in cases:
            got = "kept" if os.path.islink(d(*rel.split("/"))) else "gone"
            label = rel.replace("\n", "\\n")
            if got != want:
                print("FAIL: %s should be %s, was %s" % (label, want, got))
                rc = 1
            else:
                print("ok: %s %s" % (label, want))

        # Empty and root-resolving configuration must refuse and delete nothing.
        victim = d(".config", "guard-victim")
        os.symlink(d("dotfiles", "gone-guard"), victim)
        for home, root, label in [
            ("", d("dotfiles"), "empty HOME"),
            (fix, "", "empty DOTFILES_DIR"),
            (fix, "/", "DOTFILES_DIR=/"),
            (fix, "/nonexistent/..", "DOTFILES_DIR=/nonexistent/.."),
            ("/", d("dotfiles"), "HOME=/"),
        ]:
            if prune("prune", home, root) == 2:
                print("ok: %s refused" % label)
            else:
                print("FAIL: %s was accepted" % label)
                rc = 1
        if os.path.islink(victim):
            print("ok: refused runs deleted nothing")
        else:
            print("FAIL: a refused run deleted a link")
            rc = 1
        os.remove(victim)

        if prune("check", fix, d("dotfiles")) == 0:
            print("ok: --check exits 0 once residue is gone")
        else:
            print("FAIL: --check still non-zero after pruning")
            rc = 1
    finally:
        shutil.rmtree(fix, ignore_errors=True)

    print("selftest passed" if rc == 0 else "selftest FAILED")
    return rc


def main(argv):
    home = os.environ.get("HOME", "")
    root = os.environ.get("DOTFILES_DIR") or (os.path.join(home, "dotfiles") if home else "")
    if not argv:
        return prune("prune", home, root)
    if argv == ["--check"]:
        return prune("check", home, root)
    if argv == ["--selftest"]:
        return selftest()
    print("usage: %s [--check|--selftest]" % os.path.basename(sys.argv[0]), file=sys.stderr)
    return 2


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
