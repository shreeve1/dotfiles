#!/usr/bin/env bash
# Delete symlinks under $HOME that point INTO this repo and no longer resolve.
#
# Usage: prune-dead-links [--check|--selftest]
#   (no args)   delete them, exit 0
#   --check     report only, exit 1 if any remain — the card's acceptance command
#   --selftest  run the path-safety fixtures, exit 1 on any failure
#
# Residue from links install.sh used to declare (see docs/specs/k551-dangling-symlinks.md).
# Run from the repo like check.sh; it is not linked into $HOME.
#
# THE SAFETY RULE: a symlink is removed only when its target resolves inside
# $DOTFILES_DIR *and* does not exist. Broken links pointing anywhere else belong
# to other programs (~/.claude/debug/latest, SingletonLock files,
# ~/.config/pulse/*-runtime) or to another repo (~/.agents/skills/*) and are left
# strictly alone. Comparing the target to $DOTFILES_DIR as TEXT is not good
# enough for that rule: `$DOTFILES_DIR/../outside/x` matches the prefix while
# resolving outside, and a relative target like `../dotfiles/x` resolves inside
# while never matching it. Both were reproduced on fixtures. Hence canonicalize().

set -uo pipefail

DOTFILES_DIR="${DOTFILES_DIR:-$HOME/dotfiles}"

# Resolve a possibly-nonexistent path to its physical form, portably.
#
# This repo syncs to a Mac, so neither obvious tool is usable: BSD/macOS
# `realpath` has no -m, and `readlink -f` rejects a missing path (verified: it
# exits 1 even on GNU coreutils 9.4). Pure lexical folding of `..` is not enough
# either — it cannot see that an intermediate symlink leaves the repo.
#
# So: walk up to the deepest ancestor that really exists, canonicalize THAT with
# `cd` + `pwd -P` (POSIX, present everywhere, bash 3.2 safe), then re-attach the
# missing remainder. `cd` resolves `..` and intermediate symlinks physically, so
# a target cannot look repo-internal merely by how it is spelled.
#
# Returns 1 when the missing remainder still contains a `..` segment, which
# cannot be resolved against directories that do not exist. The caller must then
# leave the link alone — refusing to classify is the safe answer for an `rm`.
canonicalize() {
  local path=$1 rest= base real
  case $path in
  /*) ;;
  *) path="$PWD/$path" ;;
  esac
  while [ ! -d "$path" ]; do
    base=${path##*/}
    rest="/$base$rest"
    path=${path%/*}
    [ -n "$path" ] || path=/
  done
  # -P is load-bearing: plain `cd` treats `..` logically, so
  # `<repo>/outlink/../escaped` would fold back to `<repo>/escaped` and look
  # repo-internal even though outlink leaves the repo. The selftest catches it.
  real=$(cd -P "$path" 2>/dev/null && pwd -P) || return 1
  [ "$real" = / ] && real=

  # $real is physical, but the MISSING remainder may still hide two things: a
  # symlink component (the -d walk stops at the deepest DIRECTORY, so a dangling
  # or file symlink is left in $rest unexpanded), and a `..`.
  #
  # Both must be resolved, and the symlink FIRST. Expanding only when a `..` is
  # present was a real bug: `<repo>/b/nothere/../esc/leaf` folded to
  # `<repo>/b/esc/leaf` and returned it verbatim, so an `esc` symlink pointing
  # OUTSIDE the repo was never consulted and the link was deleted — the exact
  # failure the safety rule exists to prevent. Expand first, always.
  #
  # Depth is bounded so a symlink cycle terminates as unresolvable rather than
  # spinning. Refusing to classify is always the safe answer ahead of an rm.
  if [ -n "$rest" ]; then
    local depth=${CANON_DEPTH:-0} first target
    [ "$depth" -ge 16 ] && return 1
    first=${rest#/}
    first=${first%%/*}
    if [ -L "$real/$first" ]; then
      target=$(readlink "$real/$first")
      case $target in
      /*) ;;
      *) target="$real/$target" ;;
      esac
      CANON_DEPTH=$((depth + 1)) canonicalize "$target${rest#/$first}"
      return $?
    fi
    # Not a symlink and not a directory, so it is an ordinary missing name (or a
    # plain file). Nothing can hide behind it: a following `..` may be dropped
    # together with it, and the result re-resolved so any later symlink is still
    # expanded by the recursion.
    case $rest in
    "/$first/../"*|"/$first/..")
      CANON_DEPTH=$((depth + 1)) canonicalize "$real${rest#/$first/..}"
      return $?
      ;;
    esac
    # A `..` deeper in the remainder, behind a name that cannot be expanded.
    case $rest in
    */../*|*/..) return 1 ;;
    esac
  fi
  printf '%s\n' "$real$rest"
}

prune() {
  local mode=$1 home=$2 root=$3
  local canon link dest real found=0
  canon=$(canonicalize "$root") || {
    printf 'cannot resolve DOTFILES_DIR: %s\n' "$root" >&2
    return 2
  }

  # Depth 3 from $home, skipping the repo itself and the cache — the same scope
  # as the reproduction command in the spec.
  while IFS= read -r link; do
    dest=$(readlink "$link") || continue
    case $dest in
    /*) ;;
    *) dest="$(dirname "$link")/$dest" ;;
    esac
    if ! real=$(canonicalize "$dest"); then
      printf 'skipped (unresolvable target): %s -> %s\n' "$link" "$dest"
      continue
    fi
    case $real in
    "$canon"/*) ;;
    *) continue ;;
    esac
    found=$((found + 1))
    if [ "$mode" = check ]; then
      printf 'dangling: %s -> %s\n' "$link" "$real"
    else
      rm -f "$link"
      printf 'removed: %s -> %s\n' "$link" "$real"
    fi
  done < <(find "$home" -maxdepth 3 -type l \
    -not -path "$canon/*" \
    -not -path "$home/.cache/*" \
    -exec test ! -e {} \; -print)

  if [ "$mode" = check ]; then
    printf '%d dangling link(s) pointing into %s\n' "$found" "$canon"
    [ "$found" -eq 0 ] || return 1
    return 0
  fi
  printf 'pruned %d dangling link(s) pointing into %s\n' "$found" "$canon"
  return 0
}

# Fixtures for the safety rule. Committed and runnable so the Mac this repo
# syncs to can prove the same cases — the defects below are latent on Linux
# today (every live dangling target here is a clean absolute path) and the
# original fixture missed them by using only clean absolute paths.
selftest() {
  local fix rc=0
  fix=$(mktemp -d "${TMPDIR:-/tmp}/prune-dead-links-test.XXXXXX") || return 2
  mkdir -p "$fix/dotfiles/real" "$fix/outside" "$fix/.config" "$fix/.cache"
  ln -s "$fix/outside" "$fix/dotfiles/outlink"

  ln -s "$fix/dotfiles/real" "$fix/.config/resolves"
  ln -s "$fix/dotfiles/gone" "$fix/.config/absolute-residue"
  ln -s "../dotfiles/gone" "$fix/.config/relative-residue"
  ln -s "$fix/dotfiles/../outside/missing" "$fix/.config/dotdot-escape"
  ln -s "$fix/dotfiles/outlink/../escaped" "$fix/.config/symlink-escape"
  ln -s /nonexistent/elsewhere "$fix/.config/foreign"
  ln -s "$fix/.cache/gone" "$fix/.cache/excluded"

  # Escapes THROUGH a dangling intermediate. The intermediate does not resolve,
  # so the `..` has to be folded lexically against an already-physical prefix.
  # Both directions matter: the outward one must survive (safety) and the
  # inward one must be pruned (completeness — the spec's Goal requires it).
  ln -s "$fix/outside/nowhere" "$fix/dotfiles/deadout"
  ln -s "$fix/dotfiles/deadout/../escaped" "$fix/.config/dead-intermediate-out"
  ln -s "$fix/dotfiles/nothing" "$fix/dotfiles/deadin"
  ln -s "$fix/dotfiles/deadin/../gone" "$fix/.config/dead-intermediate-in"

  # Same escape, but the dangling intermediate's own target is RELATIVE. If the
  # expansion resolved it against the wrong base it would look repo-internal.
  ln -s "../outside/nowhere" "$fix/dotfiles/deadrel"
  ln -s "$fix/dotfiles/deadrel/../escaped" "$fix/.config/dead-intermediate-relative"

  # Symlink CYCLE behind a `..`. Must terminate via the depth bound and be
  # skipped, never hang and never be deleted on a guess.
  ln -s "$fix/dotfiles/cyc-b" "$fix/dotfiles/cyc-a"
  ln -s "$fix/dotfiles/cyc-a" "$fix/dotfiles/cyc-b"
  ln -s "$fix/dotfiles/cyc-a/../x" "$fix/.config/cyclic"

  # A PHYSICAL parent: the link sits under a real directory reached through a
  # symlinked ancestor, so `..` must fold against the physical path, not the
  # logical one. Here $fix/.config/deep is a real dir; via-alias reaches it
  # through an alias symlink and escapes the repo.
  mkdir -p "$fix/.config/deep"
  ln -s "$fix/outside" "$fix/dotfiles/alias"
  ln -s "$fix/dotfiles/alias/sub/../../outside/gone" "$fix/.config/deep/via-alias"

  # An escaping symlink AFTER the `..`, behind a missing name. Regression for a
  # real safety bug: dropping `nothere/..` and returning the folded path meant
  # `esc` was never expanded, so a link resolving OUTSIDE the repo was deleted.
  mkdir -p "$fix/dotfiles/b"
  ln -s "$fix/outside/gone" "$fix/dotfiles/b/esc"
  ln -s "$fix/dotfiles/b/nothere/../esc/leaf" "$fix/.config/escape-after-dotdot"

  # Same shape, but the symlink after the `..` stays INSIDE the repo, so the
  # link is genuine residue and must still be pruned. Guards against "fixing"
  # the case above by refusing everything.
  ln -s "$fix/dotfiles/inner-gone" "$fix/dotfiles/b/ins"
  ln -s "$fix/dotfiles/b/nothere/../ins/leaf" "$fix/.config/inside-after-dotdot"

  prune prune "$fix" "$fix/dotfiles" >/dev/null

  check() {
    local path=$1 want=$2
    if [ "$want" = gone ] && [ -L "$fix/$path" ]; then
      printf 'FAIL: %s should have been pruned, survived\n' "$path"
      rc=1
    elif [ "$want" = kept ] && [ ! -L "$fix/$path" ]; then
      printf 'FAIL: %s should have survived, was deleted\n' "$path"
      rc=1
    else
      printf 'ok: %s %s\n' "$path" "$want"
    fi
  }

  check .config/absolute-residue gone
  check .config/relative-residue gone
  check .config/dotdot-escape kept
  check .config/symlink-escape kept
  check .config/dead-intermediate-out kept
  check .config/dead-intermediate-in gone
  check .config/dead-intermediate-relative kept
  check .config/cyclic kept
  check .config/deep/via-alias kept
  check .config/escape-after-dotdot kept
  check .config/inside-after-dotdot gone
  check .config/foreign kept
  check .config/resolves kept
  check .cache/excluded kept

  if prune check "$fix" "$fix/dotfiles" >/dev/null; then
    printf 'ok: --check exits 0 once residue is gone\n'
  else
    printf 'FAIL: --check still non-zero after pruning\n'
    rc=1
  fi

  rm -rf "$fix"
  [ "$rc" -eq 0 ] && printf 'selftest passed\n' || printf 'selftest FAILED\n'
  return "$rc"
}

case "$*" in
"") prune prune "$HOME" "$DOTFILES_DIR" ;;
--check) prune check "$HOME" "$DOTFILES_DIR" ;;
--selftest) selftest ;;
*)
  printf 'usage: %s [--check|--selftest]\n' "${0##*/}" >&2
  exit 2
  ;;
esac
