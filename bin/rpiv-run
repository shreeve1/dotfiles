#!/usr/bin/env bash
# rpiv-run — drive the RPIV skill pipeline unattended on a fresh branch.
#
# Each step runs in a FRESH interactive session of the selected engine
# (--engine claude|pi, default pi) inside a private tmux socket. NOT print
# mode (`claude -p` / `pi -p`) — print mode is being retired, and the SDK cannot
# invoke a skill by name. Slash commands work in interactive mode, so each step
# triggers its exact skill. Context is fresh per step; handoff is via on-disk
# artifacts under .rpiv/artifacts/<type>/. No quality gates; commits always.
# Both engines' rpiv skills write the same artifact dir names (research, designs,
# plans), so the on-disk handoff is engine-independent.
#
# Between generative steps a gap-sweep runs (/gap-sweep skill): a fresh session
# sweeps the just-produced artifact for CRITICAL gaps only, fixes them in place,
# and continues. This is NOT a gate — it never blocks, it improves and moves on.
#
# Note: pi steps run slower than claude (the rpiv-advisor extension adds
# deliberation/cleanup rounds), so keep the default timeouts for pi — do not
# shrink RPIV_STEP_TIMEOUT or steps can time out before printing the marker.
#
# Prereq: run /discover interactively first to produce an FRD under
# .rpiv/artifacts/discover/. The host must already be onboarded for the chosen
# engine (logged in + directory trusted) — readiness detection waits for the
# input UI, not for theme/trust/login prompts.
#
# Engine mirrors .claude/skills/dev-review-claude (tmux send-keys + nonce marker).

set -euo pipefail

# --- config (override via env or flags) ---
ENGINE="${RPIV_ENGINE:-pi}"                   # claude | pi
MODEL="${RPIV_MODEL:-}"                        # engine-specific; empty = default
                                               #   claude: opus, sonnet
                                               #   pi: provider/id pattern, e.g. anthropic/claude-opus-4
PROVIDER="${RPIV_PROVIDER:-}"                  # pi only; empty = pi default provider
ASSUME_YES="${RPIV_YES:-}"                     # non-empty to skip kickoff confirm
BRANCH_PREFIX="${RPIV_BRANCH_PREFIX:-rpiv}"
STEP_TIMEOUT="${RPIV_STEP_TIMEOUT:-2400}"          # seconds per step (40m)
IMPLEMENT_TIMEOUT="${RPIV_IMPLEMENT_TIMEOUT:-7200}" # seconds for implement (2h)
READY_TIMEOUT="${RPIV_READY_TIMEOUT:-60}"          # seconds to wait for engine TUI
# Idle-UI marker; engine-specific default is set after flag parsing (see below).
# claude: bypassPermissions always shows "bypass permissions on".
# pi: the footer context meter "<n>%/<n>k" only renders once the TUI is live.
# Override via RPIV_READY_PATTERN if a TUI footer changes.
READY_PATTERN="${RPIV_READY_PATTERN:-}"

usage() {
  cat <<'EOF'
usage: rpiv-run [-y|--yes] [--engine claude|pi] [--model M] [--provider P]

Run /discover interactively first. Then rpiv-run drives
research -> design -> plan -> implement -> validate -> code-review -> commit
in fresh interactive engine sessions (via tmux), unattended, on a fresh branch.

--engine selects the agent CLI (default pi; pass --engine claude for Claude).
--provider applies to pi only.
--model is engine-specific: claude takes opus/sonnet; pi takes a provider/id
pattern (e.g. anthropic/claude-opus-4).

Without -y/RPIV_YES the kickoff requires a TTY to confirm; for unattended/cron
runs you MUST pass -y or set RPIV_YES=1.

env: RPIV_ENGINE RPIV_MODEL RPIV_PROVIDER RPIV_YES RPIV_BRANCH_PREFIX
     RPIV_STEP_TIMEOUT RPIV_IMPLEMENT_TIMEOUT RPIV_READY_TIMEOUT RPIV_READY_PATTERN
EOF
}

while [ $# -gt 0 ]; do
  case "$1" in
    -y|--yes)   ASSUME_YES=1 ;;
    --engine)   ENGINE="$2"; shift ;;
    --model)    MODEL="$2"; shift ;;
    --provider) PROVIDER="$2"; shift ;;
    -h|--help)  usage; exit 0 ;;
    *) echo "unknown arg: $1" >&2; usage >&2; exit 2 ;;
  esac
  shift
done

case "$ENGINE" in
  claude|pi) ;;
  *) echo "error: --engine must be 'claude' or 'pi' (got: $ENGINE)" >&2; exit 2 ;;
esac

# Engine-specific idle-UI readiness marker (unless overridden via RPIV_READY_PATTERN).
if [ -z "$READY_PATTERN" ]; then
  case "$ENGINE" in
    claude) READY_PATTERN='bypass permissions on|shift\+tab to cycle' ;;
    pi)     READY_PATTERN='[0-9]+%/[0-9]+k' ;;
  esac
fi

command -v "$ENGINE" >/dev/null 2>&1 || { echo "error: $ENGINE CLI not on PATH" >&2; exit 1; }
command -v tmux   >/dev/null 2>&1 || { echo "error: tmux not on PATH" >&2; exit 1; }
git rev-parse --is-inside-work-tree >/dev/null 2>&1 || { echo "error: not in a git repo" >&2; exit 1; }

# Newest *.md in a dir (used for the pre-existing FRD).
newest() { ls -t "$1"/*.md 2>/dev/null | head -1; }

# Newest *.md created during THIS run (newer than the start marker). Avoids
# picking up stale artifacts from a prior feature in the same dir.
newest_since() {
  local d="$1" f best=
  for f in "$d"/*.md; do
    [ -e "$f" ] || continue
    [ "$f" -nt "$STARTMARK" ] || continue
    if [ -z "$best" ] || [ "$f" -nt "$best" ]; then best="$f"; fi
  done
  printf '%s' "$best"
}

FRD="$(newest .rpiv/artifacts/discover || true)"
[ -n "${FRD:-}" ] || { echo "error: no FRD in .rpiv/artifacts/discover/ — run /discover first" >&2; exit 1; }

TS="$(date +%Y%m%d-%H%M%S)"
BRANCH="${BRANCH_PREFIX}/${TS}"
LOGDIR=".rpiv/run/${TS}"
SOCKET="${TMPDIR:-/tmp}/rpiv-tmux-${TS}.sock"
STARTMARK="$LOGDIR/.start"
mkdir -p "$LOGDIR"
touch "$STARTMARK"

# Keep run logs out of the autonomous /commit sweep (local, per-repo, untracked).
GITDIR="$(git rev-parse --git-dir)"
mkdir -p "$GITDIR/info"
grep -qxF '.rpiv/run/' "$GITDIR/info/exclude" 2>/dev/null \
  || printf '%s\n' '.rpiv/run/' >> "$GITDIR/info/exclude"

ORIG_REF="$(git symbolic-ref --short -q HEAD || git rev-parse --short HEAD)"
printf '%s\n' "$ORIG_REF" > "$LOGDIR/.base"   # base ref, for rpiv-merge to read back
BRANCH_CREATED=
CUR_SESSION=""
cleanup() {
  local rc=$?
  [ -n "$CUR_SESSION" ] && tmux -S "$SOCKET" kill-session -t "$CUR_SESSION" 2>/dev/null || true
  tmux -S "$SOCKET" kill-server 2>/dev/null || true
  if [ "$rc" -ne 0 ] && [ -n "$BRANCH_CREATED" ]; then
    echo >&2
    echo "pipeline exited ($rc) on branch $BRANCH — work left for inspection." >&2
    echo "return to your previous ref with: git checkout $ORIG_REF" >&2
  fi
}
trap cleanup EXIT

PROVIDER_NOTE=""
[ "$ENGINE" = pi ] && [ -n "$PROVIDER" ] && PROVIDER_NOTE="  provider: $PROVIDER"

cat <<EOF

RPIV pipeline kickoff
  FRD:      $FRD
  branch:   $BRANCH (fresh, from $ORIG_REF)
  engine:   interactive $ENGINE via tmux (fresh session per step)
  model:    ${MODEL:-<$ENGINE default>}${PROVIDER_NOTE}
  steps:    research -> design -> plan -> implement -> validate -> code-review -> commit
            (+ gap-sweep after FRD/research/design/plan/implement)
  mode:     unattended | auto-accept defaults | commit always
  timeout:  ${STEP_TIMEOUT}s/step, ${IMPLEMENT_TIMEOUT}s for implement
  logs:     $LOGDIR/

----- FRD head -----
EOF
sed -n '1,25p' "$FRD"
echo "--------------------"

if [ -z "${ASSUME_YES:-}" ]; then
  if [ ! -t 0 ]; then
    echo "error: no TTY to confirm — pass -y or set RPIV_YES=1 for unattended runs" >&2
    exit 1
  fi
  printf 'Proceed? [y/N] '
  read -r reply
  case "$reply" in y|Y|yes|YES) ;; *) echo "aborted."; exit 0 ;; esac
fi

git checkout -b "$BRANCH"
BRANCH_CREATED=1

# run_skill <step-name> <message-to-paste> [timeout-seconds]
run_skill() {
  local name="$1" message="$2" timeout="${3:-$STEP_TIMEOUT}"
  local session="rpiv-${name}-$(date +%s)"
  local nonce="$(date +%s)$RANDOM"
  local marker="RPIV_DONE_${nonce}"
  local log="$LOGDIR/${name}.log"
  local msgfile; msgfile="$(mktemp "${TMPDIR:-/tmp}/rpiv-msg-XXXXXX")"

  # Split-token instruction: the concatenated marker NEVER appears in this
  # string (only "RPIV_DONE_" and the digits, separated), so the send-keys
  # command echo in the pane cannot false-trigger detection. The agent prints
  # the concatenated form on its own final line, which is what we poll for.
  # NOTE: keep this text apostrophe-free for readability; apostrophes are
  # escaped below regardless, but avoiding them keeps the launch line clean.
  local sys="You are one fully autonomous step in an unattended pipeline. Complete the command you are given, end to end. At any decision point, checkpoint, or clarifying question, silently pick your recommended default and proceed. Never ask the user anything. Never wait for input. When the work is fully complete and any artifact is written, print on its own final line, with nothing else on that line, the marker RPIV_DONE_ immediately followed by the digits ${nonce} with no space between them, then stop."
  # Harden single-quote wrapping: replace ' with '\'' so a future apostrophe
  # cannot break the command line sent via send-keys.
  local sys_q=${sys//\'/\'\\\'\'}

  echo; echo "===== $name ====="
  CUR_SESSION="$session"

  tmux -S "$SOCKET" set-option -g history-limit 100000 \; \
       new-session -d -s "$session" -c "$PWD" -n "$name"

  # Build the engine launch command. claude uses bypassPermissions to suppress
  # per-tool prompts; pi has no permission system (omit). The autonomy +
  # nonce-marker system prompt is identical for both engines.
  local cmd
  if [ "$ENGINE" = pi ]; then
    cmd="pi"
    [ -n "$PROVIDER" ] && cmd="$cmd --provider $PROVIDER"
    [ -n "$MODEL" ]    && cmd="$cmd --model $MODEL"
  else
    cmd="claude --permission-mode bypassPermissions"
    [ -n "$MODEL" ]    && cmd="$cmd --model $MODEL"
  fi
  cmd="$cmd --append-system-prompt '$sys_q'"
  tmux -S "$SOCKET" send-keys -t "$session":0.0 -- "$cmd" Enter

  # Wait for the engine input UI before pasting. claude shows the readiness
  # footer only once the input is interactive, so a single pattern match is
  # enough. pi paints its footer context meter *before* the startup banners
  # (skill-conflict / update notices) finish streaming, so a bare match fires
  # early and the first paste lands in a not-yet-interactive box and is dropped.
  # For pi, additionally require the pane to settle (two consecutive identical
  # captures) so startup output has stopped before we paste.
  local i ready= prev= stable=0 pane=
  for ((i=0; i<READY_TIMEOUT; i++)); do
    pane="$(tmux -S "$SOCKET" capture-pane -p -t "$session":0.0 2>/dev/null || true)"
    if printf '%s' "$pane" | grep -qiE "$READY_PATTERN"; then
      if [ "$ENGINE" = pi ]; then
        if [ "$pane" = "$prev" ]; then stable=$((stable+1)); else stable=0; fi
        [ "$stable" -ge 2 ] && { ready=1; break; }
      else
        ready=1; break
      fi
    fi
    prev="$pane"; sleep 1
  done
  if [ -z "$ready" ]; then
    tmux -S "$SOCKET" capture-pane -p -t "$session":0.0 > "$log" 2>/dev/null || true
    echo "error: $ENGINE TUI not ready after ${READY_TIMEOUT}s (step $name). Pane saved to $log." >&2
    rm -f "$msgfile"; return 1
  fi

  # Paste the bare slash command (no quoting risk). Settle briefly so any
  # slash/path autocomplete popup closes before Enter submits the line.
  printf '%s' "$message" > "$msgfile"
  tmux -S "$SOCKET" load-buffer -b rpiv "$msgfile"
  tmux -S "$SOCKET" paste-buffer -b rpiv -t "$session":0.0
  sleep 1
  tmux -S "$SOCKET" send-keys -t "$session":0.0 Enter

  # Poll for the done marker on its own line (anchored to start-of-line after
  # optional whitespace) so a mid-stream mention of the token cannot fire early.
  # Side effect: every ~5s dump the current capture to the step log so the log
  # exists *during* the step (live view via `watch -n5 cat "$log"` or
  # `tail -f "$log"`), not only at completion — this removes the "no log =
  # stuck" ambiguity. capture-pane is read-only and cannot corrupt the pane.
  local done= snap=
  for ((i=0; i<timeout; i++)); do
    snap="$(tmux -S "$SOCKET" capture-pane -p -J -S - -t "$session":0.0 2>/dev/null || true)"
    if printf '%s\n' "$snap" | grep -qE "^[[:space:]]*${marker}([[:space:]]|$)"; then
      done=1; break
    fi
    (( i % 5 == 0 )) && printf '%s\n' "$snap" > "$log"
    sleep 1
  done

  tmux -S "$SOCKET" capture-pane -p -J -S - -t "$session":0.0 > "$log" 2>/dev/null || true
  tmux -S "$SOCKET" kill-session -t "$session" 2>/dev/null || true
  CUR_SESSION=""
  rm -f "$msgfile"

  if [ -z "$done" ]; then
    echo "error: step '$name' did not finish within ${timeout}s. Pane saved to $log." >&2
    return 1
  fi
  echo "  ok ($name) — log: $log"
}

require_artifact() {
  local path="$1" type="$2"
  [ -n "$path" ] || { echo "error: $type produced no artifact this run; halting." >&2; exit 1; }
}

# Between each generative step, gap-sweep the artifact it produced: a fresh
# session sweeps for CRITICAL gaps only, fixes them in place, and continues.
# Not a quality gate — it never blocks; it improves the artifact and moves on.
# Sweeps target the explicit path captured below (in-place edits keep the path
# stable). validate/code-review are themselves review steps, so no sweep there.
run_skill sweep-frd "/gap-sweep $FRD frd" || exit 1

run_skill research "/research $FRD" || exit 1
RESEARCH="$(newest_since .rpiv/artifacts/research)"; require_artifact "$RESEARCH" research
run_skill sweep-research "/gap-sweep $RESEARCH research" || exit 1

run_skill design "/design $RESEARCH" || exit 1
DESIGN="$(newest_since .rpiv/artifacts/designs)"; require_artifact "$DESIGN" design
run_skill sweep-design "/gap-sweep $DESIGN design" || exit 1

run_skill plan "/plan $DESIGN" || exit 1
PLAN="$(newest_since .rpiv/artifacts/plans)"; require_artifact "$PLAN" plan
run_skill sweep-plan "/gap-sweep $PLAN plan" || exit 1

run_skill implement "/implement $PLAN" "$IMPLEMENT_TIMEOUT" || exit 1
run_skill sweep-code "/gap-sweep working code" "$IMPLEMENT_TIMEOUT" || exit 1

run_skill validate "/validate $PLAN" || exit 1
run_skill code-review "/code-review working" || exit 1
run_skill commit "/commit commit all changes on the current branch with a clear message; do NOT push and do NOT open a PR" || exit 1

echo
echo "done. pipeline complete on branch $BRANCH"
echo "review: git log --oneline -n 20 ; git show --stat"
