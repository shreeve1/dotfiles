        "浏览器控制尚未加载配置，无法确定清理目录": "Browser Control has not loaded its configuration, so the cleanup directory is unknown",
    },
}

changed = []
for path, replacements in files.items():
    if not path.exists():
        print(f"skip missing: {path}")
        continue
    text = path.read_text()
    updated = text
    for old, new in replacements.items():
        updated = updated.replace(old, new)
    if updated != text:
        path.write_text(updated)
        changed.append(str(path))

print(f"English patch applied; changed {len(changed)} file(s).")
for path in changed:
    print(path)
print("Reload the unpacked extension at chrome://extensions after extension files change.")
