#!/usr/bin/env python3
"""Synchronize skills whose source of truth is starter-agent."""

from __future__ import annotations

import argparse
import filecmp
import os
import shutil
from pathlib import Path


SKILLS = ("personal-memory", "memory-setup")


def parse_args() -> argparse.Namespace:
    parser = argparse.ArgumentParser()
    parser.add_argument(
        "--starter",
        type=lambda value: Path(value).expanduser(),
        default=Path.home() / "starter-agent",
    )
    parser.add_argument(
        "--dest",
        type=lambda value: Path(value).expanduser(),
        default=Path(__file__).resolve().parents[1],
    )
    return parser.parse_args()


def tree(root: Path, reject_symlinks: bool) -> dict[Path, str]:
    entries: dict[Path, str] = {}

    def visit(folder: Path, relative: Path = Path()) -> None:
        for entry in os.scandir(folder):
            if entry.name == "__pycache__":
                continue
            entry_relative = relative / entry.name
            if entry.is_symlink():
                if reject_symlinks:
                    raise ValueError(f"source symlink is not allowed: {entry.path}")
                entries[entry_relative] = "symlink"
            elif entry.is_dir(follow_symlinks=False):
                entries[entry_relative] = "dir"
                visit(Path(entry.path), entry_relative)
            else:
                entries[entry_relative] = "file"

    visit(root)
    return entries


def remove(path: Path) -> None:
    if path.is_symlink() or path.is_file():
        path.unlink()
    elif path.is_dir():
        shutil.rmtree(path)


def sync_skill(source: Path, destination: Path, dest_root: Path) -> list[str]:
    source_tree = tree(source, reject_symlinks=True)
    changes: list[str] = []
    if destination.is_symlink():
        remove(destination)
        changes.append(str(destination.relative_to(dest_root)))
    destination_tree = tree(destination, reject_symlinks=False) if destination.exists() else {}

    for relative in sorted(destination_tree, key=lambda path: (len(path.parts), path), reverse=True):
        path = destination / relative
        if relative not in source_tree or destination_tree[relative] != source_tree[relative]:
            remove(path)
            changes.append(str(path.relative_to(dest_root)))

    destination.mkdir(parents=True, exist_ok=True)
    for relative in sorted(source_tree, key=lambda path: (len(path.parts), path)):
        source_path = source / relative
        destination_path = destination / relative
        if source_tree[relative] == "dir":
            if not destination_path.exists():
                destination_path.mkdir()
                changes.append(str(destination_path.relative_to(dest_root)))
        elif (
            destination_tree.get(relative) != "file"
            or not filecmp.cmp(
            source_path, destination_path, shallow=False
            )
        ):
            shutil.copy2(source_path, destination_path)
            changes.append(str(destination_path.relative_to(dest_root)))

    return changes


def main() -> int:
    args = parse_args()
    source_root = args.starter / ".agents" / "skills"
    destination_root = args.dest / ".agents" / "skills"
    for skill in SKILLS:
        if not (source_root / skill / "SKILL.md").is_file():
            print(f"missing starter skill: {source_root / skill / 'SKILL.md'}")
            return 2
        try:
            tree(source_root / skill, reject_symlinks=True)
        except ValueError as error:
            print(error)
            return 2

    changes: list[str] = []
    for skill in SKILLS:
        changes.extend(
            sync_skill(source_root / skill, destination_root / skill, args.dest)
        )
    for path in changes:
        print(path)
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
