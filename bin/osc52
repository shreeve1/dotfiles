#!/usr/bin/env bash
# Copy stdin to clipboard via OSC 52 — works over SSH, through tmux, to Ghostty
data=$(cat)
encoded=$(printf '%s' "$data" | base64 | tr -d '\n')

if [ -n "$TMUX" ]; then
    # Wrap in DCS passthrough so tmux forwards to the outer terminal
    printf '\033Ptmux;\033\033]52;c;%s\007\033\\' "$encoded"
else
    printf '\033]52;c;%s\007' "$encoded"
fi
