#!/usr/bin/env python3
"""Convert AutoHotkey hotstrings into an espanso match file.

Usage: ahk2espanso [--no-word] [--out FILE] SOURCE.ahk

Expands on a word boundary, which matches AutoHotkey's ending-character rule:
no mid-word matches (wont inside wonton, pg1 shadowing pg10). --no-word expands
the instant the trigger is typed, which leaves a stray character behind.

Writes ~/.config/espanso/match/base.yml unless --out is given. Espanso watches
that file and reloads on save, so no restart is needed.

Handles ::trigger::replacement on one line and multi-line replacements:
    ::trig::
    (
    line one
    line two
    )

Skips comment lines, duplicate triggers (first wins) and mappings whose
replacement is identical to the trigger.
"""

import argparse
import json
import re
import sys
from pathlib import Path

DEFAULT_OUT = Path.home() / ".config/espanso/match/base.yml"


def parse_ahk(text):
    lines = text.splitlines()
    matches, comments = [], []
    seen, dupes, noops = set(), [], []
    i = 0
    while i < len(lines):
        line = lines[i].rstrip()
        if line.startswith(";"):
            label = line.lstrip(";").strip().strip(";").strip()
            if label and not label.startswith("-"):
                comments.append((len(matches), label))
            i += 1
            continue
        m = re.match(r"^::([^:]+)::(.*)$", line)
        if not m:
            i += 1
            continue
        trigger, replace = m.group(1), m.group(2)
        if replace == "" and i + 1 < len(lines) and lines[i + 1].strip() == "(":
            i += 2
            block = []
            while i < len(lines) and lines[i].strip() != ")":
                block.append(lines[i])
                i += 1
            replace = "\n".join(block)
        if replace == trigger:
            noops.append(trigger)
        elif trigger in seen:
            dupes.append(trigger)
        else:
            seen.add(trigger)
            matches.append((trigger, replace))
        i += 1
    return matches, comments, dupes, noops


def render(matches, comments, word):
    out = [
        "# Converted from AutoHotkey hotstrings by dotfiles/bin/ahk2espanso.",
        "# Edit and save; espanso reloads automatically.",
        "matches:",
    ]
    ci = 0
    for idx, (trigger, replace) in enumerate(matches):
        while ci < len(comments) and comments[ci][0] <= idx:
            out.append("")
            out.append("# " + comments[ci][1])
            ci += 1
        out.append("  - trigger: " + json.dumps(trigger, ensure_ascii=False))
        out.append("    replace: " + json.dumps(replace, ensure_ascii=False))
        if word:
            out.append("    word: true")
        if "\n" in replace:
            # Paste multi-line replacements whole: injected Enter keystrokes are
            # swallowed or turned into submits by browsers and rich-text fields.
            out.append("    force_clipboard: true")
    return "\n".join(out) + "\n"


def main():
    ap = argparse.ArgumentParser()
    ap.add_argument("source", type=Path)
    ap.add_argument("--out", type=Path, default=DEFAULT_OUT)
    ap.add_argument(
        "--no-word",
        action="store_true",
        help="expand the instant the trigger is typed; leaves a stray character in "
        "testing and fires inside longer words (wont in wonton, pg1 shadowing pg10)",
    )
    args = ap.parse_args()

    matches, comments, dupes, noops = parse_ahk(
        args.source.read_text(encoding="utf-8-sig")
    )
    if not matches:
        sys.exit(f"no hotstrings found in {args.source}")

    args.out.parent.mkdir(parents=True, exist_ok=True)
    args.out.write_text(render(matches, comments, not args.no_word), encoding="utf-8")
    print(f"wrote {len(matches)} matches to {args.out}")
    for label, items in (("duplicate", dupes), ("no-op", noops)):
        if items:
            print(f"skipped {len(items)} {label} triggers: {', '.join(sorted(set(items)))}")


if __name__ == "__main__":
    main()
