# Configure dsh-full-remote (id: reverse-proxy): authenticated TLS listener on
# the netbird IP, forwarding to the loopback dsh backend.
- id: reverse-proxy
  config:
    listenHost: __LISTEN_IP__
    listenPort: 3080
    backendHost: 127.0.0.1
    backendPort: 3080
    tlsCertFile: __HOME__/.dsh/dsh-tls.crt
    tlsKeyFile: __HOME__/.dsh/dsh-tls.key

# @changfenhuang/dsh-genui is excluded from dsh-startup-guard via
# ~/.dsh/dsh-startup-guard.json: the guard's static id-registration regex
# (guard-core.mjs ~line 602) uses ["'] and misses backtick template-literal ids
# like {id:`@changfenhuang/dsh-genui`}, a false positive. The bundle passes
# the guard's own vm load check. Exclude keeps it enabled; drop the exclude if
# the guard's regex is ever fixed to accept backticks.

# dsh-smart-restart (id: smart-restart) canary target overrides. The unit runs
# `node __HOME__/.npm-global/bin/dsh web ...`, so the plugin's ExecStart
# derivation (canary.js deriveExecStartParams) takes argv[0]=/usr/bin/node as
# the binary and finds no --profile (web is implicit), producing the "cannot
# derive dsh binary/profile for canary" skip. resolveExecTarget honors these
# explicit overrides first, so pin them. Verified: `dsh --profile web --patch
# <overlay> --dump-config` exits 0, while an empty profile fails with
# "--profile <name> is required". Drop these if the plugin learns to skip an
# interpreter arg (node/env) to find the real dsh script.
# dsh-smart-restart REMOVED from the reproducible manifest: it is a third-party
# plugin that ships no built lib/, so --ignore-scripts leaves no lib/index.js and
# the bundle crash-loops boot (Cannot find module .../dsh-smart-restart/lib/index.js).
# Re-add it (fork with committed lib/, then restore the bundle + this config) if
# you want canary-guarded restarts. systemd Restart=always already supervises the unit.

# dshmarket (id: dsh-market) allowRestart: false — ROOT CAUSE FIX for the
# recurring "tool call interrupted / outcome unknown" error. dshmarket's
# detectedSupervisor() (restart.js) only recognizes a supervisor when ppid===1,
# but this is a systemd *user* service whose ppid is the user manager (1075),
# not 1. So restartAllowed() wrongly returned true, and dshmarket did a detached
# self-relaunch on each restart request — which collided with the unit's
# Restart=always, producing a double restart that severed live agent turns
# (the source of the durably-unrecorded tool-call guard message). Setting
# allowRestart: false makes the supervisor (systemd) the sole restart owner, the
# documented behavior for a supervised deployment (restart.js:9). Verified:
# dsh-web ppid=1075 (systemd --user), INVOCATION_ID/JOURNAL_STREAM set.
- id: dsh-market
  config:
    allowRestart: false


# dsh-fusion (id: dsh-fusion) — allowlist + concurrency override.
#
# `allow` REPLACES the plugin's DEFAULT_ALLOW array (src/config.ts:13-43); it does
# not append. So this list restates the 20 defaults, adds the 13 `agent_teams_*`
# tools registered by @nanmicoder/dsh-agent-teams (verified against lib/tools.js
# in the installed 0.1.14 bundle), and adds 5 more: `ask_user_question`, `grep`,
# `glob`, `skill`, `smart_restart`. `grep` and `glob` are read-only — adding them
# does not weaken Fusion's no-mutation guarantee (`bash`, `edit`, `write` remain
# withheld) and removes the most common source of pointless delegation
# round-trips. `skill` and `smart_restart` were previously withheld by accident
# (they are needed by the orchestrator to load workflow skills and to safely
# restart the dsh service via the dsh-smart-restart plugin's resume-notice
# re-delivery). `ask_user_question` (from @deepseek-ai/dsh-tool-ask-user, mounted
# by dsh-base) lets the fused orchestrator put a decision back to the human
# instead of guessing or burning a turn on prose. It is safe under Fusion's
# no-mutation guarantee: it writes nothing. It is also the RIGHT layer for this
# tool — the tool itself rejects runtime-owned subagents with DELEGATED_CALLER
# (see its README "Known Limitations"), so a delegated child physically cannot
# ask; only the orchestrator can. Withholding it from the orchestrator therefore
# removed the capability from the whole session. Omitting a name
# here silently revokes that tool from the fused orchestrator.
#
# agent-teams registers NO tools/pre-execute listener, so Fusion remains the only
# enforcement layer; its MEMBER_DENIED_TOOLS filter applies solely to its own
# spawned members (lib/members.js:386), never to the host.
#
# maxConcurrentWorkers raised 3 -> 5: governs delegate_worker only. agent-teams
# members spawn via its own memberProvider and are NOT throttled by this cap.
- id: dsh-fusion
  config:
    maxConcurrentWorkers: 5
    # Unattended cron one-shots start UNFUSED. dsh-cron mints session ids as
    # `cron-<job>-<uuid>` (lib/service.js newCronSessionId), and a fused cron
    # agent has its own kanban_*/bash calls withheld from the orchestrator, so
    # every board tick would be denied. This equals the plugin's schema default
    # but is pinned here deliberately: the board ticks depend on it, and an
    # operator auditing this file should see the exemption rather than have to
    # infer it from plugin source. Set to [] to fuse cron sessions again.
    unfusedSessionPrefixes: ['cron-']
    allow:
      - read
      - ask_user_question
      - grep
      - glob
      - skill
      - smart_restart
      - delegate_planner
      - delegate_worker
      - delegate_reviewer
      - delegate_scout
      - subagent
      - subagent_fork
      - workflow
      - ralph
      - todo_write
      - create_goal
      - update_goal
      - get_goal
      - list_agents
      - send_message
      - interrupt_agent
      - job_output
      - job_list
      - peek_subagent
      - verify_subagent_models
      - agent_teams_create
      - agent_teams_approve
      - agent_teams_edit_plan
      - agent_teams_add_member
      - agent_teams_remove_member
      - agent_teams_create_task
      - agent_teams_reassign_task
      - agent_teams_claim_task
      - agent_teams_update_task
      - agent_teams_send_message
      - agent_teams_status
      - agent_teams_resume
      - agent_teams_delete
