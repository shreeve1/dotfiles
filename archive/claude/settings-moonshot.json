{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "command -v node >/dev/null 2>&1 && node \"$HOME/.claude/hooks/ponytail/ponytail-activate.js\" || exit 0",
            "timeout": 5,
            "statusMessage": "Loading ponytail mode..."
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "command -v node >/dev/null 2>&1 && node \"$HOME/.claude/hooks/ponytail/ponytail-mode-tracker.js\" || exit 0",
            "timeout": 5,
            "statusMessage": "Tracking ponytail mode..."
          }
        ]
      }
    ]
  },
  "env": {
    "ANTHROPIC_AUTH_TOKEN": "sk-kimi-2qgvm21johVuZ2L1cdk2FCCcOjP1eqBp4VMoMqe9btPT9dbeDN3G5sQ5tY7VP9I6",
    "ANTHROPIC_BASE_URL": "https://api.kimi.com/coding/",
    "API_TIMEOUT_MS": "600000",
    "ANTHROPIC_DEFAULT_HAIKU_MODEL": "kimi-k2",
    "ANTHROPIC_DEFAULT_SONNET_MODEL": "kimi-k2.5",
    "ANTHROPIC_DEFAULT_OPUS_MODEL": "kimi-k2.5-thinking",
    "CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC": "1",
    "CLAUDE_CODE_DISABLE_GIT_INSTRUCTIONS": "1",
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1"
  },
  "permissions": {
    "allow": [
      "Bash(/usr/bin/python3:*)",
      "Bash(ssh:*)",
      "Bash(ssh-keyscan:*)",
      "Bash(~/.ssh/known_hosts)",
      "Bash(cat:*)",
      "Bash(compgen:*)",
      "Bash(scp:*)",
      "Bash(curl:*)",
      "Bash(uv:*)",
      "Bash(find:*)",
      "Bash(mv:*)",
      "Bash(grep:*)",
      "Bash(npm:*)",
      "Bash(ls:*)",
      "Bash(cp:*)",
      "Bash(chmod:*)",
      "Bash(touch:*)",
      "Bash(mkdir:*)",
      "Bash(python3:~/.claude/hooks/*)",
      "Skill(issue-tracker)",
      "Task(*)",
      "mcp__chrome_devtools__navigate_page",
      "mcp__chrome_devtools__take_snapshot",
      "mcp__chrome_devtools__click",
      "mcp__chrome_devtools__fill",
      "mcp__chrome_devtools__take_screenshot",
      "mcp__chrome_devtools__close_page",
      "mcp__chrome_devtools__wait_for",
      "mcp__chrome_devtools__press_key",
      "mcp__chrome_devtools__hover",
      "mcp__chrome_devtools__list_pages",
      "mcp__chrome_devtools__navigate_page_history",
      "mcp__chrome_devtools__fill_form",
      "mcp__chrome_devtools__evaluate_script",
      "mcp__chrome_devtools__handle_dialog",
      "mcp__chrome_devtools__upload_file",
      "mcp__chrome_devtools__list_console_messages",
      "mcp__chrome_devtools__get_console_message",
      "mcp__chrome_devtools__list_network_requests",
      "mcp__chrome_devtools__get_network_request",
      "mcp__chrome_devtools__resize_page",
      "mcp__chrome_devtools__drag",
      "mcp__chrome_devtools__new_page",
      "mcp__chrome_devtools__select_page",
      "mcp__chrome_devtools__emulate",
      "mcp__chrome_devtools__performance_start_trace",
      "mcp__chrome_devtools__performance_stop_trace",
      "mcp__chrome_devtools__performance_analyze_insight",
      "Write",
      "Edit"
    ],
    "defaultMode": "bypassPermissions",
    "bypassPermissionMode": true
  },
  "model": "sonnet",
  "enabledPlugins": {
    "context7@claude-plugins-official": true,
    "pyright-lsp@claude-plugins-official": true,
    "frontend-design@claude-plugins-official": true,
    "accesslint@accesslint": true,
    "superpowers@superpowers-marketplace": true
  },
  "alwaysThinkingEnabled": true,
  "bypassPermissions": true
}
