[Unit]
Description=DeepSeek Harness web UI (loopback; dsh-full-remote exposes it)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=__NODE_BIN__ __DSH_BIN__ web --host 127.0.0.1 --port 3080 --no-open
Restart=always
RestartSec=3
Environment=NODE_ENV=production
Environment=PATH=__HOME__/.local/bin:__HOME__/.npm-global/bin:__HOME__/.dsh/profiles/web/node_modules/.bin:/usr/local/bin:/usr/bin:/bin
EnvironmentFile=%h/.dsh/dsh-web.env

[Install]
WantedBy=default.target