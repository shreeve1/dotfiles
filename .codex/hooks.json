{
  "hooks": {
    "PostToolUse": [
      {
        "hooks": [
          {
            "command": "atuin hook codex",
            "type": "command"
          }
        ],
        "matcher": "^Bash$"
      }
    ],
    "PostToolUseFailure": [
      {
        "hooks": [
          {
            "command": "atuin hook codex",
            "type": "command"
          }
        ],
        "matcher": "^Bash$"
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "command": "atuin hook codex",
            "type": "command"
          }
        ],
        "matcher": "^Bash$"
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$HOME/.agents/bin/verify-final\" --harness codex",
            "timeout": 150,
            "statusMessage": "Verifying final answer"
          }
        ]
      }
    ]
  }
}
