{
  "hooks": {
    "PostToolUse": [
      {
        "hooks": [
          {
            "command": "atuin hook codex",
            "type": "command"
          }
        ],
        "matcher": "^Bash$"
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "if [ -f \"$HOME/.orca/agent-hooks/codex-hook.sh\" ] && [ -r \"$HOME/.orca/agent-hooks/codex-hook.sh\" ] && [ -x \"$HOME/.orca/agent-hooks/codex-hook.sh\" ]; then /bin/sh \"$HOME/.orca/agent-hooks/codex-hook.sh\"; else cat >/dev/null 2>&1 || :; fi",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "hooks": [
          {
            "command": "atuin hook codex",
            "type": "command"
          }
        ],
        "matcher": "^Bash$"
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "command": "atuin hook codex",
            "type": "command"
          }
        ],
        "matcher": "^Bash$"
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "if [ -f \"$HOME/.orca/agent-hooks/codex-hook.sh\" ] && [ -r \"$HOME/.orca/agent-hooks/codex-hook.sh\" ] && [ -x \"$HOME/.orca/agent-hooks/codex-hook.sh\" ]; then /bin/sh \"$HOME/.orca/agent-hooks/codex-hook.sh\"; else cat >/dev/null 2>&1 || :; fi",
            "timeout": 10
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "command": "bash '/home/james/.codex/herdr-agent-state.sh' session",
            "timeout": 10,
            "type": "command"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "if [ -f \"$HOME/.orca/agent-hooks/codex-hook.sh\" ] && [ -r \"$HOME/.orca/agent-hooks/codex-hook.sh\" ] && [ -x \"$HOME/.orca/agent-hooks/codex-hook.sh\" ]; then /bin/sh \"$HOME/.orca/agent-hooks/codex-hook.sh\"; else cat >/dev/null 2>&1 || :; fi",
            "timeout": 10
          }
        ]
      }
    ],
    "UserPromptSubmit": [
