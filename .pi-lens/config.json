{
  "format": {
    "enabled": true,
    "mode": "immediate"
  },
  "rules": {
    "unchecked-throwing-call-python": {
      "disable": ["unchecked-throwing-call-python"]
    }
  },
  "actionableWarnings": {
    "enabled": true,
    "includeLspCodeActions": true,
    "deltaOnly": true,
    "autoFix": {
      "enabled": true,
      "maxFixes": 15
    }
  }
}
