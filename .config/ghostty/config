font-family = JetBrains Mono Nerd Font
# Persistent default: matches the zoom level James had settled on live.
font-size = 11
cursor-style = block
cursor-style-blink = false
mouse-hide-while-typing = true
copy-on-select = true
clipboard-write = allow
clipboard-read = allow
# Omarchy's Super+V sends Shift+Insert in terminals. Use the main clipboard
# instead of the often-stale Wayland PRIMARY selection.
keybind = shift+insert=paste_from_clipboard
window-padding-x = 8
window-padding-y = 6
unfocused-split-opacity = 0.94
split-divider-color = #cba6f7
theme = Catppuccin Mocha

keybind = ctrl+h=goto_split:left
keybind = ctrl+j=goto_split:down
keybind = ctrl+k=goto_split:up
keybind = ctrl+l=goto_split:right
gtk-single-instance = false
