#!/usr/bin/env bash
# Mock pi binary for unit tests.
# - If first arg is --version, prints "0.99.0" and exits 0.
# - Otherwise echoes argv to stderr (one arg per line, prefixed "ARG:")
#   and emits a fenced JSON PASS verdict to stdout.

if [ "$1" = "--version" ]; then
  echo "0.99.0"
  exit 0
fi

if [ "$1" = "--help" ]; then
  printf '%s\n' 'pi - mock AI coding assistant'
  printf '%s\n' '  --mode <mode>  Output mode: text (default), json, or rpc'
  exit 0
fi

for arg in "$@"; do
  printf 'ARG:%s\n' "$arg" >&2
done

# Drain stdin so callers using `input:` don't get EPIPE.
cat >/dev/null 2>&1 || true

cat <<'EOF'
I reviewed the diff against the ISA.

```json
{
  "phase": "VERIFY",
  "verdict": "PASS",
  "blockers": [],
  "suggestions": [],
  "summary_md": "Mock pi PASS verdict.",
  "raw_model_id": "mock/pass",
  "schema_version": 1,
  "generated_at": "2026-05-10T00:00:00.000Z"
}
```
EOF
