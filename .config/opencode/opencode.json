{
  "$schema": "https://opencode.ai/config.json",
  "small_model": "cliproxy/claude-haiku-4-5-20251001",
  "instructions": [
    "~/.pai/PAI/AISTEERINGRULES.md",
    "~/.pai/PAI/USER/AISTEERINGRULES.md"
  ],
  "mode": {
    "build": {
      "tools": {
        "write": true,
        "edit": true,
        "bash": true,
        "read": true,
        "grep": true,
        "glob": true,
        "patch": true,
        "todowrite": true,
        "webfetch": true
      },
      "permission": {
        "*": "allow"
      }
    },
    "plan": {
      "tools": {
        "write": false,
        "edit": false,
        "bash": false,
        "read": true,
        "grep": true,
        "glob": true,
        "webfetch": true
      },
      "permission": {
        "*": "allow"
      }
    }
  },
  "agent": {
    "build": {
      "permission": {
        "*": "allow"
      },
      "color": "error"
    },
    "plan": {
      "permission": {
        "*": "allow"
      }
    },
    "general": {
      "model": "cliproxy/claude-haiku-4-5-20251001",
      "permission": {
        "*": "allow"
      }
    },
    "compaction": {
      "model": "cliproxy/gpt-5.4",
      "permission": {
        "*": "allow"
      }
    },
    "librarian": {
      "model": "cliproxy/gpt-5.4",
      "permission": {
        "*": "allow"
      }
    },
    "explore": {
      "model": "cliproxy/claude-haiku-4-5-20251001",
      "permission": {
        "*": "allow"
      }
    },
    "document-writer": {
      "model": "cliproxy/claude-sonnet-4-6",
      "permission": {
        "*": "allow"
      }
    },
    "quick-review-opus": {
      "model": "cliproxy/claude-opus-4-7",
      "permission": {
        "*": "allow"
      }
    },
    "quick-review-codex": {
      "model": "cliproxy/gpt-5.3-codex",
      "permission": {
        "*": "allow"
      }
    },
    "infra-scout": {
      "model": "cliproxy/claude-haiku-4-5-20251001",
      "permission": {
        "*": "allow"
      }
    },
    "infra-planner": {
      "model": "cliproxy/claude-sonnet-4-6",
      "permission": {
        "*": "allow"
      }
    },
    "executor-ssh": {
      "model": "cliproxy/claude-sonnet-4-6",
      "permission": {
        "*": "allow"
      }
    },
    "executor-powershell": {
      "model": "cliproxy/claude-sonnet-4-6",
      "permission": {
        "*": "allow"
      }
    },
    "infra-validator": {
      "model": "cliproxy/claude-opus-4-7",
      "permission": {
        "*": "allow"
      }
    },
    "pai-algorithm": {
      "description": "PAI Algorithm agent — 7-phase problem solving with ISA and ISC criteria",
      "model": "cliproxy/claude-opus-4-7",
      "permission": {
        "*": "allow"
      }
    },
    "pai-engineer": {
      "description": "PAI Engineer — focused code implementation with TDD and surgical fixes",
      "model": "cliproxy/claude-sonnet-4-6",
      "permission": {
        "*": "allow"
      }
    },
    "pai-architect": {
      "description": "PAI Architect — read-only system design and planning",
      "model": "cliproxy/claude-opus-4-7",
      "permission": {
        "*": "allow"
      }
    }
  },
  "provider": {
    "cliproxy": {
      "npm": "@ai-sdk/anthropic",
      "name": "CLIProxy",
      "options": {
        "baseURL": "http://127.0.0.1:8317/v1",
        "apiKey": "{env:CLIPROXY_API_KEY}"
      },
      "models": {
        "claude-opus-4-7": {
          "name": "Claude Opus 4.7 (CLIProxy)",
          "attachment": true,
          "limit": {
            "context": 200000,
            "output": 16384
          }
        },
        "claude-sonnet-4-6": {
          "name": "Claude Sonnet 4.6 (CLIProxy)",
          "attachment": true,
          "limit": {
            "context": 200000,
            "output": 16384
          }
        },
        "claude-haiku-4-5-20251001": {
          "name": "Claude Haiku 4.5 (CLIProxy)",
          "attachment": true,
          "limit": {
            "context": 200000,
            "output": 8192
          }
        },
        "gpt-5.4": {
          "name": "GPT 5.4 (CLIProxy)",
          "limit": {
            "context": 128000,
            "output": 16384
          }
        },
        "gpt-5.4-mini": {
          "name": "GPT 5.4 Mini (CLIProxy)",
          "limit": {
            "context": 128000,
            "output": 16384
          }
        },
        "gpt-5.3-codex": {
          "name": "GPT 5.3 Codex (CLIProxy)",
          "limit": {
            "context": 192000,
            "output": 16384
          }
        },
        "gpt-5.3-codex-spark": {
          "name": "GPT 5.3 Codex Spark (CLIProxy)",
          "limit": {
            "context": 192000,
            "output": 16384
          }
        },
        "gpt-5.5": {
          "name": "GPT 5.5 (CLIProxy)",
          "limit": {
            "context": 128000,
            "output": 16384
          }
        }
      }
    }
  },
  "plugin": [
    "file://{env:HOME}/.config/opencode/plugins/terminal-bell",
    "file://{env:HOME}/.config/opencode/plugins/pai-mode-router",
    "file://{env:HOME}/.config/opencode/plugins/pai-checkpoint-per-isc",
    "file://{env:HOME}/.config/opencode/plugins/pai-isa-sync",
    "file://{env:HOME}/.config/opencode/plugins/pai-containment-guard",
    "file://{env:HOME}/.config/opencode/plugins/pai-config-audit",
    "file://{env:HOME}/.config/opencode/plugins/pai-reflection-loop",
    "file://{env:HOME}/.config/opencode/plugins/pai-pi-perspective"
  ],
  "permission": {
    "external_directory": "allow",
    "*": "allow"
  },
  "mcp": {
    "gitnexus": {
      "type": "local",
      "command": [
        "/home/james/.npm-global/bin/gitnexus",
        "mcp"
      ]
    },
    "aws-mcp": {
      "type": "local",
      "command": [
        "uvx",
        "mcp-proxy-for-aws@latest",
        "https://aws-mcp.us-east-1.api.aws/mcp",
        "--metadata",
        "AWS_REGION=us-west-2"
      ],
      "enabled": true
    }
  }
}
