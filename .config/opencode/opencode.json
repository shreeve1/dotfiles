    "executor-powershell": {
      "model": "cliproxy/claude-sonnet-4-6",
      "permission": {
        "*": "allow"
      }
    },
    "infra-validator": {
      "model": "cliproxy/claude-opus-4-7",
      "permission": {
        "*": "allow"
      }
    },
    "pai-algorithm": {
      "description": "PAI Algorithm agent — 7-phase problem solving with PRD and ISC criteria",
      "model": "cliproxy/claude-opus-4-7",
      "permission": {
        "*": "allow"
      }
    },
    "pai-engineer": {
      "description": "PAI Engineer — focused code implementation with TDD and surgical fixes",
      "model": "cliproxy/claude-sonnet-4-6",
      "permission": {
        "*": "allow"
      }
    },
    "pai-architect": {
      "description": "PAI Architect — read-only system design and planning",
      "model": "cliproxy/claude-opus-4-7",
      "permission": {
        "*": "allow"
      }
    }
  },
  "provider": {
    "cliproxy": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "CLIProxy",
      "options": {
        "baseURL": "http://127.0.0.1:8317/v1"
      },
      "models": {
        "claude-opus-4-7": {
          "name": "Claude Opus 4.7 (CLIProxy)",
          "attachment": true,
          "limit": {
            "context": 200000,
            "output": 16384
          }
        },
        "claude-sonnet-4-6": {
