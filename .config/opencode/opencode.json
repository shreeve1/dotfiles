{
  "$schema": "https://opencode.ai/config.json",
  "small_model": "cliproxy/claude-haiku-4-5-20251001",
  "agent": {
    "build": {
      "permission": {
        "*": "allow"
      },
      "color": "error"
    }
  },
  "plugin": [
    "file://{env:HOME}/.config/opencode/plugins/tokenjuice.js",
    "./plugins/caveman/plugin.js"
  ],
  "provider": {
    "cliproxy": {
      "npm": "@ai-sdk/anthropic",
      "name": "CLIProxy",
      "options": {
        "baseURL": "http://127.0.0.1:8317/v1",
        "apiKey": "{env:CLIPROXY_API_KEY}"
      },
      "models": {
        "claude-opus-4-7": {
          "name": "Claude Opus 4.7 (CLIProxy)",
          "attachment": true,
          "limit": {
            "context": 200000,
            "output": 16384
          }
        },
        "claude-sonnet-4-6": {
          "name": "Claude Sonnet 4.6 (CLIProxy)",
          "attachment": true,
          "limit": {
            "context": 200000,
            "output": 16384
          }
        },
        "claude-haiku-4-5-20251001": {
          "name": "Claude Haiku 4.5 (CLIProxy)",
          "attachment": true,
          "limit": {
            "context": 200000,
            "output": 8192
          }
        },
        "gpt-5.4": {
          "name": "GPT 5.4 (CLIProxy)",
          "limit": {
            "context": 128000,
            "output": 16384
          }
        },
        "gpt-5.4-mini": {
          "name": "GPT 5.4 Mini (CLIProxy)",
          "limit": {
            "context": 128000,
            "output": 16384
          }
        },
        "gpt-5.3-codex": {
          "name": "GPT 5.3 Codex (CLIProxy)",
          "limit": {
            "context": 192000,
            "output": 16384
          }
        },
        "gpt-5.3-codex-spark": {
          "name": "GPT 5.3 Codex Spark (CLIProxy)",
          "limit": {
            "context": 192000,
            "output": 16384
          }
        },
        "gpt-5.5": {
          "name": "GPT 5.5 (CLIProxy)",
          "limit": {
            "context": 128000,
            "output": 16384
          }
        }
      }
    }
  },
  "mcp": {
    "caveman-shrink": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "caveman-shrink"
      ],
      "enabled": true
    }
  }
}
