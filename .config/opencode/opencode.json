        "*": "allow"
      }
    },
    "document-writer": {
      "model": "cliproxy/claude-sonnet-4-6",
      "permission": {
        "*": "allow"
      }
    },
    "quick-review-opus": {
      "model": "cliproxy/claude-opus-4-7",
      "permission": {
        "*": "allow"
      }
    },
    "quick-review-codex": {
      "model": "cliproxy/gpt-5.3-codex",
      "permission": {
        "*": "allow"
