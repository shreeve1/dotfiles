{
  "$schema": "https://opencode.ai/config.json",
  "small_model": "cliproxy/claude-haiku-4-5-20251001",
  "instructions": [
    "~/.claude/PAI/AISTEERINGRULES.md",
    "~/.claude/PAI/USER/AISTEERINGRULES.md"
  ],
  "mode": {
    "build": {
      "tools": {
        "write": true,
        "edit": true,
        "bash": true,
        "read": true,
        "grep": true,
        "glob": true,
        "patch": true,
        "todowrite": true,
        "webfetch": true
      },
      "permission": {
        "*": "allow"
      }
    },
    "plan": {
      "model": "cliproxy/claude-opus-4-7",
      "tools": {
        "write": false,
        "edit": false,
        "bash": false,
        "read": true,
        "grep": true,
        "glob": true,
        "webfetch": true
      },
      "permission": {
        "*": "allow"
      }
    }
  },
  "agent": {
    "build": {
      "model": "openai/gpt-5.5",
      "permission": {
        "*": "allow"
      },
      "color": "error"
    },
    "plan": {
      "model": "cliproxy/claude-opus-4-7",
      "permission": {
        "*": "allow"
      }
    },
    "general": {
      "model": "cliproxy/claude-haiku-4-5-20251001",
      "permission": {
        "*": "allow"
      }
    },
    "compaction": {
      "model": "cliproxy/gpt-5.4",
      "permission": {
        "*": "allow"
      }
    },
    "librarian": {
      "model": "cliproxy/gpt-5.4",
      "permission": {
        "*": "allow"
      }
    },
    "explore": {
      "model": "cliproxy/claude-haiku-4-5-20251001",
