      "dark": "burnsDust",
      "light": "burnsDust"
    },
    "markdownImage": {
      "dark": "burnsDust",
      "light": "burnsDust"
    },
    "markdownImageText": {
      "dark": "burnsSelection",
      "light": "burnsSelection"
    },
    "markdownCodeBlock": {
      "dark": "burnsFg",
      "light": "burnsFg"
    },
    "syntaxComment": {
      "dark": "burnsBorder",
      "light": "burnsBorder"
    },
    "syntaxKeyword": {
      "dark": "burnsRed3",
      "light": "burnsRed3"
    },
    "syntaxFunction": {
      "dark": "burnsWhite",
      "light": "burnsWhite"
    },
    "syntaxVariable": {
      "dark": "burnsSelection",
      "light": "burnsSelection"
    },
    "syntaxString": {
      "dark": "burnsRose",
      "light": "burnsRose"
    },
    "syntaxNumber": {
      "dark": "burnsRed4",
      "light": "burnsRed4"
    },
    "syntaxType": {
      "dark": "burnsDust",
      "light": "burnsDust"
    },
    "syntaxOperator": {
      "dark": "burnsCursor",
      "light": "burnsCursor"
    },
    "syntaxPunctuation": {
      "dark": "burnsFg",
      "light": "burnsFg"
    },
    "inputBackground": {
      "dark": "burnsInset",
      "light": "burnsInset"
    },
    "InputBorder": {
      "dark": "burnsBorder",
      "light": "burnsBorder"
    },
    "InputBorderActive": {
      "dark": "burnsCursor",
      "light": "burnsCursor"
    },
    "inputPrompt": {
      "dark": "burnsCursor",
      "light": "burnsCursor"
    },
    "inputCursor": {
      "dark": "burnsCursor",
      "light": "burnsCursor"
    },
    "inputText": {
      "dark": "burnsFg",
      "light": "burnsFg"
    }
  }
