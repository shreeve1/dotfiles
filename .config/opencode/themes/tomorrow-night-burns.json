{
  "$schema": "https://opencode.ai/theme.json",
  "defs": {
    "burnsBg": "#151515",
    "burnsPanel": "#1b1b1b",
    "burnsElement": "#252525",
    "burnsInset": "#2a2d32",
    "burnsFg": "#d2dadd",
    "burnsSelection": "#b0bec5",
    "burnsSelectionText": "#2a2d32",
    "burnsBorder": "#8b999c",
    "burnsRed1": "#832e31",
    "burnsRed2": "#a63c40",
    "burnsRed3": "#d3494e",
    "burnsRed4": "#fc595f",
    "burnsRose": "#df9395",
    "burnsDust": "#ba8586",
    "burnsWhite": "#f5f5f5",
    "burnsCursor": "#ff443e"
  },
  "theme": {
    "primary": {
      "dark": "burnsRed4",
      "light": "burnsRed4"
    },
    "secondary": {
      "dark": "burnsRose",
      "light": "burnsRose"
    },
    "accent": {
      "dark": "burnsCursor",
      "light": "burnsCursor"
    },
    "error": {
      "dark": "burnsRed4",
      "light": "burnsRed4"
    },
    "warning": {
      "dark": "burnsRed3",
      "light": "burnsRed3"
    },
    "success": {
      "dark": "burnsDust",
      "light": "burnsDust"
    },
    "info": {
      "dark": "burnsSelection",
      "light": "burnsSelection"
    },
    "text": {
      "dark": "burnsFg",
      "light": "burnsFg"
    },
    "textMuted": {
      "dark": "burnsBorder",
      "light": "burnsBorder"
    },
    "background": {
      "dark": "burnsBg",
      "light": "burnsBg"
    },
    "backgroundPanel": {
      "dark": "burnsPanel",
      "light": "burnsPanel"
    },
    "backgroundElement": {
      "dark": "burnsElement",
      "light": "burnsElement"
    },
    "border": {
      "dark": "burnsBorder",
      "light": "burnsBorder"
    },
    "borderActive": {
      "dark": "burnsCursor",
      "light": "burnsCursor"
    },
    "borderSubtle": {
