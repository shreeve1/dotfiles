    "diffRemoved": {
      "dark": "burnsRed4",
      "light": "burnsRed4"
    },
    "diffContext": {
      "dark": "burnsBorder",
      "light": "burnsBorder"
    },
    "diffHunkHeader": {
      "dark": "burnsDust",
      "light": "burnsDust"
    },
    "diffHighlightAdded": {
      "dark": "burnsSelection",
      "light": "burnsSelection"
    },
    "diffHighlightRemoved": {
      "dark": "burnsRose",
      "light": "burnsRose"
    },
    "diffAddedBg": {
      "dark": "#241819",
      "light": "#241819"
    },
    "diffRemovedBg": {
      "dark": "#301516",
      "light": "#301516"
    },
    "diffContextBg": {
      "dark": "burnsInset",
      "light": "burnsInset"
    },
    "diffLineNumber": {
      "dark": "burnsBorder",
      "light": "burnsBorder"
    },
    "diffAddedLineNumberBg": {
      "dark": "#241819",
      "light": "#241819"
    },
    "diffRemovedLineNumberBg": {
      "dark": "#301516",
      "light": "#301516"
    },
    "markdownText": {
      "dark": "burnsFg",
      "light": "burnsFg"
    },
    "markdownHeading": {
      "dark": "burnsRed4",
      "light": "burnsRed4"
    },
    "markdownLink": {
      "dark": "burnsRose",
      "light": "burnsRose"
    },
    "markdownLinkText": {
      "dark": "burnsWhite",
      "light": "burnsWhite"
    },
    "markdownCode": {
      "dark": "burnsSelection",
      "light": "burnsSelection"
    },
    "markdownBlockQuote": {
      "dark": "burnsBorder",
      "light": "burnsBorder"
    },
    "markdownEmph": {
      "dark": "burnsRose",
      "light": "burnsRose"
    },
    "markdownStrong": {
      "dark": "burnsWhite",
      "light": "burnsWhite"
    },
    "markdownHorizontalRule": {
      "dark": "burnsElement",
      "light": "burnsElement"
