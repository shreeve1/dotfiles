# Pinned formatter/linter versions for the standard style contract. Sourced by
# bin/style-tools-install (run from install.sh) and bin/style-check --doctor.
# Every machine installs exactly these into ~/.local/bin, which sits ahead of
# /usr/bin on all three PATHs, so pi-lens's PATH lookup, style-check, the push
# hook and post-work-cleanup all run the same binary. Bump here, then re-run
# install.sh on aidev, omarchy and itan8n.
SHFMT_VERSION=3.13.1
SHELLCHECK_VERSION=0.11.0
RUFF_VERSION=0.16.6
BIOME_VERSION=2.5.15
MARKDOWNLINT_CLI2_VERSION=0.23.3
