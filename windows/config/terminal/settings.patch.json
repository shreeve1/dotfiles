{
  "copyOnSelect": true,
  "profiles": {
    "defaults": {
      "colorScheme": "Catppuccin Mocha",
      "font": { "face": "JetBrainsMono Nerd Font, JetBrainsMono NF", "size": 11 },
      "padding": "8, 6",
      "cursorShape": "filledBox",
      "unfocusedAppearance": { "opacity": 94 }
    }
  },
  "schemes": [
    {
      "name": "Catppuccin Mocha",
      "cursorColor": "#F5E0DC",
      "selectionBackground": "#585B70",
      "background": "#1E1E2E",
      "foreground": "#CDD6F4",
      "black": "#45475A",
      "red": "#F38BA8",
      "green": "#A6E3A1",
      "yellow": "#F9E2AF",
      "blue": "#89B4FA",
      "purple": "#F5C2E7",
      "cyan": "#94E2D5",
      "white": "#BAC2DE",
      "brightBlack": "#585B70",
      "brightRed": "#F38BA8",
      "brightGreen": "#A6E3A1",
      "brightYellow": "#F9E2AF",
      "brightBlue": "#89B4FA",
      "brightPurple": "#F5C2E7",
      "brightCyan": "#94E2D5",
      "brightWhite": "#A6ADC8"
    }
  ],
  "actions": [
    { "id": "User.focusLeft", "command": { "action": "moveFocus", "direction": "left" } },
    { "id": "User.focusDown", "command": { "action": "moveFocus", "direction": "down" } },
    { "id": "User.focusUp", "command": { "action": "moveFocus", "direction": "up" } },
    { "id": "User.focusRight", "command": { "action": "moveFocus", "direction": "right" } }
  ],
  "keybindings": [
    { "id": "User.focusLeft", "keys": "ctrl+h" },
    { "id": "User.focusDown", "keys": "ctrl+j" },
    { "id": "User.focusUp", "keys": "ctrl+k" },
    { "id": "User.focusRight", "keys": "ctrl+l" }
  ]
}
