# %USERPROFILE%\.wslconfig on an agent host. Read only when the WSL VM starts:
# run `wsl --shutdown` after changing it (setup-new-machine.md Phase 3).
[wsl2]
networkingMode=mirrored
vmIdleTimeout=86400000

[experimental]
# Lets Windows reach WSL listeners on the host's other IPs (e.g. the NetBird IP), not only 127.0.0.1.
hostAddressLoopback=true
