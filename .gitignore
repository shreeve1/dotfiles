# Machine-local plugin state — not synced across machines
artifacts/

# Machine-local secrets (not synced)
.config/nushell/secrets.nu
.zshrc.secrets

# Pi agent — secrets, dependencies, and runtime state
.pi/agent/auth.json
.pi/agent/node_modules/
.pi/agent/sessions/
.pi/agent/*-sessions*.json
.worktrees

# Claude Code — runtime state, dependencies, and machine-local files
.claude/settings.local.json
.claude/settings-*.json
.claude/**/node_modules/
.claude/**/__pycache__/
.claude/**/.DS_Store
