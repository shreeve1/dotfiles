# Personal (non-dotfiles) content — not synced
/personal/

# Machine-local git worktrees (ralph/tralph agent branches)
/worktrees/

# Machine-local scratch (non-dotfiles)
/baseten/

# Machine-local research output (transient per-machine scratch, never commit)
/research/

# Pi-lens runtime state/cache (nested per-machine install)
.pi/agent/.pi-lens/
.pi/agent/extensions/**/.pi-lens/
.autoagent-runs/
.symphony-runs/

# Workflow run artifacts (machine-local: workflow.json / transcripts.json /
# result.json / script.js per run, written under ~/.pi/agent/workflows/)
.pi/agent/workflows/

# gap-review extension output (completeness reviews written at turn end)
.gap-reviews/

# session-log extension output (per-session turn transcripts written at agent_settled)
.sessions/

# Pi subagent scratch dir (machine-local per-run artifacts)
.pi-subagents/

# Pi subagent run-history logs (machine-local runtime state)
.pi/agent/run-history.jsonl

# Pi model catalog cache — self-refreshing runtime state, never commit
.pi/agent/models-store.json

# Machine-local MCP tool-schema cache (regenerated on first use per machine)
.pi/agent/mcp-cache.json

# Codex config accumulates machine-local trust hashes; seeded from
# .codex/config.toml.template by install.sh
.codex/config.toml

# Test scratch (incl. vendored mattpocock/skills clone) — machine-local only
/tests/
.claude/.fusion-off
.claude/.harness-unlock
