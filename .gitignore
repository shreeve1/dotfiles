# Machine-local plugin state — not synced across machines
artifacts/
.config/opencode/bak/

# Machine-local session work logs (per-machine)
MEMORY/

# Machine-local kanban/runtime logs
.kanban/*.log

# Machine-local plan artifacts (per-machine)
Plans/
plans/

# Machine-local helper binaries (sync rralph; keep the rest machine-local)
bin/*
!bin/rralph

# Machine-local secrets (not synced)
.env
.env.*
.config/nushell/secrets.nu
.zshrc.secrets

# Pi agent — secrets, dependencies, and runtime state
.pi/agent/auth.json
.pi/agent/settings.json

# Pi-lens — runtime churn (keep only config.json synced)
.pi-lens/*
!.pi-lens/config.json
.pi/agent/bin/
.pi/agent/node_modules/
.pi/agent/**/node_modules/
.pi/agent/npm/
.pi/agent/sessions/
.pi/agent/*-sessions*.json
.pi/agent-sessions/

# Pi agent — machine-local generated experiments and external links
.pi/agent/**/experiments/
.pi/agent/agents/teams/homelab-company/experiments/
.pi/agent/agents/teams/homelab-company/agents/*.md
.pi/agent/agents/teams/homelab-company/experiments/snapshots/20260407-133417/agents/*.md
