# Machine-local plugin state — not synced across machines
artifacts/

# Machine-local session work logs (per-machine)
MEMORY/

# Machine-local secrets (not synced)
.env
.env.*
.config/nushell/secrets.nu
.zshrc.secrets

# Pi agent — secrets, dependencies, and runtime state
.pi/agent/auth.json
.pi/agent/bin/
.pi/agent/node_modules/
.pi/agent/sessions/
.pi/agent/*-sessions*.json
.worktrees

# Claude Code — secrets and machine-local files
.claude/settings.json
.claude/settings.local.json
.claude/settings-*.json

# Machine-local runtime state (not synced)
.claude/sessions/
.claude/session-env/
.claude/cache/
.claude/projects/
.claude/tasks/
.claude/Plans/
.claude/shell-snapshots/
.claude/file-history/
.claude/history.jsonl
.claude/backups/
.claude/plugins/
.claude/mcp-needs-auth-cache.json
.claude/policy-limits.json

# Machine-local MEMORY (session/work/state/learnings are per-machine)
.claude/MEMORY/STATE/
.claude/MEMORY/VOICE/
.claude/MEMORY/WORK/
.claude/MEMORY/LEARNING/

# PAI-Install (re-run installer on each device)
.claude/PAI-Install/

# gstack (third-party skill — install separately on each device)
.claude/skills/gstack/

# VoiceServer (machine-local)
.claude/VoiceServer/

# General
.claude/**/node_modules/
.claude/**/__pycache__/
.claude/**/.DS_Store
.claude/.claude/

# Codex — secrets and runtime state
.codex/auth.json
.codex/history.jsonl
.codex/logs_2.sqlite*
.codex/state_5.sqlite*
.codex/models_cache.json
.codex/version.json
.codex/installation_id
.codex/.personality_migration
.codex/cache/
.codex/log/
.codex/sessions/
.codex/shell_snapshots/
.codex/tmp/
.codex/.tmp/
.codex/memories/
.codex/skills/.system/

# Backup / temp files
*.bak
*.tmp
*.swp
*.swo
*~
.DS_Store
.claude.bak/
