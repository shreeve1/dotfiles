# Machine-local plugin state — not synced across machines
artifacts/

# Machine-local secrets (not synced)
.config/nushell/secrets.nu
.zshrc.secrets

# Pi agent — secrets, dependencies, and runtime state
.pi/agent/auth.json
.pi/agent/node_modules/
.pi/agent/sessions/
.pi/agent/*-sessions*.json
.worktrees

# Claude Code — secrets and machine-local files
.claude/settings.json
.claude/settings.local.json
.claude/settings-*.json

# Machine-local runtime state (not synced)
.claude/sessions/
.claude/session-env/
.claude/cache/
.claude/projects/
.claude/tasks/
.claude/Plans/
.claude/shell-snapshots/
.claude/file-history/
.claude/history.jsonl
.claude/backups/
.claude/plugins/
.claude/mcp-needs-auth-cache.json
.claude/policy-limits.json

# Machine-local MEMORY (session/work/state are per-machine)
.claude/MEMORY/STATE/
.claude/MEMORY/VOICE/
.claude/MEMORY/WORK/

# PAI-Install (re-run installer on each device)
.claude/PAI-Install/

# VoiceServer (machine-local)
.claude/VoiceServer/

# General
.claude/**/node_modules/
.claude/**/__pycache__/
.claude/**/.DS_Store
.claude/.claude/

# Backup / temp files
*.bak
*.tmp
*.swp
*.swo
*~
.DS_Store
.claude.bak/
