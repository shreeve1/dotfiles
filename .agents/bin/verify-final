#!/usr/bin/env python3
"""verify-final: end-of-turn grounding gate shared by Claude Code, Codex and omp.

Reads one Stop-hook event as JSON on stdin (Claude Code / Codex shape):
  {"last_assistant_message": str, "cwd": str, "stop_hook_active": bool}
Runs the independent read-only `pi -p` checker from
.agents/skills/_shared/verify-claims.md on the final answer.

Stdout (JSON, only when there is something to say):
  {"decision":"block","reason":...}   a claim is FALSE -> the agent must correct it
  {"systemMessage":...}               UNSURE claims, or the check could not run
Silent (exit 0, no output) when clean, skipped, or no checkable claims.

Skips: VERIFY_FINAL=0, answers under 200 chars, stop_hook_active (one correction
pass per turn). Never blocks when the check itself fails.

Warnings (never block): VERIFY_FINAL_WARN=all (default) shows UNSURE claims and
"check could not run"; =errors shows only "check could not run"; =none shows
neither. Hidden UNSURE lines still go to ~/.cache/verify-final.log. FALSE claims
always block, whatever the level.
"""
import json
import os
import re
import shutil
import subprocess
import sys
import tempfile
import time

MIN_CHARS = 200
INLINE_MAX_BYTES = 100_000  # one argv entry is capped near 128 KB; longer answers go via a file
MODEL = os.environ.get("VERIFY_FINAL_MODEL", "openrouter/deepseek/deepseek-v4.1-flash")
TIMEOUT = int(os.environ.get("VERIFY_FINAL_TIMEOUT", "120"))
WARN = os.environ.get("VERIFY_FINAL_WARN", "all").strip().lower()
LOG = os.path.expanduser("~/.cache/verify-final.log")

PROMPT = """You are an independent grounding reviewer. Below is the FINAL ANSWER an AI agent gave about work in this directory. Extract every checkable factual claim it makes about files, code, config, or system state (paths, symbols, behaviour, versions, what was changed). Ignore opinions, plans, questions, and claims about the conversation itself. Verify each claim by reading the actual files (read-only tools only). Do not speculate.

Only report claims whose truth can be established by reading files. SKIP, and write no line at all for, claims that need something you cannot do read-only: test or build results ("all tests pass"), command output, git history or staging state, other sessions' activity, live or runtime behaviour, whether the agent ran something, previous versions of a file, and other machines or hosts. Use UNSURE only when a file-checkable claim has ambiguous or missing evidence in the files.

Reply with one line per claim, nothing else:
VERIFIED | <file:line evidence> | <claim>
FALSE | <file:line evidence> | <claim> -- <one-line correction>
UNSURE | <why it could not be confirmed> | <claim>
If there is nothing to report (no checkable claims, or every claim was skipped), reply exactly: NO_CLAIMS. Never reply with an empty message.

FINAL ANSWER:
<<<
{answer}
>>>"""

VERDICT = re.compile(r"^\W*(VERIFIED|FALSE|UNSURE)\b\W*(.*)$", re.IGNORECASE)


def log(harness, status, secs, detail=""):
    try:
        os.makedirs(os.path.dirname(LOG), exist_ok=True)
        with open(LOG, "a") as f:
            f.write(f"{time.strftime('%Y-%m-%dT%H:%M:%S')} {harness} {status} {secs:.1f}s {detail}\n")
    except OSError:
        pass


def say(obj):
    print(json.dumps(obj))


def main():
    harness = sys.argv[sys.argv.index("--harness") + 1] if "--harness" in sys.argv else "unknown"
    if os.environ.get("VERIFY_FINAL") == "0" or os.environ.get("VERIFY_FINAL_RUNNING"):
        return
    try:
        ev = json.load(sys.stdin)
    except ValueError:
        return
    answer = (ev.get("last_assistant_message") or "").strip()
    if ev.get("stop_hook_active") or len(answer) < MIN_CHARS:
        return

    pi = shutil.which("pi") or os.path.expanduser("~/.local/bin/pi")
    spill = None
    if len(answer.encode()) <= INLINE_MAX_BYTES:
        body = answer
    else:
        fd, spill = tempfile.mkstemp(prefix="verify-final-", suffix=".txt")
        with os.fdopen(fd, "w") as f:
            f.write(answer)
        body = f"(The answer is too long to inline. Read the ENTIRE file {spill} and check every claim in it, through to the last line.)"
    t0 = time.time()
    cmd = [
        pi, "-p", "--no-session", "--no-skills", "--no-context-files",
        "--no-extensions", "--tools", "read,grep,find,ls", "--model", MODEL,
        PROMPT.format(answer=body),
    ]
    env = dict(os.environ, VERIFY_FINAL_RUNNING="1")
    try:
        r = subprocess.run(cmd, cwd=ev.get("cwd") or None, env=env, capture_output=True,
                           text=True, timeout=TIMEOUT, stdin=subprocess.DEVNULL)
        out, err, rc = r.stdout, r.stderr, r.returncode
    except subprocess.TimeoutExpired:
        out, err, rc = "", f"timed out after {TIMEOUT}s", 124
    except OSError as e:
        out, err, rc = "", str(e), 127
    finally:
        if spill:
            os.unlink(spill)
    secs = time.time() - t0

    verdicts = [VERDICT.match(l) for l in out.splitlines()]
    verdicts = [(m.group(1).upper(), l) for m, l in zip(verdicts, out.splitlines()) if m]
    if rc == 0 and not verdicts and "NO_CLAIMS" in out:
        log(harness, "no_claims", secs)
        return
    if rc != 0 or not verdicts:
        why = (err.strip().splitlines() or ["no verdict lines in checker output"])[-1][:200]
        log(harness, "error", secs, why)
        if WARN != "none":
            say({"systemMessage": f"verify-final: check could not run ({why}); the final answer was not independently verified."})
        return

    false = [l.strip() for v, l in verdicts if v == "FALSE"]
    unsure = [l.strip() for v, l in verdicts if v == "UNSURE"]
    log(harness, "ok", secs, f"false={len(false)} unsure={len(unsure)} verified={len(verdicts) - len(false) - len(unsure)}")
    out_obj = {}
    if unsure and WARN == "all":
        out_obj["systemMessage"] = "verify-final UNSURE (not blocking):\n" + "\n".join(unsure)
    elif unsure:
        log(harness, "unsure_hidden", secs, " || ".join(unsure)[:1500])
    if false:
        out_obj["decision"] = "block"
        out_obj["reason"] = (
            "An independent fact-check of your final answer found claims that do not match the files:\n"
            + "\n".join(false)
            + "\nRe-ground on that evidence, correct these claims, then give the corrected final answer "
            "and say in one line what you changed."
        )
    if out_obj:
        say(out_obj)


if __name__ == "__main__":
    main()
