#!/usr/bin/env python3
"""verify-final: end-of-turn grounding gate shared by Claude Code, Codex, omp and OpenCode.

Reads one Stop-hook event as JSON on stdin (Claude Code / Codex shape):
  {"last_assistant_message": str, "cwd": str, "stop_hook_active": bool}
Runs the independent read-only `pi -p` checker from
.agents/skills/_shared/verify-claims.md on the final answer.

Stdout (JSON, only when there is something to say):
  {"decision":"block","reason":...}   a claim is FALSE -> the agent must correct it
  {"systemMessage":...}               UNSURE claims, or the check could not run
Silent (exit 0, no output) when clean, skipped, or no checkable claims.

Skips: VERIFY_FINAL=0, answers under 500 chars, stop_hook_active (one correction
pass per turn), and an answer already found clean in the same directory within
CACHE_HOURS (logged as "cached"). Never blocks when the check itself fails.

Grill ledger mode: the checker also reads the grill's ledger and holds every
recommendation against it: FALSE when one breaks a ledger line, UNGROUNDED when
one rests on a system capability the ledger does not establish. UNGROUNDED
findings steer the agent (same channel as FALSE) to research and record the
capability. The ledger is the one the answer names (a .kanban/grilling/<name>.md
path that exists under cwd; the grilling skill ends every turn with it). With no
named ledger, an answer in the grilling question format ("❓" or "➡️") falls back
to the newest ledger modified within VERIFY_FINAL_LEDGER_HOURS (default 24).
Ledger mode ignores the 500-char minimum. VERIFY_FINAL_LEDGER=0 turns it off.

--check FILE (FILE or - for stdin): manual run for harnesses without the hook
(see _shared/verify-claims.md). Checks FILE's text from the current directory
and prints the findings as plain text, or "verify-final: no findings". The log
names the harness "manual" unless --harness NAME is also given (the pi
extension passes --harness pi).

Checker model: VERIFY_FINAL_MODEL (default cliproxy/glm-5.3-flash) at thinking level
VERIFY_FINAL_THINKING (default low; any pi --thinking level).

Warnings (never block): VERIFY_FINAL_WARN=errors (default) shows only "check
could not run"; =all also shows UNSURE claims; =none shows neither. Hidden
UNSURE lines still go to ~/.cache/verify-final.log. FALSE claims always block,
whatever the level.

--done FILE (FILE or - for stdin): completion check. FILE is JSON
{"requests": [earlier..., latest], "answer": str}. The checker reads the request
and the final answer, opens files where the answer claims a change, and prints
"MISSING |" lines for what was asked but not done, with an instruction for the
agent, or "verify-final: work done". The model answers DONE or MISSING for each part
of the request. Same model, thinking, minimum length, cache
and log (statuses done_*) as --check. The pi extension runs it on turns that
edited, wrote or ran a command. VERIFY_DONE=0 turns it off there.

--recommend FILE (FILE or - for stdin): recommendation check. Same JSON input as
--done. The checker lists each recommendation in the answer, then grounds it in
local memory and docs, official docs (web) and, for a build recommendation,
existing open-source projects. It prints sourced "IMPOSSIBLE |", "WRONG |" or
"EXISTS |" lines with an instruction for the agent, "verify-final:
recommendations hold", or "verify-final: no recommendations". Web search comes
from the rpiv-web-tools extension with WEB_SEARCH_PROVIDER=exa, only where
~/.pi/agent/extensions/rpiv-web-tools exists; elsewhere it uses local sources.
Timeout VERIFY_RECOMMEND_TIMEOUT (default 300 s); log statuses rec_*.
VERIFY_RECOMMEND=0 turns it off.

--rewake (Claude Code `asyncRewake` hook): a FALSE finding is written to stderr and the
script exits 2, which wakes Claude in the background with the findings as a system
reminder. Claude sends stop_hook_active=true on the Stop that follows that wake (and
false on a fresh user turn), so the correction pass is skipped by that flag alone.
"""
import hashlib
import json
import os
import re
import shutil
import subprocess
import sys
import tempfile
import time

MIN_CHARS = 500
# A clean verdict is reused for the same answer, directory and ledger for this long:
# some callers re-send one long answer many times.
CACHE_HOURS = 24
INLINE_MAX_BYTES = 100_000  # longer answers go via a file the checker reads with its tools
MODEL = os.environ.get("VERIFY_FINAL_MODEL", "cliproxy/glm-5.3-flash")
THINKING = os.environ.get("VERIFY_FINAL_THINKING", "low").strip().lower()
TIMEOUT = int(os.environ.get("VERIFY_FINAL_TIMEOUT", "120"))
REC_TIMEOUT = int(os.environ.get("VERIFY_RECOMMEND_TIMEOUT", "300"))
WEB_TOOLS_EXT = os.path.expanduser("~/.pi/agent/extensions/rpiv-web-tools")
WARN = os.environ.get("VERIFY_FINAL_WARN", "errors").strip().lower()
LOG = os.path.expanduser("~/.cache/verify-final.log")
STATE = os.path.expanduser("~/.cache/verify-final")
LEDGER_DIR = os.path.join(".kanban", "grilling")
LEDGER_HOURS = float(os.environ.get("VERIFY_FINAL_LEDGER_HOURS", "24"))
GRILL_MARKERS = ("❓", "➡️")

PROMPT = """You are an independent grounding reviewer. Below is the FINAL ANSWER an AI agent gave about work in this directory. Extract every checkable factual claim it makes about files, code, config, or system state (paths, symbols, behaviour, versions, what was changed). Ignore opinions, plans, questions, and claims about the conversation itself. Verify each claim by reading the actual files (read-only tools only). Do not speculate.

Only report claims whose truth can be established by reading files. SKIP, and write no line at all for, claims that need something you cannot do read-only: test or build results ("all tests pass"), command output, git history or staging state, other sessions' activity, live or runtime behaviour, whether the agent ran something, previous versions of a file, and other machines or hosts. Use UNSURE only when a file-checkable claim has ambiguous or missing evidence in the files.

Reply with one line per claim, nothing else:
VERIFIED | <file:line evidence> | <claim>
FALSE | <file:line evidence> | <claim> -- <one-line correction>
UNSURE | <why it could not be confirmed> | <claim>
If there is nothing to report (no checkable claims, or every claim was skipped), reply exactly: NO_CLAIMS. Never reply with an empty message.
{ledger}
FINAL ANSWER:
<<<
{answer}
>>>"""

DONE_PROMPT = """You are an independent completion reviewer. Below is what the user asked an AI agent to do, and the FINAL ANSWER the agent gave when it stopped. Decide whether the agent finished what the user asked, working in this directory. Where the answer says something was changed, read the files (read-only tools only) to see whether the change is really there.

Judge only what the user asked for in the LATEST REQUEST; earlier requests are context for what it refers to. A part counts as missing when the user asked for it and the answer neither shows it done nor openly says it was not done and why. A question back to the user, a stated blocker, or the user's own instruction to wait counts as openly saying. Do not ask for extra work, improvements, tests or polish the user did not ask for. Do not report things only running a command could confirm (tests, pushes, deploys, services, other machines) unless the answer itself shows they were not done.

First split the latest request into each separate thing it asks for (\"change X, and also update Y, and add Z\" is three parts). Then reply with one line per part, in the order asked, nothing else:
DONE | <evidence: file:line, or the answer's own words> | <the part>
MISSING | <evidence: what is absent from the answer and files> | <the part> -- <what is not done>
A part the answer never mentions is MISSING unless the files show it done. Never reply with an empty message.

EARLIER REQUESTS (context only):
<<<
{earlier}
>>>

LATEST REQUEST:
<<<
{request}
>>>

FINAL ANSWER:
<<<
{answer}
>>>"""

DONE_INSTRUCTION = (
    "\nFinish each part now if the user asked for it. Do not do anything the user did not ask for, and do "
    "not take an irreversible step (pushing, deleting data, changing a live system) the user has not "
    "approved; ask instead. Then write your final answer again as a complete, standalone message: the user "
    "reads only that message. Open it with one line per part, in the form \"Missing: <what was not done>; "
    "<now done, or why it still is not>.\" If your re-check shows a part was already done, open with "
    "\"Checked: <the part> was done; <your evidence>.\" instead. Then give the rest of the answer. Do not "
    "address the checker."
)

LEDGER_PROMPT = """
This answer is a turn of a grilling session. The system it is grilling inside (decisions settled, documented capabilities and limits, observed facts) is recorded in the ledger: {path}. Read the ledger in full first. Then, besides factual claims, check every recommendation, proposed option, and suggested approach in the answer (including lines starting with ➡️) against the ledger, and report each one that fails:
FALSE | <ledger line it breaks> | <recommendation> -- <what the ledger says instead>
  when it contradicts a ledger line and the answer does not openly put that conflict to the user as a question.
UNGROUNDED | <the capability it depends on> | <recommendation> -- <what to research>
  when it depends on something the system must be able to do or have (a product feature, an API behaviour, a platform or plan limit, a tool, a machine resource) that the ledger does not establish and the answer does not mark as unknown. Judge only whether the ledger establishes it, not whether it is true in the world. Flag only capabilities specific to this system that could plausibly be missing, limited, or plan-gated (a vendor feature, an endpoint's filters, a quota); skip commodity ground any such system has (a Linux server can run a scheduled job, a REST list endpoint pages, a database can store rows).
Recommendations are not factual claims: give a recommendation a line only when it is FALSE or UNGROUNDED as defined here, never VERIFIED or UNSURE. Design choices the ledger leaves open (a schema, a name, a structure) are the grill's to make and get no line.
"""

VERDICT = re.compile(r"^\W*(VERIFIED|FALSE|UNSURE|UNGROUNDED)\b\W*(.*)$", re.IGNORECASE)


LEDGER_REF = re.compile(r"\.kanban/grilling/([\w.-]+\.md)")


def active_ledger(cwd, answer):
    """(ledger, missing): this grill turn's ledger relative to cwd ("" when not in ledger
    mode), and the named ledger path that does not exist ("" when none).

    The ledger the answer names wins (last mention that exists). A named ledger that is
    missing (a typo) never falls back to another grill's ledger. With no ledger named, a
    grill-format answer falls back to the single newest ledger touched within LEDGER_HOURS.
    """
    if os.environ.get("VERIFY_FINAL_LEDGER") == "0":
        return "", ""
    root = cwd or os.getcwd()
    named = LEDGER_REF.findall(answer)
    for name in reversed(named):
        rel = os.path.join(LEDGER_DIR, name)
        if os.path.isfile(os.path.join(root, rel)):
            return rel, ""
    if named:
        return "", os.path.join(LEDGER_DIR, named[-1])
    if not any(m in answer for m in GRILL_MARKERS):
        return "", ""
    cutoff = time.time() - LEDGER_HOURS * 3600
    try:
        names = os.listdir(os.path.join(root, LEDGER_DIR))
    except OSError:
        return "", ""
    newest = (cutoff, "")
    for n in names:
        rel = os.path.join(LEDGER_DIR, n)
        try:
            mtime = os.path.getmtime(os.path.join(root, rel))
        except OSError:
            continue
        if n.endswith(".md") and mtime >= newest[0]:
            newest = (mtime, rel)
    return newest[1], ""


SID = ""
ANSWER_LEN = 0


def log(harness, status, secs, detail=""):
    try:
        os.makedirs(os.path.dirname(LOG), exist_ok=True)
        ident = f"sid={SID} len={ANSWER_LEN}" if SID else f"len={ANSWER_LEN}"
        with open(LOG, "a") as f:
            f.write(f"{time.strftime('%Y-%m-%dT%H:%M:%S')} {harness} {status} {secs:.1f}s {detail} {ident}\n")
    except OSError:
        pass


def cache_path(cwd, answer, ledger_path, kind="claims"):
    """The clean-verdict marker for this answer, directory, ledger state and kind of check."""
    ledger_stamp = ""
    if ledger_path:
        try:
            ledger_stamp = str(os.path.getmtime(os.path.join(cwd or ".", ledger_path)))
        except OSError:
            pass
    key = "\0".join([kind, os.path.realpath(cwd or "."), ledger_path, ledger_stamp, MODEL, answer])
    return os.path.join(STATE, "clean-" + hashlib.sha256(key.encode()).hexdigest()[:32])


def cached_clean(path):
    try:
        return time.time() - os.path.getmtime(path) < CACHE_HOURS * 3600
    except OSError:
        return False


def remember_clean(path):
    # ponytail: a clean verdict is reused even if the files change within CACHE_HOURS; key on
    # file state if a re-sent answer ever needs re-checking against edited files.
    try:
        os.makedirs(STATE, exist_ok=True)
        cutoff = time.time() - CACHE_HOURS * 3600
        for name in os.listdir(STATE):
            old = os.path.join(STATE, name)
            if name.startswith("clean-") and os.path.getmtime(old) < cutoff:
                os.unlink(old)
        with open(path, "w"):
            pass
    except OSError:
        pass


def run_checker(template, cwd, answer, tools="read,grep,find,ls", extensions=(), env_extra=None,
                timeout=None, **fields):
    """Run the read-only checker model on template; (stdout, stderr, returncode, seconds)."""
    pi = shutil.which("pi") or os.path.expanduser("~/.local/bin/pi")
    spill = None
    if len(answer.encode()) <= INLINE_MAX_BYTES:
        body = answer
    else:
        fd, spill = tempfile.mkstemp(prefix="verify-final-", suffix=".txt")
        with os.fdopen(fd, "w") as f:
            f.write(answer)
        body = f"(The answer is too long to inline. Read the ENTIRE file {spill} and check all of it, through to the last line.)"
    t0 = time.time()
    cmd = [
        pi, "-p", "--no-session", "--no-skills", "--no-context-files",
        "--no-extensions", "--tools", tools, "--model", MODEL, "--thinking", THINKING,
    ]
    for ext in extensions:
        cmd += ["-e", ext]
    env = dict(os.environ, VERIFY_FINAL_RUNNING="1", **(env_extra or {}))
    timeout = timeout or TIMEOUT
    try:
        # The prompt goes on stdin, not argv: on Windows `pi` is a .cmd shim, and cmd.exe
        # cuts an argument at its first newline, so the checker never saw the answer.
        r = subprocess.run(cmd, cwd=cwd or None, env=env, capture_output=True,
                           text=True, encoding="utf-8", errors="replace", timeout=timeout,
                           input=template.format(answer=body, **fields))
        out, err, rc = r.stdout, r.stderr, r.returncode
    except subprocess.TimeoutExpired:
        out, err, rc = "", f"timed out after {timeout}s", 124
    except OSError as e:
        out, err, rc = "", str(e), 127
    finally:
        if spill:
            os.unlink(spill)
    return out, err, rc, time.time() - t0


MISSING_LINE = re.compile(r"^\W*MISSING\b", re.IGNORECASE)
DONE_LINE = re.compile(r"^\W*DONE\b", re.IGNORECASE)


def normalized_verdicts(output):
    verdicts = []
    for line in output.splitlines():
        match = VERDICT.match(line)
        if match:
            value = match.group(1).upper()
            verdicts.append((value, f"{value} | {match.group(2).strip()}"))
    return verdicts


def done_main(harness):
    """--done: did the agent finish what the user asked? Prints the instruction or "work done"."""
    global ANSWER_LEN
    src = sys.argv[sys.argv.index("--done") + 1]
    try:
        with (sys.stdin if src == "-" else open(src, encoding="utf-8")) as f:
            ev = json.load(f)
    except (ValueError, OSError, IndexError) as e:
        sys.exit(f"verify-final: cannot read --done input ({e})")
    requests = [str(r).strip() for r in ev.get("requests") or [] if str(r).strip()]
    answer = str(ev.get("answer") or "").strip()
    ANSWER_LEN = len(answer)
    if not requests or len(answer) < MIN_CHARS:
        log(harness, "done_skip_short", 0.0)
        print("verify-final: work done (nothing to check)")
        return
    cwd = os.getcwd()
    marker = cache_path(cwd, "\0".join(requests + [answer]), "", kind="done")
    if cached_clean(marker):
        log(harness, "done_cached", 0.0)
        print("verify-final: work done (same answer found done earlier)")
        return
    earlier = "\n---\n".join(requests[:-1]) or "(none)"
    out, err, rc, secs = run_checker(DONE_PROMPT, cwd, answer, earlier=earlier, request=requests[-1])
    missing = [l.strip() for l in out.splitlines() if MISSING_LINE.match(l)]
    if rc == 0 and not missing and any(DONE_LINE.match(l) for l in out.splitlines()):
        log(harness, "done_clean", secs)
        remember_clean(marker)
        print("verify-final: work done")
        return
    if rc != 0 or not missing:
        why = (err.strip().splitlines() or ["no MISSING or DONE line in checker output"])[-1][:200]
        log(harness, "done_error", secs, why)
        print(f"verify-final: completion check could not run ({why})")
        return
    log(harness, "done_missing", secs, f"missing={len(missing)}")
    print("An independent check of whether the work is finished found parts of the request that are not done:\n"
          + "\n".join(missing) + DONE_INSTRUCTION)


REC_PROMPT = """You are an independent architecture reviewer. Below is what the user asked an AI agent, and the FINAL ANSWER the agent gave. Check the recommendations in it, working in this directory. Read-only: never run, install or change anything.

Step 1. List every recommendation in the answer: an approach, architecture, tool or product choice, or something to build (a script, service, timer, hook, plugin, layer). Explanations of what was done, facts, and questions to the user are not recommendations. If there is none, reply exactly: NO_RECOMMENDATIONS

Step 2. For each one, name the system it has to work inside (the harness, framework, product or platform), from the answer and the request.

Step 3. Ground each recommendation and the premises it rests on, in this order:
  a. Local sources first: memory/, docs/, AGENTS.md and README files under this directory, and local documentation for the system (for pi, its docs folder under the pi-coding-agent package).
  b. Then the system's official documentation.
  c. Only for a recommendation to build something: search for an existing, popular open-source project that already does it (many stars for its niche and a commit in the last 12 months, as shown on its repository page).
{web}

Report only problems, one line each, nothing else:
IMPOSSIBLE | <source URL or file:line> | <recommendation> -- <what the system cannot do>
WRONG | <source URL or file:line> | <premise> -- <what the source says instead>
EXISTS | <source URL> | <recommendation> -- <what already covers it>
Every line needs a source you actually read. A recommendation you could not ground gets no line; never report a guess. Design choices the sources leave open (names, structure, style) and suggestions for extra work get no line. If the recommendations hold, reply exactly: NO_FINDINGS. Never reply with an empty message.

EARLIER REQUESTS (context only):
<<<
{earlier}
>>>

LATEST REQUEST:
<<<
{request}
>>>

FINAL ANSWER:
<<<
{answer}
>>>"""

REC_WEB = ("Use web_search and web_fetch for b and c: at most 3 web_search calls and at most 3 web_fetch calls "
           "for the whole answer. Prefer official documentation and repository pages over blogs and forums.")
REC_NO_WEB = "Web search is not available on this machine; use local sources only."
REC_HEADER = "An independent check of the recommendations in an earlier answer found problems:"
REC_INSTRUCTION = (
    "\nThis concerns an earlier answer, which may not be the work in progress now. Re-read the source on each "
    "line. Then restate that advice as a complete, standalone message: the user reads only that message. "
    "Open it with one line per finding, in the form \"Revised: <recommendation>; <what changed and why>.\" If "
    "the source does not support the finding, open with \"Kept: <recommendation>; <why the finding does not "
    "apply>.\" instead. Do not start other work, and do not take an irreversible step the user has not "
    "approved. Do not address the checker."
)
# The verdict word must be followed by its pipe, so prose that starts with "Impossible"
# or "Wrong" is not a verdict line.
REC_LINE = re.compile(r"^\W*(IMPOSSIBLE|WRONG|EXISTS)\s*\|(.*)$", re.IGNORECASE)


def rec_findings(output):
    """Sourced verdict lines as "VERDICT | source | rest", and how many were dropped for no source."""
    kept, dropped = [], 0
    for line in output.splitlines():
        match = REC_LINE.match(line)
        if not match:
            continue
        fields = match.group(2).split("|", 1)
        if len(fields) < 2 or not fields[0].strip():
            dropped += 1
            continue
        kept.append(f"{match.group(1).upper()} | {fields[0].strip()} | {fields[1].strip()}")
    return kept, dropped


def recommend_main(harness):
    """--recommend: do the answer's recommendations hold against docs and existing projects?"""
    global ANSWER_LEN
    src = sys.argv[sys.argv.index("--recommend") + 1]
    try:
        with (sys.stdin if src == "-" else open(src, encoding="utf-8")) as f:
            ev = json.load(f)
    except (ValueError, OSError, IndexError) as e:
        sys.exit(f"verify-final: cannot read --recommend input ({e})")
    if os.environ.get("VERIFY_RECOMMEND") == "0":
        print("verify-final: recommendation check off")
        return
    requests = [str(r).strip() for r in ev.get("requests") or [] if str(r).strip()]
    answer = str(ev.get("answer") or "").strip()
    ANSWER_LEN = len(answer)
    if len(answer) < MIN_CHARS:
        log(harness, "rec_skip_short", 0.0)
        print("verify-final: no recommendations (nothing to check)")
        return
    cwd = os.getcwd()
    marker = cache_path(cwd, "\0".join(requests + [answer]), "", kind="recommend")
    if cached_clean(marker):
        log(harness, "rec_cached", 0.0)
        print("verify-final: recommendations hold (same answer found clean earlier)")
        return
    web = os.path.isdir(WEB_TOOLS_EXT)
    out, err, rc, secs = run_checker(
        REC_PROMPT, cwd, answer,
        tools="read,grep,find,ls,web_search,web_fetch" if web else "read,grep,find,ls",
        extensions=(WEB_TOOLS_EXT,) if web else (),
        env_extra={"WEB_SEARCH_PROVIDER": "exa"} if web else None,
        timeout=REC_TIMEOUT,
        earlier="\n---\n".join(requests[:-1]) or "(none)",
        request=requests[-1] if requests else "(none)",
        web=REC_WEB if web else REC_NO_WEB,
    )
    kept, dropped = rec_findings(out)
    counts = {v: sum(1 for l in kept if l.startswith(v + " ")) for v in ("IMPOSSIBLE", "WRONG", "EXISTS")}
    detail = " ".join(f"{v.lower()}={n}" for v, n in counts.items()) + f" dropped={dropped} web={int(web)}"
    if rc == 0 and kept:
        log(harness, "rec_found", secs, detail)
        print(REC_HEADER + "\n" + "\n".join(kept) + REC_INSTRUCTION)
        return
    if rc == 0 and "NO_RECOMMENDATIONS" in out and not dropped:
        log(harness, "rec_none", secs, detail)
        remember_clean(marker)
        print("verify-final: no recommendations")
        return
    if rc == 0 and (dropped or "NO_FINDINGS" in out):
        log(harness, "rec_clean", secs, detail)
        remember_clean(marker)
        print("verify-final: recommendations hold")
        return
    why = (err.strip().splitlines() or ["no verdict line in checker output"])[-1][:200]
    log(harness, "rec_error", secs, f"{why} web={int(web)}")
    print(f"verify-final: recommendation check could not run ({why})")

MANUAL = False
WARNINGS = []  # non-blocking notes merged into the single output object
EMITTED = False


def say(obj):
    """Print the hook's one output object (or plain text for --check), merging WARNINGS."""
    global EMITTED
    EMITTED = True
    if WARNINGS:
        obj = dict(obj)
        obj["systemMessage"] = "\n\n".join(WARNINGS + [obj["systemMessage"]] if "systemMessage" in obj else WARNINGS)
    if not MANUAL:
        print(json.dumps(obj))
        return
    print("\n\n".join(obj[k] for k in ("reason", "systemMessage") if k in obj))


def read_event():
    """The Stop-hook event from stdin, or a synthetic one for --check FILE."""
    global MANUAL
    if "--check" not in sys.argv:
        return json.load(sys.stdin)
    MANUAL = True
    src = sys.argv[sys.argv.index("--check") + 1]
    with (sys.stdin if src == "-" else open(src, encoding="utf-8")) as f:
        return {"last_assistant_message": f.read(), "cwd": os.getcwd()}


def main():
    harness = sys.argv[sys.argv.index("--harness") + 1] if "--harness" in sys.argv else "unknown"
    if os.environ.get("VERIFY_FINAL") == "0" or os.environ.get("VERIFY_FINAL_RUNNING"):
        return
    if "--done" in sys.argv:
        done_main(harness)
        return
    if "--recommend" in sys.argv:
        recommend_main(harness)
        return
    try:
        ev = read_event()
    except (ValueError, OSError, IndexError) as e:
        if "--check" in sys.argv:
            sys.exit(f"verify-final: cannot read --check input ({e})")
        return
    if MANUAL and "--harness" not in sys.argv:
        harness = "manual"
    rewake = "--rewake" in sys.argv
    global SID, ANSWER_LEN
    SID = re.sub(r"[^A-Za-z0-9]", "", str(ev.get("session_id") or ""))[:8]
    answer = (ev.get("last_assistant_message") or "").strip()
    ANSWER_LEN = len(answer)
    if ev.get("stop_hook_active"):
        log(harness, "skip_correction_pass", 0.0)
        return
    ledger_path, missing = active_ledger(ev.get("cwd"), answer)
    if missing:
        log(harness, "ledger_missing", 0.0, missing)
        if WARN != "none":
            WARNINGS.append(f"verify-final: the turn names ledger {missing}, which does not exist under the "
                            "working directory; it was not checked against any ledger. Fix the Ledger: line.")
    if len(answer) < MIN_CHARS and not ledger_path:
        log(harness, "skip_short", 0.0)
        if MANUAL and not WARNINGS:
            print(f"verify-final: no findings (answer under {MIN_CHARS} chars, no ledger)")
        return
    clean_marker = cache_path(ev.get("cwd"), answer, ledger_path)
    if cached_clean(clean_marker):
        log(harness, "cached", 0.0, f"ledger={ledger_path or '-'}")
        if MANUAL and not WARNINGS:
            print("verify-final: no findings (same answer found clean earlier)")
        return

    ledger = LEDGER_PROMPT.format(path=ledger_path) if ledger_path else ""
    out, err, rc, secs = run_checker(PROMPT, ev.get("cwd"), answer, ledger=ledger)

    verdicts = normalized_verdicts(out)
    if rc == 0 and not verdicts and "NO_CLAIMS" in out:
        log(harness, "no_claims", secs, f"ledger={ledger_path or '-'}")
        remember_clean(clean_marker)
        if MANUAL and not WARNINGS:
            print("verify-final: no findings")
        return
    if rc != 0 or not verdicts:
        why = (err.strip().splitlines() or ["no verdict lines in checker output"])[-1][:200]
        log(harness, "error", secs, why)
        if WARN != "none":
            say({"systemMessage": f"verify-final: check could not run ({why}); the final answer was not independently verified."})
        return

    false = [l.strip() for v, l in verdicts if v == "FALSE"]
    unsure = [l.strip() for v, l in verdicts if v == "UNSURE"]
    ungrounded = [l.strip() for v, l in verdicts if v == "UNGROUNDED"]
    verified = len(verdicts) - len(false) - len(unsure) - len(ungrounded)
    log(harness, "ok", secs, f"false={len(false)} unsure={len(unsure)} ungrounded={len(ungrounded)} "
        f"verified={verified} ledger={ledger_path or '-'}")
    out_obj = {}
    if unsure and WARN == "all":
        out_obj["systemMessage"] = "verify-final UNSURE (not blocking):\n" + "\n".join(unsure)
    elif unsure:
        log(harness, "unsure_hidden", secs, " || ".join(unsure)[:1500])
    parts = []
    if false:
        parts.append(
            "An independent fact-check of your final answer found claims that do not match the files:\n"
            + "\n".join(false)
            + "\nRe-ground on that evidence. Then write your final answer again as a complete, standalone "
            "message: the user reads only that message. Open it with one line per claim that changed, in the "
            "form \"Corrected: I said <the old claim>; <what the files show>.\" If your re-check shows a "
            "finding is wrong, open with \"Checked: <the claim> stands; <your evidence>.\" instead. Then give "
            "the rest of the answer. Do not address the checker or say \"you're right\"."
        )
    if ungrounded:
        parts.append(
            "Ledger steer: these recommendations rest on capabilities the grill ledger ("
            + ledger_path + ") does not establish:\n" + "\n".join(ungrounded)
            + "\nResearch each one (the system's docs, the files, a sub-agent), add what you find to the "
            "ledger with its source, and restate any recommendation the research changes. If a capability "
            "cannot be established, mark it unknown in the question."
        )
    if parts:
        out_obj["decision"] = "block"
        out_obj["reason"] = "\n\n".join(parts)
    elif not unsure:
        remember_clean(clean_marker)
    if rewake and parts and not MANUAL:
        sys.stderr.write("\n\n".join(WARNINGS + [out_obj["reason"]]) + "\n")
        sys.exit(2)
    if out_obj:
        say(out_obj)
    elif MANUAL and not WARNINGS:
        print("verify-final: no findings")


if __name__ == "__main__":
    # Windows pipes default to the ANSI code page; hooks and the pi extension speak UTF-8.
    sys.stdin.reconfigure(encoding="utf-8")
    sys.stdout.reconfigure(encoding="utf-8")
    main()
    if WARNINGS and not EMITTED:
        say({})
