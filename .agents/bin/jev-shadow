#!/usr/bin/env python3
"""jev-shadow: the Jev fact-check gate, run beside verify-final's GLM check.

Reads one JSON object on stdin:
  {cwd, sessionId, answer, record: [{tool, call, result}]}
Prints one JSON object on stdout (status jev_ok / jev_skip / jev_error /
jev_timeout / jev_no_key). Shadow only: nothing here reaches the agent.

Logic ported from ~/jev-tune/checker.py at commit 77993a9 (tuning run 1's
kept version); redaction from ~/jev-tune/common.py. Standard library only.
"""
import hashlib
import json
import os
import re
import subprocess
import sys
import time
import urllib.error
import urllib.request

MODEL = "jev-1.14.0"
ENDPOINT = "https://api.typesafe.ai/v1/systemone"

CLAIM_Q = (
    "Is sentences.{sid} a specific factual claim about what a file, document, config or program "
    "says or does, that could be checked by reading files? Answer no for questions, recommendations, "
    "opinions, plans, headings, and for statements about what the agent itself did or did not do, "
    "test or build results, git or deploy state, live service state, or other machines."
)
CLAIM_THRESHOLD = 0.5

EVIDENCE_MAX_ITEMS = 4
EVIDENCE_WINDOW = 400
EVIDENCE_MAX_CHARS = 3000
FRESH_FILES = 2
FRESH_MAX_CHARS = 1500

VERDICT_Q = {
    "type": "choice",
    "instructions": "Compare claim with evidence, which are excerpts of files and command output the agent saw. Which describes the relation?",
    "criteria": {
        "supported": "The evidence shows the claim is true.",
        "contradicted": "The evidence shows the claim is false or states something different.",
        "not_addressed": "The evidence does not say whether the claim is true.",
    },
}

NO_EVIDENCE_RISK = 0.0

STOP = set(
    "the and for that this with from into have has was were are not but its it's your you they them then than "
    "when what which there their about after before also only just more most some such each other over under "
    "here where while being been will would could should does did done make made uses used using file files "
    "line lines run runs ran".split()
)

SECRET_RES = [
    (re.compile(r"-----BEGIN [A-Z ]*PRIVATE KEY-----[\s\S]*?-----END [A-Z ]*PRIVATE KEY-----"), "[secret]"),
    (re.compile(r"\b(sk|pk|rk|ghp|gho|ghs|xox[abpr]|glpat|AKIA)[-_A-Za-z0-9]{12,}"), "[secret]"),
    (re.compile(r"(?i)(bearer\s+)[A-Za-z0-9._~+/=-]{16,}"), r"\1[secret]"),
    (re.compile(r"(?i)((?:api[_-]?key|token|secret|password|passwd|pwd|authorization)[\"']?\s*[:=]\s*[\"']?)[^\s\"',;]{6,}"), r"\1[secret]"),
    (re.compile(r"\b[A-Za-z0-9+/_-]{48,}={0,2}"), "[blob]"),
]


def redact(s):
    for rx, rep in SECRET_RES:
        s = rx.sub(rep, s)
    return s


def pieces(answer):
    out, in_code = [], False
    for line in answer.split("\n"):
        s = line.strip()
        if s.startswith("```"):
            in_code = not in_code
            continue
        if in_code or not s or re.fullmatch(r"[|:\-\s]+", s):
            continue
        for p in re.split(r"(?<=[.!?])\s+(?=[A-Z`\"(*])", s):
            p = p.strip()
            if len(p) >= 20:
                out.append(p[:400])
    return out


def keys_of(sentence):
    ks = set(re.findall(r"`([^`]{2,80})`", sentence))
    ks |= set(re.findall(r"[\w.~-]*/[\w./~-]+|\b[\w-]+\.(?:md|py|ts|js|sh|json|ya?ml|toml|txt|log|tsv|mjs|lua|conf)\b", sentence))
    ks |= set(re.findall(r"\b\d[\d.,:]*\d\b|\b\d{2,}\b", sentence))
    ks |= set(re.findall(r"\b[a-z]+(?:[A-Z_][a-zA-Z0-9]+)+\b|\b[a-z0-9]+(?:[-_][a-z0-9]+){1,}\b", sentence))
    ks = {k.strip(".,:;()") for k in ks if len(k.strip(".,:;()")) >= 2}
    if len(ks) < 2:
        ws = [w for w in re.findall(r"[A-Za-z][A-Za-z0-9_-]{5,}", sentence) if w.lower() not in STOP]
        ks |= set(ws[:4])
    return sorted(ks)


def evidence_for(sentence, record):
    ks = keys_of(sentence)
    if not ks:
        return []
    scored = []
    for item in record:
        blob = f"$ {item['call']}\n{item['result']}"
        low = blob.lower()
        hits = [k for k in ks if k.lower() in low]
        if not hits:
            continue
        spans = []
        for k in hits:
            i = low.find(k.lower())
            spans.append((max(0, i - EVIDENCE_WINDOW), min(len(blob), i + len(k) + EVIDENCE_WINDOW)))
        spans.sort()
        merged = []
        for a, b in spans:
            if merged and a <= merged[-1][1]:
                merged[-1] = (merged[-1][0], max(merged[-1][1], b))
            else:
                merged.append((a, b))
        text = " [...] ".join(blob[a:b] for a, b in merged)
        scored.append((len(set(hits)), {"source": item["tool"], "excerpt": text}))
    scored.sort(key=lambda x: -x[0])
    out, used = [], 0
    for _, ev in scored[:EVIDENCE_MAX_ITEMS]:
        if used + len(ev["excerpt"]) > EVIDENCE_MAX_CHARS:
            ev = {**ev, "excerpt": ev["excerpt"][: max(0, EVIDENCE_MAX_CHARS - used)]}
        if ev["excerpt"]:
            out.append(ev)
            used += len(ev["excerpt"])
        if used >= EVIDENCE_MAX_CHARS:
            break
    return out


def fresh_evidence(sentence, cwd, rg):
    home = os.path.expanduser("~")
    if not cwd or not rg or os.path.realpath(cwd) == os.path.realpath(home) or not os.path.isdir(cwd):
        return []
    keys = [k for k in keys_of(sentence) if len(k) >= 4][:5]
    if not keys:
        return []
    score = {}
    for k in keys:
        try:
            r = subprocess.run(
                ["rg", "-l", "-F", "-i", "--max-filesize", "1M", "-g", "!node_modules", "-g", "!.git", "--", k, cwd],
                capture_output=True, text=True, timeout=15,
            )
        except Exception:
            continue
        for f in r.stdout.split():
            score[f] = score.get(f, 0) + 1
    out = []
    for f in sorted(score, key=lambda f: (-score[f], f))[:FRESH_FILES]:
        args = ["rg", "-n", "-F", "-i", "-C", "2", "-m", "3"]
        for k in keys:
            args += ["-e", k]
        try:
            r = subprocess.run(args + ["--", f], capture_output=True, text=True, timeout=15)
        except Exception:
            continue
        text = redact(r.stdout)[:FRESH_MAX_CHARS]
        if text:
            out.append({"source": "file: " + os.path.relpath(f, cwd), "excerpt": text})
    return out


def rkey(state, questions):
    return hashlib.sha256(json.dumps([MODEL, state, questions], sort_keys=True, ensure_ascii=False).encode()).hexdigest()[:32]


def main():
    started = time.monotonic()
    deadline = started + float(os.environ.get("JEV_SHADOW_TIMEOUT_MS", "120000")) / 1000.0
    requests = 0
    input_tokens = 0
    seen = {}

    class Timeout(Exception):
        pass

    def evaluate(state, questions, key):
        nonlocal requests, input_tokens
        if key in seen:
            return seen[key]
        if time.monotonic() >= deadline:
            raise Timeout()
        req = {"model": MODEL, "state": state, "questions": questions}
        data = json.dumps(req, ensure_ascii=False).encode()
        r = urllib.request.Request(
            os.environ.get("JEV_SHADOW_URL", ENDPOINT),
            data=data,
            headers={"Authorization": "Bearer " + KEY, "Content-Type": "application/json"},
            method="POST",
        )
        try:
            with urllib.request.urlopen(r, timeout=max(0.05, deadline - time.monotonic())) as resp:
                body = json.loads(resp.read().decode("utf-8", "replace"))
        except (urllib.error.URLError, TimeoutError, OSError) as e:
            if isinstance(getattr(e, "reason", None), TimeoutError) or isinstance(e, TimeoutError):
                raise Timeout()
            raise RuntimeError(f"request failed: {type(e).__name__}")
        requests += 1
        input_tokens += int(body.get("usage", {}).get("input_tokens", 0) or 0)
        seen[key] = body["answers"]
        return body["answers"]

    payload = json.loads(sys.stdin.read())
    answer = redact(payload["answer"])
    record = [{"tool": i.get("tool", ""), "call": redact(str(i.get("call", ""))), "result": redact(str(i.get("result", "")))} for i in payload.get("record", [])]
    sentences = [redact(p) for p in pieces(answer)]

    def finish(status, claims=None, risk_s=0.0, risk_f=0.0, error=None):
        out = {
            "status": status,
            "model": MODEL,
            "requests": requests,
            "input_tokens": input_tokens,
            "seconds": round(time.monotonic() - started, 3),
            "claims": claims or [],
            "risk_session": round(risk_s, 4),
            "risk_files": round(risk_f, 4),
        }
        if error:
            out["error"] = str(error).splitlines()[0][:200]
        print(json.dumps(out, ensure_ascii=False))

    key = os.environ.get("TYPESAFE_API_KEY")
    if not key:
        try:
            auth = json.load(open(os.path.join(os.environ.get("HOME", "/nonexistent"), ".pi", "agent", "auth.json")))
            key = auth["jev"]["key"]
        except Exception:
            key = None
    if not key:
        finish("jev_no_key")
        return
    global KEY
    KEY = key

    try:
        state = {"sentences": {f"s{i}": s for i, s in enumerate(sentences)}}
        qs = {f"c{i}": {"type": "noul", "instructions": CLAIM_Q.format(sid=f"s{i}")} for i in range(len(sentences))}
        claim_answers = evaluate(state, qs, rkey(state, qs)) if sentences else {}
        claims = [i for i in range(len(sentences)) if claim_answers[f"c{i}"]["noul"] >= CLAIM_THRESHOLD]
        if not claims:
            finish("jev_skip")
            return
        rg = any(os.access(os.path.join(p, "rg"), os.X_OK) for p in os.environ.get("PATH", "").split(os.pathsep))
        out_claims, risk_s, risk_f = [], 0.0, 0.0
        for i in claims:
            s = sentences[i]
            ev_a = evidence_for(s, record)
            ev_b = ev_a + fresh_evidence(s, payload.get("cwd"), rg) if rg else ev_a
            probs_a = probs_b = None
            if ev_a:
                st = {"claim": s, "evidence": ev_a}
                probs_a = evaluate(st, {"v": VERDICT_Q}, rkey(st, {"v": VERDICT_Q}))["v"]["probabilities"]
            if rg and ev_b:
                st = {"claim": s, "evidence": ev_b}
                probs_b = evaluate(st, {"v": VERDICT_Q}, rkey(st, {"v": VERDICT_Q}))["v"]["probabilities"]
            elif ev_a:
                probs_b = None if not rg else probs_a
            if ev_a:
                risk_s = 1 - (1 - risk_s) * (1 - probs_a.get("contradicted", 0.0))
            if probs_b:
                risk_f = 1 - (1 - risk_f) * (1 - probs_b.get("contradicted", 0.0))
            out_claims.append({"i": i, "claim": claim_answers[f"c{i}"]["noul"], "session": probs_a, "files": probs_b})
        finish("jev_ok", out_claims, risk_s, risk_f)
    except Timeout:
        finish("jev_timeout")
    except Exception as e:
        finish("jev_error", error=e)


if __name__ == "__main__":
    main()
